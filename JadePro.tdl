[Line: JpItemJewelPartLine37]
    Field: JpItemJewelPartLine37F1

[Field: JpItemJewelPartLine37F1]
    Storage : JpRecalcBtn
    Label : " "
    Width : 100
    Skip : Yes
[Line: JpItemJewelPartLine38]
    Part Name: JpItemValidateMsg

; --- validation message line ----------------------------------------------
[Part: JpItemValidateMsg]
    Line: JpItemValidateMsgLine1, JpItemValidateMsgLine2

[Line: JpItemValidateMsgLine1]
    Field: JpItemValidateMsgLine1F1

[Field: JpItemValidateMsgLine1F1]
    Storage : JpItemMsg
    Label : " "
    Width : 100
    Style : JpWarn
[Line: JpItemValidateMsgLine2]
    Field: JpItemValidateMsgLine2F1

[Field: JpItemValidateMsgLine2F1]
    Storage : JpItemFormula
    Label : " "
    Width : 100
    Style : JpMuted
Alter: Item, JpItemJewelPart
    Modify Group: JpItemCalcGroup
        ; --- derived, in dependency order -----------------------------------
        Add: Field-id: JwlNetMetalWt
            Set: Value: JpNetWeight($JwlGrossWt, $JwlStoneWt)
        Add: Field-id: JwlMetalValue
            Set: Value: JpMetalValue($JwlNetMetalWt, $JwlGoldRate)
        Add: Field-id: JwlWastageValue
            Set: Value: JpWastageValue($JwlMetalValue, $JwlWastagePc)
        Add: Field-id: JwlStoneValue
            Set: Value: JpStoneValue($JwlStoneWt, $JwlStoneRate)
        Add: Field-id: JwlDiamondValue
            Set: Value: JpDiamondValue($JwlDiamondCarat, $JwlDiamondRate)
        ; Making charge is a DERIVED amount, so it is a reaction on its own
        ; inputs rather than on the other computed fields.
        Add: Field-id: JwlMakingChargeComputed
            Set: Value: JpMakingCharge($JwlMakingType, $JwlNetMetalWt, $JwlMetalValue, $JwlMakingCharge, $JwlGoldRate)
        Add: Field-id: JwlFinalValue
            Set: Value: JpRound($JwlMetalValue + $JwlWastageValue + $JwlMakingChargeComputed + $JwlStoneValue + $JwlDiamondValue)
        Add: Field-id: JpItemFormula
            Set: Value: "Net = Gross - Stone   |   Value = Metal + Wastage + Making + Stone + Diamond"

    ; --- validation line + actions on the same target ----------------------
    Add: Field-id: JpItemMsg
        Set: Value: JpItemValidationText()
        Accept: JpItemCalc
        Reject: JpItemCalc

    Add: Field-id: JpRecalcBtn
        Set: Accept: JpItemCalc
        Set: Reject: JpItemCalc
        Set: Buttons: <Recalculate, OnAction: JpRecalcItem>
        Set: Buttons: <Barcode / Tag, OnAction: JpRecalcItemGenBarcode>

[Function: JpItemCalc]
    Returns: Integer : Any
    JpItemCalc = 1

[Function: JpRecalcItem]
    Returns: Integer : Any
    If (JpIsOwner = 0) Then
    {
        If (JpHasRight(JpRtProfit()) = 0) Then
        {
            JpRecalcItem = 0
            Exit
        }
    }
    JpRecalcItem = 1

[Function: JpRecalcItemGenBarcode]
    Returns: Integer : Any
    JpRecalcItemGenBarcode = 1

; Human readable reason a jewellery item is not acceptable yet.
[Function: JpItemValidationText]
    Returns: String : Any
    Var: m : String
    m = ""
    If ($JwlBarcode = "") Then
    {
        m = "Barcode is mandatory for jewellery items."
        JpItemValidationText = m
        Exit
    }
    If ($JwlCategory = "") Then
    {
        m = "Jewellery Category is mandatory."
        JpItemValidationText = m
        Exit
    }
    If ($JwlMetalType = "") Then
    {
        m = "Metal Type is mandatory."
        JpItemValidationText = m
        Exit
    }
    If (JpPurityValid($JwlPurity) = 0) Then
    {
        m = "Purity " + $JwlPurity + " is not a valid purity."
        JpItemValidationText = m
        Exit
    }
    If (JpWeightValid($JwlGrossWt) = 0) Then
    {
        m = "Gross Weight is missing or out of range."
        JpItemValidationText = m
        Exit
    }
    If ($JwlGoldRate <= 0) Then
    {
        m = "Enter the item gold rate or pick it up from the daily rate master."
        JpItemValidationText = m
        Exit
    }
    If ($JwlFinalValue <= 0) Then
    {
        m = "Final Jewellery Value is zero - check rate, weights and making charge."
        JpItemValidationText = m
        Exit
    }
    If ($JwlMSP > 0) Then
    {
        If ($JwlFinalValue < $JwlMSP) Then
        {
            m = "Warning: computed value is BELOW the Minimum Selling Price."
            JpItemValidationText = m
            Exit
        }
    }
    If ($JwlMRP > 0) Then
    {
        If ($JwlFinalValue > $JwlMRP) Then
        {
            m = "Warning: computed value is ABOVE MRP."
            JpItemValidationText = m
            Exit
        }
    }
    JpItemValidationText = "Item is valid."; =============================================================================
;  SECTION E - GUIDED CREATE / ALTER SCREENS
;  Tally's own Create Item screen is untouched; this is an ADDITIONAL screen
;  for the cashier who packs a new design, because it asks jewellery questions
;  in jewellery order and auto-computes as they type.
; =============================================================================

[Variable: JpScrItemName   : String]
[Variable: JpScrBarcode    : String]
[Variable: JpScrCategory   : String]
[Variable: JpScrDesign     : String]
[Variable: JpScrHuid       : String]
[Variable: JpScrCert       : String]
[Variable: JpScrMetal      : String]
[Variable: JpScrPurity     : String]
[Variable: JpScrRate       : Number]
[Variable: JpScrGross      : Quantity]
[Variable: JpScrStone      : Quantity]
[Variable: JpScrCarat      : Quantity]
[Variable: JpScrNet        : Quantity]
[Variable: JpScrMakeType   : String]
[Variable: JpScrMakeAmt    : Number]
[Variable: JpScrWastage    : Number]
[Variable: JpScrStoneRate  : Number]
[Variable: JpScrDiaRate    : Number]
[Variable: JpScrMetalVal   : Number]
[Variable: JpScrFinalVal   : Number]
[Variable: JpScrMsp        : Number]
[Variable: JpScrMrp        : Number]
[Variable: JpScrCounter    : String]
[Variable: JpScrSupplier   : String]
[Variable: JpScrMsg        : String]
[Variable: JpScrSeq        : Number]

[Screen: JpItemCreateScreen]
