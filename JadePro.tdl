; =============================================================================
;  REPORT 2 - MONTHLY SALES
;  Aggregated by month in SQL so a whole year returns twelve rows, not 3,000.
; =============================================================================
[Collection: Report: JpMonthlySales]
    Source: JpMonthlySalesSQL
    Var: JpFromDate, JpToDate
    Title: <1000,###,#a##"  MONTHLY JEWELLERY SALES SUMMARY">
    Print: JpMonthlySalesPrint
    Export: JpMonthlySalesExport
    Key: JpMonthlySalesKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>

[Variable: JpMonthlySalesSQL : String]
    Type: String
    Value: "SELECT $$MONTH$$ AS JwlMonth, COUNT($$VOUCHERID$$) AS JwlBills, SUM($JwlGrandTotal$$) AS JwlSales, SUM($JwlTaxableVal$$) AS JwlTaxable, SUM($$GSTVALUE$$) AS JwlGst FROM $$VOUCHERS$$ WHERE $$VOUCHERTYPE$$ = 'Sales' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$ GROUP BY $$MONTH$$ ORDER BY $$MONTH$$"

[Variable: JpMonthlySalesKey : String]
    Type: String
    Value: "JwlMonth"


; [Print: JpMonthlySalesPrint] -> [Form: JpMonthlySalesPrint] by fix-print-to-form.mjs.
