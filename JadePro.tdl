    Add: Field
        Field-id: JpLnHuid
        Part-id: Invoicemain
        Label: "HUID"
        Type: Text
        Width: 80
    Add: Field
        Field-id: JpLnPurity
        Part-id: Invoicemain
        Label: "Purity"
        Type: Text
        Width: 55
    Add: Field
        Field-id: JpLnGross
        Part-id: Invoicemain
        Label: "Gr Wt"
        Type: Quantity
        Width: 60
    Add: Field
        Field-id: JpLnStone
        Part-id: Invoicemain
        Label: "St Wt"
        Type: Quantity
        Width: 55
    Add: Field
        Field-id: JpLnNet
        Part-id: Invoicemain
        Label: "Net Wt"
        Type: Quantity
        Width: 60
        Color: #6B4E1E
        Font: Bold
    Add: Field
        Field-id: JpLnRate
        Part-id: Invoicemain
        Label: "Rate"
        Type: Number
        Width: 70
    Add: Field
        Field-id: JpLnMetalVal
        Part-id: Invoicemain
        Label: "Metal Val"
        Type: Number
        Width: 80
    Add: Field
        Field-id: JpLnWastageVal
        Part-id: Invoicemain
        Label: "Wastage"
        Type: Number
        Width: 70
    Add: Field
        Field-id: JpLnMakeAmt
        Part-id: Invoicemain
        Label: "Making"
        Type: Number
        Width: 70
    Add: Field
        Field-id: JpLnStoneVal
        Part-id: Invoicemain
        Label: "Stone/Dia"
        Type: Number
        Width: 80
    Add: Field
        Field-id: JpLnBaseVal
        Part-id: Invoicemain
        Label: "Base Value"
        Type: Number
        Width: 85
        Font: Bold
    Add: Field
        Field-id: JpLnDiscAmt
        Part-id: Invoicemain
        Label: "Discount"
        Type: Number
        Width: 75
    Add: Field
        Field-id: JpLnTotal
        Part-id: Invoicemain
        Label: "Line Total"
        Type: Number
        Width: 90
        Font: Bold
        Color: #A06000
    ; Cost is present in the data model but hidden from anyone without the
    ; profit right - that is the "salesperson must not see cost price" rule.
    Add: Field
        Field-id: JpLnCost
        Part-id: Invoicemain
        Label: "Cost"
        Type: Number
        Width: 75
        Invisible: ##JwlShowCost <> 1

; --- yes/no pick list used on the Sales header ---------------------------
    ; message field so validation text appears next to the items too
    Add: Field
        Field-id: JpSalesMsg
        Part-id: Invoicemain
        Label: " "
        Type: Text
        Width: 80
        Skip: Yes

    Modify Group: JpLnCalcGroup
        Add: Field-id: JwlLnNet
            Set: Value: JpNetWeight($JwlLnGross, $JwlLnStone)
        Add: Field-id: JwlLnMetalVal
            Set: Value: JpMetalValue($JwlLnNet, $JwlLnRate)
        Add: Field-id: JwlLnWastageVal
            Set: Value: JpWastageValue($JwlLnMetalVal, $JwlLnWastagePc)
        Add: Field-id: JwlLnStoneVal
            Set: Value: JpStoneValue($JwlLnStone, $JwlLnStoneRate)
        Add: Field-id: JwlLnDiaVal
            Set: Value: JpDiamondValue($JwlLnCarat, $JwlLnDiaRate)
        Add: Field-id: JwlLnMakeAmt
            Set: Value: JpMakingCharge($JwlLnMakeType, $JwlLnNet, $JwlLnMetalVal, $JwlLnMakeAmtIn, $JwlLnRate)
        Add: Field-id: JwlLnBaseVal
            Set: Value: JpRound($JwlLnMetalVal + $JwlLnWastageVal + $JwlLnMakeAmt + $JwlLnStoneVal + $JwlLnDiaVal)
        Add: Field-id: JwlLnDiscAmt
            Set: Value: JpDiscAmt($JwlLnBaseVal, $JwlLnDiscPc, $JwlDiscAmt)
        Add: Field-id: JwlLnTaxable
            Set: Value: JpRound($JwlLnBaseVal - $JwlLnDiscAmt)
        Add: Field-id: JwlLnTotal
            Set: Value: JpRound($JwlLnTaxable + JpTaxAmount($JwlLnTaxable, $JwlGstRate))

    ; --- pull the jewellery facts off the item when the item is chosen ----
    Modify Group: JpLnFromItemGroup
        Add: Field-id: JwlLnBarcode
            Set: Value: JpItemFact($$InventoryItem, "JwlBarcode")
        Add: Field-id: JwlLnHuid
            Set: Value: JpItemFact($$InventoryItem, "JwlHuid")
        Add: Field-id: JwlLnPurity
            Set: Value: JpItemFact($$InventoryItem, "JwlPurity")
        Add: Field-id: JwlLnMetal
            Set: Value: JpItemFact($$InventoryItem, "JwlMetalType")
        Add: Field-id: JwlLnGross
            Set: Value: JpItemFact($$InventoryItem, "JwlGrossWt")
        Add: Field-id: JwlLnStone
            Set: Value: JpItemFact($$InventoryItem, "JwlStoneWt")
        Add: Field-id: JwlLnCarat
            Set: Value: JpItemFact($$InventoryItem, "JwlDiamondCarat")
        Add: Field-id: JwlLnWastagePc
            Set: Value: JpItemFact($$InventoryItem, "JwlWastagePc")
        Add: Field-id: JwlLnMakeType
            Set: Value: JpItemFact($$InventoryItem, "JwlMakingType")
        Add: Field-id: JwlLnStoneRate
            Set: Value: JpItemFact($$InventoryItem, "JwlStoneRate")
        Add: Field-id: JwlLnDiaRate
            Set: Value: JpItemFact($$InventoryItem, "JwlDiamondRate")
        Add: Field-id: JwlLnCost
            Set: Value: JpItemFact($$InventoryItem, "JwlFinalValue")
        ; rate: item override first, otherwise TODAY's rate for the purity
    Text: " DISCOUNT  AND  GST"
    Style: JpSectionBox
    Line Height: 1

    Field: <Field-Id: JwlDiscPc, Label: "Invoice Discount %">
        Width: 120
    Field: <Field-Id: JwlDiscAmt, Label: "Discount Amount">
        Width: 120
    Field: <Field-Id: JwlGstRate, Label: "GST Rate %">
        Width: 120
    Field: <Field-Id: JwlInterState, Label: "Inter State">
        Width: 120
        Dynamic: Pick From: JpYesNoPick
    Field: <Field-Id: JwlOldGoldRef, Label: "Old Gold Vch Ref">
        Width: 140

    Line: Spacing
    Text: " INVOICE TOTALS"
    Style: JpSectionBox
    Line Height: 1

    Field: <Field-Id: JwlTaxableVal, Label: "Taxable Jewellery Value">
        Width: 150
    Field: <Field-Id: JwlMakeVal, Label: "Making Charges Value">
        Width: 150
    Field: <Field-Id: JwlCgst, Label: "CGST">
        Width: 110
    Field: <Field-Id: JwlSgst, Label: "SGST">
        Width: 110
    Field: <Field-Id: JwlIgst, Label: "IGST">
        Width: 110
    Field: <Field-Id: JwlTaxTotal, Label: "Total GST">
        Width: 120
        Color: #6B4E1E
        Font: Bold
    Field: <Field-Id: JwlGrandTotal, Label: "GRAND TOTAL">
        Width: 140
        Color: #A06000
        Font: Bold
    Field: <Field-Id: JwlPayTotal, Label: "Total Received">
        Width: 130
    Field: <Field-Id: JwlPayBalance, Label: "Balance Due">
        Width: 120
[Collection: Source: JpYesNoPick]
    Data: JpYesNoPickRow

[Collection: Data: JpYesNoPickRow]
    Fetch: JpYesNoPickFetch
    Set: JpYesNoPickSet
    Repeat: Over: JpYesNoPickRow

[Collection: Data: JpYesNoPickFetch]
    Include: JpYesNoPickRow

[Collection: Data: JpYesNoPickSet]
    Not On: ##<Not>
    Set: $$Name: Value: JpYesNoList()

; =============================================================================
;  SECTION E - LINE AUTO CALCULATION
;  Runs on every inventory line as it is filled in. This is the same arithmetic
;  as 00_Core, so a line can never disagree with the item master.
; =============================================================================
        Add: Field-id: JwlLnRate
            Set: Value: JpLineRate($$InventoryItem, $JwlLnMetal, $JwlLnPurity, $JwlLnRate); =============================================================================
;  SECTION F - HELPERS
; =============================================================================

; Reads a jewellery fact from the ITEM master. $$InventoryItem is the item on
; the current inventory line; JpGetUDFNum/Str read the named UDF from it.
[Function: JpItemFact]
    Param: vItem : String : Optional, vFieldName : String : Optional
    Returns: String : Any
    JpItemFact = JpGetUDFStr(Param(0), Param(1))

; The rate to charge on a line: the item's own rate if it has one, otherwise
; TODAY's rate for that metal and purity. A value the user typed wins only if
; they hold JADE_OVERRIDE_RATE.
[Function: JpLineRate]
    Param: vItem : String : Optional, vMetal : String : Optional, vPurity : String : Optional, vTyped : Number : Optional
    Returns: Number : Any
    Var: own : Number, today : Number
    own = JpGetUDFNum(Param(0), "JwlGoldRate")
    If (own > 0) Then
    {
        JpLineRate = JpEffectiveRate(own, Param(3))
        Exit
    }
    today = JpRateFor(Param(1), Param(2), 0)
    JpLineRate = JpEffectiveRate(today, Param(3))

; Discount for one line: line % wins; otherwise the invoice level %; otherwise
; an invoice level flat amount spread over the lines.
[Function: JpDiscAmt]
    Param: vBase : Number : Optional, vLinePc : Number : Optional, vInvAmt : Number : Optional
    Returns: Number : Any
    Var: b : Number, p : Number
    b = Param(0)
    p = Param(1)
    If (b is null) Then { b = 0; }
    If (p is null) Then { p = 0; }
    If (p <= 0) Then { JpDiscAmt = 0; Exit; }
    If (p > 100) Then { p = 100; }
    JpDiscAmt = JpRound(b * p / 100)

; Splits GST into CGST / SGST / IGST and returns the total. The results land in
; the JpTaxCGST / JpTaxSGST / JpTaxIGST globals declared in 00_Core.
[Function: JpSplitGst]
    Param: vTaxable : Number : Optional, vRate : Number : Optional, vInterState : Number : Optional
    Returns: Number : Any
    JpSplitGst = JpComputeTax(Param(0), Param(1), Param(2))

; Header-level validation. Returns "" when the invoice is acceptable, otherwise
; the first problem worth telling the user about.
[Function: JpSalesValidationText]
    Returns: String : Any
    Var: m : String
    m = ""
    If (JpBlankIfNull($JwlInvNo) = "") Then
    {
        JpSalesValidationText = "Invoice Number is mandatory."
        Exit
    }
    If (JpBlankIfNull($JwlSalesperson) = "") Then
    {
        JpSalesValidationText = "Salesperson is mandatory for salesperson reports."
        Exit
    }
    If ($JwlGstRate < 0) Then
    {
        JpSalesValidationText = "GST rate cannot be negative."
        Exit
    }
    If (JpDiscountAllowed($JwlDiscPc, JpMaxDiscountPc) = 0) Then
    {
        JpSalesValidationText = JpDeniedMsg
        Exit
    }
    If ($JwlPayBalance > 0.01) Then
    {
        JpSalesValidationText = "Balance due " + JpFmtAmt($JwlPayBalance) + " - split payment entered does not cover the grand total."
        Exit
    }
    If ($$JpRateOverridden = 1) Then
    {
        If (JpHasRight(JpRtOverride()) = 0) Then
        {
            JpSalesValidationText = "A manually typed rate was ignored because you are not authorised to override the daily rate."
            Exit
        }
    }
    JpSalesValidationText = ""

; =============================================================================
;  SECTION G - THE BILLING FRONT SCREEN
;  A thin cashier-facing landing screen: today's rates, the rate-change
;  permission state, and a single keypress into the enriched Sales voucher.
; =============================================================================
[Variable: JpSalesMsg   : String]
[Variable: JpSalesHint  : String]
; Loaded from the Company master by 13_Security.tdl when the module starts.
[Variable: JpMaxDiscountPc  : Number]
[Variable: JpCommissionPc   : Number]
[Variable: JpDefaultGstRate : Number]

[Screen: JpSalesScreen]
    Caption: "JadePro  ::  Jewellery Billing"
    Key: <Ctrl+Q: System: Quit>

    Line: Spacing
    Lines: 1
    Text: "           JEWELLERY BILLING"
    Style: JpTitle
    Line Height: 1
[Part: JpSalesLineMsgPart]
    Button: <Start Jewellery Invoice (F2), Key: F2, Action: JpStartInvoice>
    Button: <Update Daily Rates (F8), Key: F8, Action: JpOpenRate>
    Button: <Old Gold Exchange (F9), Key: F9, Action: JpOpenOldGold>
    Button: <Quit (Esc), Key: Esc, Action: System: Quit>

    Line: Spacing, JpSalesLineMsgPartLine1, JpSalesLineMsgPartLine2, JpSalesLineMsgPartLine3, JpSalesLineMsgPartLine4, JpSalesLineMsgPartLine5, JpSalesLineMsgPartLine6, JpSalesLineMsgPartLine7, JpSalesLineMsgPartLine8, JpSalesLineMsgPartLine9, JpSalesLineMsgPartLine10, JpSalesLineMsgPartLine11, JpSalesLineMsgPartLine12, JpSalesLineMsgPartLine13, JpSalesLineMsgPartLine14, JpSalesLineMsgPartLine15

[Line: JpSalesLineMsgPartLine1]
    Field: JpSalesLineMsgPartLine1F1

[Field: JpSalesLineMsgPartLine1F1]
    Storage : JpSalesMsg
    Label : " "
    Width : 100
    Style : JpWarn
[Line: JpSalesLineMsgPartLine2]
    Field: JpSalesLineMsgPartLine2F1

[Field: JpSalesLineMsgPartLine2F1]
    Storage : JpSalesHint
    Label : " "
    Width : 100
    Style : JpMuted
[Line: JpSalesLineMsgPartLine3]
    Field: JpSalesLineMsgPartLine3F1

[Field: JpSalesLineMsgPartLine3F1]
    Set As : "Press F2 to open the Sales voucher, which now carries the full jewellery column set."
    Style : JpSub
[Line: JpSalesLineMsgPartLine4]
    Field: JpSalesLineMsgPartLine4F1

[Field: JpSalesLineMsgPartLine4F1]
    Set As : " "
    Style : JpMuted
[Line: JpSalesLineMsgPartLine5]
    Field: JpSalesLineMsgPartLine5F1

[Field: JpSalesLineMsgPartLine5F1]
    Set As : " TODAY'S RATES  (per gram)"
    Style : JpSectionBox
[Line: JpSalesLineMsgPartLine6]
    Field: JpSalesLineMsgPartLine6F1

[Field: JpSalesLineMsgPartLine6F1]
    Set As : "   24K   " + JpFmtAmt(JpCache24K) + "          22K   " + JpFmtAmt(JpCache22K) + "          18K   " + JpFmtAmt(JpCache18K)
[Line: JpSalesLineMsgPartLine7]
    Field: JpSalesLineMsgPartLine7F1

[Field: JpSalesLineMsgPartLine7F1]
    Set As : "   14K   " + JpFmtAmt(JpCache14K) + "          Silver   " + JpFmtAmt(JpCacheSilver) + "          Platinum   " + JpFmtAmt(JpCachePlatinum)
[Line: JpSalesLineMsgPartLine8]
    Field: JpSalesLineMsgPartLine8F1

[Field: JpSalesLineMsgPartLine8F1]
    Set As : "   Rate date cached: " + JpBlankIfNull(JpCacheDate)
    Style : JpWarn
[Line: JpSalesLineMsgPartLine9]
    Field: JpSalesLineMsgPartLine9F1

[Field: JpSalesLineMsgPartLine9F1]
    Set As : " YOUR PERMISSIONS"
    Style : JpSectionBox
[Line: JpSalesLineMsgPartLine10]
    Field: JpSalesLineMsgPartLine10F1

[Field: JpSalesLineMsgPartLine10F1]
    Set As : "   Role ............ " + JpUserRole
[Line: JpSalesLineMsgPartLine11]
    Field: JpSalesLineMsgPartLine11F1

[Field: JpSalesLineMsgPartLine11F1]
    Set As : "   Change daily rate  " + JpPermText(JpRtChangeRate())
[Line: JpSalesLineMsgPartLine12]
    Field: JpSalesLineMsgPartLine12F1

[Field: JpSalesLineMsgPartLine12F1]
    Set As : "   Override rate      " + JpPermText(JpRtOverride())
[Line: JpSalesLineMsgPartLine13]
    Field: JpSalesLineMsgPartLine13F1

[Field: JpSalesLineMsgPartLine13F1]
    Set As : "   View cost / profit " + JpPermText(JpRtProfit())
[Line: JpSalesLineMsgPartLine14]
    Field: JpSalesLineMsgPartLine14F1

[Field: JpSalesLineMsgPartLine14F1]
    Storage : JpSalesMsg
    Label : " "
    Width : 100
    Style : JpWarn
[Line: JpSalesLineMsgPartLine15]
    Field: JpSalesLineMsgPartLine15F1

[Field: JpSalesLineMsgPartLine15F1]
    Storage : JpSalesHint
    Label : " "
    Width : 100
    Style : JpMuted
[Function: JpPermText]
    Param: vRight : String : Optional
    Returns: String : Any
    If (JpHasRight(Param(0)) = 1) Then
    {
        JpPermText = "ALLOWED"
        Exit
    }
    JpPermText = "NOT ALLOWED"

[Function: JpStartInvoice]
    Returns: Integer : Any
    If (JpCache24K <= 0) Then
    {
        JpSalesMsg = "No daily rate is loaded. Enter today's rate master first (F8) - otherwise every jewellery line will be blocked by the missing-rate validation."
        JpStartInvoice = 0
        Exit
    }
    JpSalesMsg = ""
    Alter: Sales
    JpStartInvoice = 1

[Function: JpOpenRate]
    Returns: Integer : Any
    Alter: JpRateScreen
    JpOpenRate = 1

[Function: JpOpenOldGold]
    Returns: Integer : Any
    Alter: JpOldGoldScreen
    JpOpenOldGold = 1

; -----------------------------------------------------------------------------
;; >>>>>>>>>>>>>>>>>>>>>>> BEGIN 05_Purchase.tdl <<<<<<<<<<<<<<<<<<<<<<
; =============================================================================
;  JadePro  ::  05_Purchase.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Jewellery purchases - finished jewellery, loose gold, silver,
;            diamonds, stones, supplier purchases and jewellery received back
;            from karigars.
;
;  DESIGN  : Enriches Tally's STANDARD Purchase voucher, exactly as 04_Sales
;            does for sales, so stock increases by weight through Tally's own
;            inventory engine and the payable ledger stays standard.
;
;  LOAD    : After 00_Core, 02_ItemMaster, 03_GoldRate, 04_Sales.
;  REQUIRES : 00_Core.tdl, 02_ItemMaster.tdl, 03_GoldRate.tdl, 04_Sales.tdl
; =============================================================================

