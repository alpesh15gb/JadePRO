; =============================================================================
;  REPORT 13 - FAST / SLOW / DEAD MOVEMENT
;  Based on how many times each item was sold in the period.
; =============================================================================
[Collection: Report: JpMovementReport]
    Source: JpMovementSQL
    Var: JpFromDate, JpToDate
    Title: <1000,###,#a##"  MOVEMENT ANALYSIS - FAST / SLOW / DEAD">
    Print: JpMovementPrint
    Export: JpMovementExport
    Key: JpMovementKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>

[Variable: JpMovementSQL : String]
    Type: String
    Value: "SELECT $$ITEMNAME$$ AS JwlItem, $JwlCategory$$ AS JwlCat, SUM($$QUANTITY$$) AS JwlSoldQty, SUM($JwlLnNet$$) AS JwlSoldWt, SUM($JwlLnTotal$$) AS JwlSoldVal FROM $$LINEITEMS$$ WHERE $$VOUCHERTYPE$$ = 'Sales' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$ GROUP BY $$ITEMNAME$$,$JwlCategory$$ ORDER BY $$JwlSoldVal$$ DESC"

[Variable: JpMovementKey : String]
    Type: String
    Value: "JwlItem"

[Function: JpMoveClass]
    Param: vSoldVal : Number : Optional
    Returns: String : Any
    Var: v : Number
    v = JpNz(Param(0))
    If (v <= 0) Then
    {
        JpMoveClass = "DEAD (no sale in period)"
        Exit
    }
    If (v >= 25000) Then
    {
        JpMoveClass = "FAST"
        Exit
    }
    If (v >= 5000) Then
    {
        JpMoveClass = "MOVING"
        Exit
    }
    JpMoveClass = "SLOW"


