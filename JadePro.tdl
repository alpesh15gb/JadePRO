[Line: JpMonthlySalesPrintLine37]
    Field: JpMonthlySalesPrintLine37F1

[Field: JpMonthlySalesPrintLine37F1]
    Style : JpTotal
[Function: JpAvgBill]
    Param: vTo : Date : Optional, vFrom : Date : Optional
    Returns: Number : Any
    Var: b : Number, s : Number
    b = Count($$JwlBills)
    s = Sum($$JwlSales)
    If (b <= 0) Then
    {
        JpAvgBill = 0
        Exit
    }
    JpAvgBill = JpRound(s / b)

[Export: JpMonthlySalesExport]
    Title: <1000, "Monthly Sales">
    Repeat: Over: JpMonthlySales
    Export Title: Detail
    Export: Value: $$JwlMonth
    Export: Value: $$JwlBills
    Export: Value: $$JwlTaxable
    Export: Value: $$JwlGst
    Export: Value: $$JwlSales


