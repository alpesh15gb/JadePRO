;  REPORT 14 - SALESPERSON PERFORMANCE
;  Revenue, weight sold, discount given and gross profit against the monthly
;  target held in the company master (see 13_Security.tdl).
; =============================================================================
[Collection: Report: JpSalespersonReport]
    Source: JpSalespersonSQL
    Var: JpFromDate, JpToDate
    Title: <1000,###,#a##"  SALESPERSON PERFORMANCE">
    Print: JpSalespersonPrint
    Export: JpSalespersonExport
    Key: JpSalespersonKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>

[Variable: JpSalespersonSQL : String]
    Type: String
    Value: "SELECT $JwlSalesperson$$ AS JwlSp, COUNT($$VOUCHERID$$) AS JwlBills, SUM($$QUANTITY$$) AS JwlPiecesSold, SUM($JwlGrandTotal$$) AS JwlRevenue, SUM($JwlDiscAmt$$) AS JwlDiscount, SUM($JwlLnNet$$) AS JwlWeightSold, SUM($JwlLnCost$$) AS JwlCost FROM $$LINEITEMS$$ WHERE $$VOUCHERTYPE$$ = 'Sales' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$ GROUP BY $JwlSalesperson$$ ORDER BY $$JwlRevenue$$ DESC"

[Variable: JpSalespersonKey : String]
    Type: String
    Value: "JwlSp"

; Target achievement. Target is monthly, so a period longer than one month is
; scaled by the number of months covered rather than compared raw.
[Function: JpTargetAchieved]
    Returns: Number : Any
    Var: tgt : Number, rev : Number
    tgt = JpTargetFor($$JwlSp)
    rev = JpNz($$JwlRevenue)
    If (tgt <= 0) Then
    {
        JpTargetAchieved = 0
        Exit
    }
    JpTargetAchieved = JpRound(rev * 100 / tgt)

[Function: JpGrossProfit]
    Returns: Number : Any
    If (JpShowProfit() <> 1) Then
    {
        JpGrossProfit = 0
        Exit
    }
    JpGrossProfit = JpRound($$JwlRevenue - JpNz($$JwlCost))


