; =============================================================================
;  REPORT 5 - GST SUMMARY
;  Reads Tally's own GST ledgers. No tax rate is written anywhere in this
;  module: the rates live in the shop's own tax masters.
; =============================================================================
[Collection: Report: JpGSTReport]
    Source: JpGSTReportSQL
    Var: JpFromDate, JpToDate
    Title: <1000,###,#a##"  GST SUMMARY - JEWELLERY">
    Print: JpGSTReportPrint
    Export: JpGSTReportExport
    Key: JpGSTReportKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>

[Variable: JpGSTReportSQL : String]
    Type: String
    Value: "SELECT $$LEDGERNAME$$,SUM($$AMOUNT$$) AS JwlTaxAmt FROM $$LINEITEMS$$ WHERE $$VOUCHERTYPE$$ IN ('Sales','Purchase') AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$ AND $$LEDGERNAME$$ LIKE '%GST%' GROUP BY $$LEDGERNAME$$ ORDER BY $$LEDGERNAME$$"

[Variable: JpGSTReportKey : String]
    Type: String
    Value: "LEDGERNAME"


; [Print: JpGSTReportPrint] -> [Form: JpGSTReportPrint] by fix-print-to-form.mjs.
; "Print" is a Report attribute, not a definition type; a print layout is a Form.
; dropped (no home in TallyPrime, per user decision): Width (column widths)

[Form: JpGSTReportPrint]
    Parts : JpGSTReportPrintLines

[Part: JpGSTReportPrintLines]
    Lines : Spacing, JpGSTReportPrintLine1, JpGSTReportPrintLine2, JpGSTReportPrintLine3, JpGSTReportPrintLine4, JpGSTReportPrintLine5, JpGSTReportPrintLine6, JpGSTReportPrintLine7, JpGSTReportPrintLine8, JpGSTReportPrintLine9, JpGSTReportPrintLine10, JpGSTReportPrintLine11, JpGSTReportPrintLine12, JpGSTReportPrintLine13, JpGSTReportPrintLine14

[Line: JpGSTReportPrintLine1]
    ; removed by fix-line-container-attrs.mjs - Title is a print-layout attribute, not a Line attribute
    ; removed by fix-line-container-attrs.mjs - Paper is a print-layout attribute, not a Line attribute
    ; removed by fix-line-container-attrs.mjs - Margin-right is a print-layout attribute, not a Line attribute
    ; removed by fix-line-container-attrs.mjs - Margin-bottom is a print-layout attribute, not a Line attribute
    Part Name: JpReportHeader
[Line: JpGSTReportPrintLine2]
    Field: JpGSTReportPrintLine2F1

[Field: JpGSTReportPrintLine2F1]
    Set As : "Tax Ledger"
[Line: JpGSTReportPrintLine3]
    Field: JpGSTReportPrintLine3F1

[Field: JpGSTReportPrintLine3F1]
    Style : JpGridHead
[Line: JpGSTReportPrintLine4]
    Field: JpGSTReportPrintLine4F1

[Field: JpGSTReportPrintLine4F1]
    Set As : "Amount"
[Line: JpGSTReportPrintLine5]
    Field: JpGSTReportPrintLine5F1

[Field: JpGSTReportPrintLine5F1]
    Style : JpGridHead
[Line: JpGSTReportPrintLine6]
    Field: JpGSTReportPrintLine6F1

[Field: JpGSTReportPrintLine6F1]
    Set As : $$LEDGERNAME
[Line: JpGSTReportPrintLine7]
    Field: JpGSTReportPrintLine7F1

[Field: JpGSTReportPrintLine7F1]
    Style : JpGrid
[Line: JpGSTReportPrintLine8]
    Field: JpGSTReportPrintLine8F1

[Field: JpGSTReportPrintLine8F1]
    Set As : $$JwlTaxAmt
[Line: JpGSTReportPrintLine9]
    Field: JpGSTReportPrintLine9F1

[Field: JpGSTReportPrintLine9F1]
    Style : JpMoneyBold
[Line: JpGSTReportPrintLine10]
    Field: JpGSTReportPrintLine10F1

[Field: JpGSTReportPrintLine10F1]
    Set As : "TOTAL GST"
[Line: JpGSTReportPrintLine11]
    Field: JpGSTReportPrintLine11F1

[Field: JpGSTReportPrintLine11F1]
    Style : JpTotal
[Line: JpGSTReportPrintLine12]
    Field: JpGSTReportPrintLine12F1

[Field: JpGSTReportPrintLine12F1]
    Set As : Sum($$JwlTaxAmt)
[Line: JpGSTReportPrintLine13]
    Field: JpGSTReportPrintLine13F1

[Field: JpGSTReportPrintLine13F1]
    Style : JpTotal
[Line: JpGSTReportPrintLine14]
    Field: JpGSTReportPrintLine14F1

[Field: JpGSTReportPrintLine14F1]
    Set As : "Reconciliation: compare this with Tally's own GST reports (Gateway > Display > Statutory Reports > GST). JadePro deliberately does not restate Tally's GST computation."
    Style : JpFontBold
[Export: JpGSTReportExport]
    Title: <1000, "GST Summary">
    Repeat: Over: JpGSTReport
    Export Title: Detail
    Export: Value: $$LEDGERNAME
    Export: Value: $$JwlTaxAmt

;  REPORT 6 - JEWELLERY STOCK BY PIECES AND WEIGHT
;  Hybrid valuation as agreed: metal valued at the live rate for the purity,
;  stones and diamonds at the item's own rates. Stock value therefore moves
;  with the market without needing a stock revaluation voucher.
; =============================================================================
[Collection: Report: JpStockReport]
    Source: JpStockReportSQL
    Var: JpFromDate, JpToDate, JpStockCat, JpStockPurity, JpStockMetal
    Title: <1000,###,#a##"  JEWELLERY STOCK - PIECES AND WEIGHT">
    Print: JpStockReportPrint
    Export: JpStockReportExport
    Key: JpStockReportKey
    Filters: <JpFromDate, <Date, "As From Date">>, <JpToDate, <Date, "As To Date">>, <JpStockCat, <String, "Category">>, <JpStockPurity, <String, "Purity">>, <JpStockMetal, <String, "Metal">>

[Variable: JpStockReportSQL : String]
    Type: String
    Value: "SELECT $$NAME$$,$JwlBarcode$$,$JwlCategory$$,$JwlMetalType$$,$JwlPurity$$,$JwlDesignNo$$,$JwlLocation$$,$$QUANTITY$$ AS JwlQty, SUM($JwlNetMetalWt$$ * $$QUANTITY$$) AS JwlNetWt, SUM($JwlFinalValue$$ * $$QUANTITY$$) AS JwlStockVal FROM $$ITEMSSTOCK$$ WHERE $JwlIsJewellery$$ = 1 GROUP BY $$NAME$$ ORDER BY $JwlCategory$$,$JwlPurity$$"

[Variable: JpStockReportKey : String]
    Type: String
    Value: "NAME"


