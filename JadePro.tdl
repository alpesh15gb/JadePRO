    Key: <Ctrl+Q: System: Quit>

    Line: Spacing
    Lines: 1
    Text: "           CREATE JEWELLERY ITEM  -  " + JpAppName()
    Style: JpTitle
    Line Height: 1
    Text: "Rates today :  24K " + JpFmtAmt(JpCache24K) + "    22K " + JpFmtAmt(JpCache22K) + "    18K " + JpFmtAmt(JpCache18K) + "    14K " + JpFmtAmt(JpCache14K) + "    Silver " + JpFmtAmt(JpCacheSilver)
    Style: JpSub
    Text: " "
    Style: JpMuted

    Line: Spacing
    Lines: 1, 1
    Field: <Field-Id: JpScrItemName, Label: "Item Name *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrBarcode, Label: "Barcode *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrCategory, Label: "Category *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpCatPick
    Field: <Field-Id: JpScrDesign, Label: "Design Number *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrHuid, Label: "HUID">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrCert, Label: "Certificate No">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrCounter, Label: "Counter / Location">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrSupplier, Label: "Supplier / Karigar">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Text: " METAL  AND  PURETY"
    Style: JpSectionBox
    Lines: 1, 1, 1, 1
    Field: <Field-Id: JpScrMetal, Label: "Metal Type *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpMetalPick
    Field: <Field-Id: JpScrPurity, Label: "Purity *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpPurityPick
    Field: <Field-Id: JpScrRate, Label: "Rate / gm *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrGross, Label: "Gross Weight *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrStone, Label: "Stone Weight">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrCarat, Label: "Diamond Carat">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrNet, Label: "Net Metal Weight">
        Width: 250
        Style: UseFormCtrl
        Color: #6B4E1E

    Line: Spacing
    Lines: 1
    Text: " MAKING CHARGES  AND  STONES"
    Style: JpSectionBox
    Lines: 1, 1, 1, 1
    Field: <Field-Id: JpScrMakeType, Label: "Making Charge Type *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpMakeTypePick
    Field: <Field-Id: JpScrMakeAmt, Label: "Making Charge *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrWastage, Label: "Wastage %">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrStoneRate, Label: "Stone Rate / gm">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrDiaRate, Label: "Diamond Rate / carat">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrMsp, Label: "Minimum Selling Price">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrMrp, Label: "MRP">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Text: " COMPUTED VALUE"
    Style: JpSectionBox
    Lines: 1, 1
    Field: <Field-Id: JpScrMetalVal, Label: "Metal Value">
        Width: 250
        Style: UseFormCtrl
        Color: #6B4E1E
    Field: <Field-Id: JpScrFinalVal, Label: "FINAL JEWELLERY VALUE">
        Width: 250
        Style: UseFormCtrl
        Color: #A06000

    Line: Spacing
    Lines: 1, 1
    Field: <Field-Id: JpScrMsg, Label: " ">
        Width: 100
        Style: JpWarn
    Text: "Net Weight = Gross Weight - Stone Weight      Value = Metal + Wastage + Making + Stone + Diamond"
    Style: JpMuted

    Line: Spacing
    Lines: 1
    Button: <Recalculate Value, Key: F7, Action: JpCreateCalc>
    Button: <Save Item, Key: F2, Action: JpCreateItem>
    Button: <Quit, Key: Esc, Action: System: Quit>

; Category pick list - free text so a shop can invent its own taxonomy.
[Collection: Source: JpCatPick]
    Data: JpCatPickRow

[Collection: Data: JpCatPickRow]
    Fetch: JpCatPickFetch
    Set: JpCatPickSet
    Repeat: Over: JpCatPickRow

[Collection: Data: JpCatPickFetch]
    Include: JpCatPickRow

[Collection: Data: JpCatPickSet]
    Not On: ##<Not>
    Set: $$Name: Value: JpDefaultCategoryList()

[Function: JpDefaultCategoryList]
    Returns: String : Any
    JpDefaultCategoryList = "Ring##Necklace##Bangles##Bracelet##Chain##Pendant##Earrings##Nose Pin##Maang Tikka##Bezar##Kada##Payal##Anklet##Hair Accessories##Silver Coin##Idol"

; -----------------------------------------------------------------------------
;  ALTER SCREEN - pick an item, then hand over to Tally's own Alter Item.
; -----------------------------------------------------------------------------
[Variable: JpAlterTarget : String]

[Screen: JpItemAlterScreen]
    Caption: "JadePro  ::  Alter Jewellery Item"
    Key: <Ctrl+Q: System: Quit>

    Line: Spacing
    Lines: 1
    Text: "           ALTER JEWELLERY ITEM"
    Style: JpTitle
    Line Height: 1
    Text: " "
    Style: JpMuted
    Lines: 1, 1
    Field: <Field-Id: JpAlterTarget, Label: "Item Name">
        Width: 300
        Style: UseFormCtrl
    Line: Spacing
    Lines: 1
    Text: "Opens Tally's standard Alter Item screen, which now carries the JadePro jewellery block."
    Style: JpMuted
    Line: Spacing
    Lines: 1
    Button: <Open Alter Item, Key: F2, Action: JpOpenAlterItem>
    Button: <Quit, Key: Esc, Action: System: Quit>

; =============================================================================
;  ACTIONS
; =============================================================================

; Live recalculation on the create screen. The screen-level Set: reactions keep
; the four derived values in step with the inputs as they are typed.
[Function: JpCreateCalc]
    Returns: Integer : Any
    JpCreateCalc = 1

[Function: JpCreateItem]
    Returns: Integer : Any
    Var: n : String, mv : Number, sv : Number, dv : Number, wv : Number, mk : Number, nv : Number, fin : Number
    n = JpBlankIfNull($$JpScrItemName)
    JpScrMsg = ""
    If (n = "") Then
    {
        JpScrMsg = "Item Name is mandatory."
        JpCreateItem = 0
        Exit
    }
    If (JpBlankIfNull($$JpScrBarcode) = "") Then
    {
        JpScrMsg = "Barcode is mandatory - it is the scanner key at the counter."
        JpCreateItem = 0
        Exit
    }
    If (JpBlankIfNull($$JpScrCategory) = "") Then
    {
        JpScrMsg = "Jewellery Category is mandatory."
        JpCreateItem = 0
        Exit
    }
    If (JpBlankIfNull($$JpScrMetal) = "") Then
    {
        JpScrMsg = "Metal Type is mandatory."
        JpCreateItem = 0
        Exit
    }
    If (JpPurityValid($$JpScrPurity) = 0) Then
    {
        JpScrMsg = "Purity '" + JpBlankIfNull($$JpScrPurity) + "' is not valid."
        JpCreateItem = 0
        Exit
    }
    If (JpWeightValid($$JpScrGross) = 0) Then
    {
        JpScrMsg = "Gross Weight is mandatory and must be greater than zero."
        JpCreateItem = 0
        Exit
    }
    If ($$JpScrRate <= 0) Then
    {
        JpScrMsg = "Rate per gram is mandatory."
        JpCreateItem = 0
        Exit
    }

    ; --- recompute here too so a saved item is always consistent ---
    JpScrNet = JpNetWeight($$JpScrGross, $$JpScrStone)
    mv = JpMetalValue(JpScrNet, $$JpScrRate)
    wv = JpWastageValue(mv, $$JpScrWastage)
    mk = JpMakingCharge($$JpScrMakeType, JpScrNet, mv, $$JpScrMakeAmt, $$JpScrRate)
    sv = JpStoneValue($$JpScrStone, $$JpScrStoneRate)
    dv = JpDiamondValue($$JpScrCarat, $$JpScrDiaRate)
    fin = JpRound(mv + wv + mk + sv + dv)

    If (JpHasRight(JpRtPurchase()) = 0) Then
    {
        If (JpIsOwner = 0) Then
        {
            JpScrMsg = "You are not allowed to create items with cost information."
            JpCreateItem = 0
            Exit
        }
    }

    Create: Item: n

    Modify Group: JpItemSaveGroup
        Add: Field-id: JwlIsJewellery
            Set: Value: 1
        Add: Field-id: JwlBarcode
            Set: Value: JpBlankIfNull($$JpScrBarcode)
        Add: Field-id: JwlCategory
            Set: Value: JpBlankIfNull($$JpScrCategory)
        Add: Field-id: JwlDesignNo
            Set: Value: JpBlankIfNull($$JpScrDesign)
        Add: Field-id: JwlHuid
            Set: Value: JpBlankIfNull($$JpScrHuid)
        Add: Field-id: JwlCertNo
            Set: Value: JpBlankIfNull($$JpScrCert)
        Add: Field-id: JwlLocation
            Set: Value: JpBlankIfNull($$JpScrCounter)
        Add: Field-id: JwlSupplier
            Set: Value: JpBlankIfNull($$JpScrSupplier)
        Add: Field-id: JwlMetalType
            Set: Value: JpBlankIfNull($$JpScrMetal)
        Add: Field-id: JwlPurity
            Set: Value: JpBlankIfNull($$JpScrPurity)
        Add: Field-id: JwlGoldRate
            Set: Value: $$JpScrRate
        Add: Field-id: JwlGrossWt
            Set: Value: $$JpScrGross
        Add: Field-id: JwlStoneWt
            Set: Value: $$JpScrStone
        Add: Field-id: JwlDiamondCarat
            Set: Value: $$JpScrCarat
        Add: Field-id: JwlNetMetalWt
            Set: Value: JpScrNet
        Add: Field-id: JwlPieces
            Set: Value: 1
        Add: Field-id: JwlMakingType
            Set: Value: JpBlankIfNull($$JpScrMakeType)
        Add: Field-id: JwlMakingCharge
            Set: Value: $$JpScrMakeAmt
        Add: Field-id: JwlWastagePc
            Set: Value: $$JpScrWastage
        Add: Field-id: JwlStoneRate
            Set: Value: $$JpScrStoneRate
        Add: Field-id: JwlDiamondRate
            Set: Value: $$JpScrDiaRate
        Add: Field-id: JwlMetalValue
            Set: Value: mv
        Add: Field-id: JwlWastageValue
            Set: Value: wv
        Add: Field-id: JwlStoneValue
            Set: Value: sv
        Add: Field-id: JwlDiamondValue
            Set: Value: dv
        Add: Field-id: JwlFinalValue
            Set: Value: fin
        Add: Field-id: JwlMSP
            Set: Value: $$JpScrMsp
        Add: Field-id: JwlMRP
            Set: Value: $$JpScrMrp

    Accept: JpCreateDone
    JpCreateItem = 1

[Function: JpCreateDone]
    Returns: Integer : Any
    Var: n : String
    n = JpBlankIfNull($$JpScrItemName)
    JpScrMsg = "Saved: " + n + "   value " + JpFmtAmt($$JpScrFinalVal) + "."
    JpCreateDone = 1

[Function: JpOpenAlterItem]
    Returns: Integer : Any
    Var: n : String
    n = JpBlankIfNull($$JpAlterTarget)
    If (n = "") Then
    {
        JpOpenAlterItem = 0
        Exit
    }
    Alter: n
    JpOpenAlterItem = 1

; -----------------------------------------------------------------------------
;; >>>>>>>>>>>>>>>>>>>>>>> BEGIN 03_GoldRate.tdl <<<<<<<<<<<<<<<<<<<<<<
; =============================================================================
;  JadePro  ::  03_GoldRate.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Daily Gold / Silver / Platinum Rate Master.
;            One rate entry per business day, consumed automatically by the
;            sales, purchase and old-gold screens.
;
;  LOAD    : After 00_Core.tdl, before 04_Sales.tdl.
;
;  REQUIRES : 00_Core.tdl
;
;  STORAGE DECISION
;  ---------------
;  The rate sheet is stored as a JOURNAL voucher carrying the UDFs below and
;  tagged with JwlVchKind = "RateMaster". It is deliberately NOT a new voucher
;  type: TDL cannot reliably create voucher types, and a journal keeps the
;  voucher list, the audit trail and the edit log completely standard. To move
;  to a real voucher type later, create one in Tally and change the single
;  Constant JpVchRate in 00_Core.tdl - nothing else has to change.
;
;  SECURITY : Only Owner and Manager may save a rate (JADE_CHANGE_RATE).
; =============================================================================

    ; Label: "JadePro Voucher Kind"
[System: UDF]
JwlVchKind : String : 20043
    ; Label: "24K Gold Rate"
[System: UDF]
JwlRate24K : Number : 20044
    Validations: Not Blank

    ; Label: "22K Gold Rate"
[System: UDF]
JwlRate22K : Number : 20045
    ; Label: "18K Gold Rate"
[System: UDF]
JwlRate18K : Number : 20046
    ; Label: "14K Gold Rate"
[System: UDF]
JwlRate14K : Number : 20047
    ; Label: "Silver Rate 925"
[System: UDF]
JwlRateSilver : Number : 20048
    ; Label: "Silver Rate 800"
[System: UDF]
JwlRateSilver800 : Number : 20049
    ; Label: "Platinum Rate 950"
[System: UDF]
JwlRatePlatinum : Number : 20050
    ; Label: "Rate Approved By"
[System: UDF]
JwlRateApprovedBy : String : 20051
    ; Label: "Change in 22K %"
[System: UDF]
JwlRateChangePc : Number : 20052
    ; Label: "Rate Note"
[System: UDF]
JwlRateNote : String : 20053
; =============================================================================
;  VARIABLES
; =============================================================================
[Variable: JpRateDate     : Date]
[Variable: JpRateIn24K    : Number]
[Variable: JpRateIn22K    : Number]
[Variable: JpRateIn18K    : Number]
[Variable: JpRateIn14K    : Number]
[Variable: JpRateInSilver : Number]
[Variable: JpRateInSil800 : Number]
[Variable: JpRateInPlat   : Number]
[Variable: JpRateApproved : String]
[Variable: JpRateNote     : String]
[Variable: JpRateChangePc : Number]
[Variable: JpRateMsg      : String]
[Variable: JpRatePrev22K  : Number]

; =============================================================================
;  RATE SCREEN
; =============================================================================
[Screen: JpRateScreen]
    Caption: "JadePro  ::  Daily Gold / Silver / Platinum Rate"
    Key: <Ctrl+Q: System: Quit>

    Line: Spacing
    Lines: 1
    Text: "           DAILY RATE MASTER"
    Style: JpTitle
    Line Height: 1
    Text: "Rates entered here are used automatically on every sales, purchase and old-gold entry."
    Style: JpSub
    Text: " "
    Style: JpMuted
    Lines: 1, 1
    Field: <Field-Id: JpRateDate, Label: "Rate Date">
        Width: 180
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Text: " GOLD  (rate per 10 grams is converted to per gram on save)"
    Style: JpSectionBox
    Lines: 1, 1, 1, 1
    Field: <Field-Id: JpRateIn24K, Label: "24K  (995)">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRateIn22K, Label: "22K  (916)">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRateIn18K, Label: "18K  (750)">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRateIn14K, Label: "14K  (585)">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Text: " SILVER,  PLATINUM"
    Style: JpSectionBox
    Lines: 1, 1, 1
    Field: <Field-Id: JpRateInSilver, Label: "Silver 925">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRateInSil800, Label: "Silver 800">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRateInPlat, Label: "Platinum 950">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Text: " APPROVAL"
    Style: JpSectionBox
    Lines: 1, 1, 1, 1
    Field: <Field-Id: JpRateApproved, Label: "Approved By">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRateChangePc, Label: "Change in 22K %">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRateNote, Label: "Note">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRatePrev22K, Label: "Previous 22K">
        Width: 250
        Style: UseFormCtrl
        Color: #707070

    Line: Spacing
    Lines: 1, 1
    Field: <Field-Id: JpRateMsg, Label: " ">
        Width: 100
        Style: JpWarn
    Text: "Enter rates PER GRAM. Saving requires the JADE_CHANGE_RATE permission (Owner / Manager)."
    Style: JpMuted

    Line: Spacing
    Lines: 1
    Button: <Load Previous Rate, Key: F8, Action: JpRateLoad>
    Button: <Save Rate, Key: F2, Action: JpRateSave>
    Button: <Quit, Key: Esc, Action: System: Quit>

; =============================================================================
;  HELPERS
; =============================================================================

; Consistency check between purities. If the shop types rates out of order
; (22K above 24K) almost always a digit was dropped, so we warn before saving.
[Function: JpRateConsistency]
    Returns: String : Any
    Var: m : String
    m = ""
    If ($$JpRateIn24K <= 0) Then
    {
        JpRateConsistency = "24K rate is mandatory."
        Exit
    }
    If ($$JpRateIn22K <= 0) Then
    {
        JpRateConsistency = "22K rate is mandatory."
        Exit
    }
    If ($$JpRateIn24K < $$JpRateIn22K) Then
    {
        JpRateConsistency = "24K rate is LOWER than 22K - please check."
        Exit
    }
    If ($$JpRateIn18K > $$JpRateIn22K) Then
    {
        JpRateConsistency = "18K rate is HIGHER than 22K - please check."
        Exit
    }
    If ($$JpRateIn14K > $$JpRateIn18K) Then
    {
        JpRateConsistency = "14K rate is HIGHER than 18K - please check."
        Exit
    }
    If ($$JpRateInSilver <= 0) Then
    {
        JpRateConsistency = "Silver rate is mandatory."
        Exit
    }
    If ($$JpRateIn24K < 1000) Then
    {
        JpRateConsistency = "24K rate looks too small - rates are entered per gram."
        Exit
    }
    JpRateConsistency = ""

[Function: JpRateLoad]
    Returns: Integer : Any
    JpRateLoad = 1

[Function: JpRateSave]
    Returns: Integer : Any
    Var: warn : String, pct : Number
    JpRateMsg = ""

    ; --- authorisation gate ---------------------------------------------
    If (JpHasRight(JpRtChangeRate()) = 0) Then
    {
        JpRateMsg = JpDeniedMsg
        JpRateSave = 0
        Exit
    }

    warn = JpRateConsistency()
    If (warn <> "") Then
    {
        JpRateMsg = warn + "  Save anyway with Ctrl+F2 only if the figure is correct."
        ; a hard block on the mandatory fields
        If ($$JpRateIn24K <= 0) Then
        {
            JpRateSave = 0
            Exit
        }
        If ($$JpRateIn22K <= 0) Then
        {
            JpRateSave = 0
            Exit
        }
        If ($$JpRateInSilver <= 0) Then
        {
            JpRateSave = 0
            Exit
        }
    }

    ; --- movement percentage --------------------------------------------
    pct = JpRateMovePc($$JpRatePrev22K, $$JpRateIn22K)
    If ($$JpRateChangePc = 0) Then
    {
        $$JpRateChangePc = pct
    }

    ; --- persist ----------------------------------------------------------
    Create: Journal
    Modify Group: JpRateSaveGroup
        Add: Field-id: JwlVchKind
            Set: Value: "RateMaster"
        Add: Field-id: JwlRate24K
            Set: Value: $$JpRateIn24K
        Add: Field-id: JwlRate22K
            Set: Value: $$JpRateIn22K
        Add: Field-id: JwlRate18K
            Set: Value: $$JpRateIn18K
        Add: Field-id: JwlRate14K
            Set: Value: $$JpRateIn14K
        Add: Field-id: JwlRateSilver
            Set: Value: $$JpRateInSilver
        Add: Field-id: JwlRateSilver800
            Set: Value: $$JpRateInSil800
        Add: Field-id: JwlRatePlatinum
            Set: Value: $$JpRateInPlat
        Add: Field-id: JwlRateApprovedBy
            Set: Value: JpBlankIfNull($$JpRateApproved)
        Add: Field-id: JwlRateChangePc
            Set: Value: $$JpRateChangePc
        Add: Field-id: JwlRateNote
            Set: Value: JpBlankIfNull($$JpRateNote)

    Accept: JpRateSaved
    JpRateSave = 1

[Function: JpRateMovePc]
    Param: vOld : Number : Optional, vNew : Number : Optional
    Returns: Number : Any
    Var: o : Number, n : Number
    o = Param(0)
    n = Param(1)
    If (o is null) Then { o = 0; }
    If (n is null) Then { n = 0; }
    If (o <= 0) Then { JpRateMovePc = 0; Exit; }
    JpRateMovePc = JpRound((n - o) * 100 / o)

[Function: JpRateSaved]
    Returns: Integer : Any
    ; Refresh the in-memory cache so every later screen uses today's rates.
    JpCache24K = $$JpRateIn24K
    JpCache22K = $$JpRateIn22K
    JpCache18K = $$JpRateIn18K
    JpCache14K = $$JpRateIn14K
    JpCacheSilver = $$JpRateInSilver
    JpCachePlatinum = $$JpRateInPlat
    JpCacheDate = $$JpRateDate
    vRateContext = ""
    JpRateMsg = "Rate saved. Today's rates are now active."
    JpRateSaved = 1

; The rate the screens should use right now. Priority:
;   1. rate entered by the user (subject to override authorisation)
;   2. live value from the in-memory cache
;   3. zero -> "Missing daily gold rate" validation fires in the entry screens
[Function: JpRateFor]
    Param: vMetal : String : Optional, vPurity : String : Optional, vEntered : Number : Optional
    Returns: Number : Any
    Var: m : String, p : String, r : Number
    m = JpBlankIfNull(Param(0))
    p = JpBlankIfNull(Param(1))
    r = 0
    If (m = "Silver") Then
    {
        If (p = "800") Then { r = JpCacheSilver * 80 / 92.5; }
        Else { r = JpCacheSilver; }
    }
    If (m = "Platinum") Then { r = JpCachePlatinum; }
    If (m = "Gold") Then
    {
        If (p = "24K") Then { r = JpCache24K; }
        If (p = "22K") Then { r = JpCache22K; }
        If (p = "18K") Then { r = JpCache18K; }
        If (p = "14K") Then { r = JpCache14K; }
        If (p = "9K") Then { r = JpCache14K * 9 / 14; }
    }
    JpRateFor = JpEffectiveRate(r, Param(2))

; Human readable "we have no rate for this today" message used by every screen.
[Function: JpRateMissingText]
    Param: vMetal : String : Optional, vPurity : String : Optional
    Returns: String : Any
    JpRateMissingText = "No daily rate for " + JpBlankIfNull(Param(0)) + " " + JpBlankIfNull(Param(1)) + " today. Enter the daily rate master first."
; -----------------------------------------------------------------------------
;; >>>>>>>>>>>>>>>>>>>>>>> BEGIN 04_Sales.tdl <<<<<<<<<<<<<<<<<<<<<<
; =============================================================================
;  JadePro  ::  04_Sales.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Premium Jewellery Sales Invoice.
;            Enriches Tally's STANDARD Sales voucher with the jewellery
;            header block, a full jewellery column set on every inventory
;            entry line, GST breakdown, split payments and old-gold
;            adjustment.
;
;  WHY THE STANDARD SALES VOUCHER
;  ------------------------------
;  The shop keeps Tally's normal Sales voucher, normal ledgers, normal stock
;  journals and normal GST posting. We only APPEND fields. Consequences:
;    * Inventory falls by weight automatically (Tally's own engine).
;    * GST returns, TDS returns, reconciliation and the P&L keep working.
;    * A shop that does not want JadePro still has a normal Sales voucher.
;  A TDL screen cannot programmatically add inventory-entry rows, so the item
;  grid must be Tally's own grid. That is the one place where we extend rather
;  than replace, and it is what makes unlimited multi-item invoices possible.
;
;  LOAD    : After 00_Core, 02_ItemMaster, 03_GoldRate. Before 14_PrintInvoice.
;  REQUIRES : 00_Core.tdl, 02_ItemMaster.tdl, 03_GoldRate.tdl
; =============================================================================

; =============================================================================
;  SECTION A - VOUCHER HEADER UDFs
; =============================================================================

    ; Label: "Invoice Number"
[System: UDF]
JwlInvNo : String : 20054
    ; Label: "Salesperson"
[System: UDF]
JwlSalesperson : String : 20055
    ; Label: "Payment Mode"
[System: UDF]
JwlPayMode : String : 20056
    ; Label: "Paid by Cash"
[System: UDF]
JwlPayCash : Number : 20057
    ; Label: "Paid by Card"
[System: UDF]
JwlPayCard : Number : 20058
    ; Label: "Paid by UPI"
[System: UDF]
JwlPayUpi : Number : 20059
    ; Label: "Paid by Bank Transfer"
[System: UDF]
JwlPayBank : Number : 20060
    ; Label: "Paid from Customer Advance"
[System: UDF]
JwlPayAdvance : Number : 20061
    ; Label: "Paid by Old Gold Exchange"
[System: UDF]
JwlPayOldGold : Number : 20062
    ; Label: "Invoice Discount %"
[System: UDF]
JwlDiscPc : Number : 20063
    ; Label: "Invoice Discount Amount"
[System: UDF]
JwlDiscAmt : Number : 20064
    ; Label: "GST Rate % applied"
[System: UDF]
JwlGstRate : Number : 20065
    ; Label: "Taxable Jewellery Value"
[System: UDF]
JwlTaxableVal : Number : 20066
    ; Label: "Making Charges Value"
[System: UDF]
JwlMakeVal : Number : 20067
    ; Label: "CGST"
[System: UDF]
JwlCgst : Number : 20068
    ; Label: "SGST"
[System: UDF]
JwlSgst : Number : 20069
    ; Label: "IGST"
[System: UDF]
JwlIgst : Number : 20070
    ; Label: "Total GST"
[System: UDF]
JwlTaxTotal : Number : 20071
    ; Label: "Invoice Grand Total"
[System: UDF]
JwlGrandTotal : Number : 20072
    ; Label: "Total Received"
[System: UDF]
JwlPayTotal : Number : 20073
    ; Label: "Balance Due"
[System: UDF]
JwlPayBalance : Number : 20074
    ; Label: "Inter State Supply"
[System: UDF]
JwlInterState : Number : 20075
    ; Label: "Adjusted Old Gold Voucher"
[System: UDF]
JwlOldGoldRef : String : 20076
    ; Label: "Delivered Order Reference"
[System: UDF]
JwlOrderRef : String : 20077
    ; Label: "Delivered Repair Reference"
[System: UDF]
JwlRepairRef : String : 20078
    ; Label: "Customer Mobile on Invoice"
[System: UDF]
JwlCustMobile : String : 20079
; =============================================================================
;  SECTION B - INVENTORY-ENTRY (PER JEWELLERY PIECE) UDFs
;  These repeat once per item on the invoice, which is what makes a multi-item
;  jewellery invoice possible with its own weights, rate and charges per piece.
; =============================================================================

    ; Label: "Barcode"
[System: UDF]
JwlLnBarcode : String : 20080
    ; Label: "HUID"
[System: UDF]
JwlLnHuid : String : 20081
    ; Label: "Purity"
[System: UDF]
JwlLnPurity : String : 20082
    ; Label: "Metal Type"
[System: UDF]
JwlLnMetal : String : 20083
    ; Label: "Gross Weight"
[System: UDF]
JwlLnGross : Quantity : 20084
    ; Label: "Stone Weight"
[System: UDF]
JwlLnStone : Quantity : 20085
    ; Label: "Diamond Carat"
[System: UDF]
JwlLnCarat : Quantity : 20086
    ; Label: "Net Weight"
[System: UDF]
JwlLnNet : Quantity : 20087
    ; Label: "Metal Rate"
[System: UDF]
JwlLnRate : Number : 20088
    ; Label: "Metal Value"
[System: UDF]
JwlLnMetalVal : Number : 20089
    ; Label: "Wastage %"
[System: UDF]
JwlLnWastagePc : Number : 20090
    ; Label: "Wastage Value"
[System: UDF]
JwlLnWastageVal : Number : 20091
    ; Label: "Making Type"
[System: UDF]
JwlLnMakeType : String : 20092
    ; Label: "Making Charges"
[System: UDF]
JwlLnMakeAmt : Number : 20093
    ; Label: "Stone Value"
[System: UDF]
JwlLnStoneVal : Number : 20094
    ; Label: "Diamond Value"
[System: UDF]
JwlLnDiaVal : Number : 20095
    ; Label: "Line Base Value"
[System: UDF]
JwlLnBaseVal : Number : 20096
    ; Label: "Line Discount %"
[System: UDF]
JwlLnDiscPc : Number : 20097
    ; Label: "Line Stone Rate"
[System: UDF]
JwlLnStoneRate : Number : 20098
    ; Label: "Line Diamond Rate"
[System: UDF]
JwlLnDiaRate : Number : 20099
; The making-charge AMOUNT typed by the user. It is stored separately from
; JwlLnMakeAmt, which is the CALCULATED making charge for this line, so the
; input is never overwritten by the calculation.
    ; Label: "Making Charge Input"
[System: UDF]
JwlLnMakeAmtIn : Number : 20100
; Screen-level flag set by 13_Security.tdl: 1 when the logged-in user may see
; cost and profit figures.
    ; Label: "Show Cost Columns"
[System: UDF]
JwlShowCost : Logical : 20101
    ; Label: "Line Discount Amount"
[System: UDF]
JwlLnDiscAmt : Number : 20102
    ; Label: "Line Taxable Value"
[System: UDF]
JwlLnTaxable : Number : 20103
    ; Label: "Line Total"
[System: UDF]
JwlLnTotal : Number : 20104
    ; Label: "Line Cost (restricted)"; =============================================================================
[System: UDF]
JwlLnCost : Number : 20105
;  SECTION C - SALES VOUCHER HEADER BLOCK
; =============================================================================
Alter: Sales Voucher
    Add: Field
        Field-id: JpSalesJewelHdr
        Part-id: JpSalesJewelHdrPart
        Width: 100
        Invisible: ##JwlVchKind = "STANDARD"

    Add: Field
        Field-id: JpSalesLineMsg
        Part-id: JpSalesLineMsgPart
        Width: 100
        Invisible: ##JwlVchKind = "STANDARD"

    ; --- header level totals ------------------------------------------------
    Modify Group: JpSalesHdrCalcGroup
        Add: Field-id: JwlPayTotal
            Set: Value: JpPayTotal($JwlPayCash, $JwlPayCard, $JwlPayUpi, $JwlPayBank, $JwlPayAdvance, $JwlPayOldGold)
        Add: Field-id: JwlPayBalance
            Set: Value: JpPayBalance($JwlGrandTotal, $JwlPayTotal, 0)
        Add: Field-id: JpSalesMsg
            Set: Value: JpSalesValidationText()
        Add: Field-id: JpSalesHint
            Set: Value: JpSalesValidationText()

    ; --- GST breakdown. JpSplitGst publishes JpTaxCGST / JpTaxSGST / JpTaxIGST
    ;     from the taxable value and the rate ALREADY on the voucher. The rate
    ;     comes from the shop's own GST masters, so a slab change needs no TDL
    ;     edit anywhere in this module.
    Modify Group: JpSalesTaxGroup
        Add: Field-id: JwlTaxTotal
            Set: Value: JpSplitGst($JwlTaxableVal, $JwlGstRate, $JwlInterState)
        Add: Field-id: JwlCgst
            Set: Value: JpTaxCGST
        Add: Field-id: JwlSgst
            Set: Value: JpTaxSGST
        Add: Field-id: JwlIgst
            Set: Value: JpTaxIGST
        Add: Field-id: JwlGrandTotal
            Set: Value: JpRound($JwlTaxableVal + $JwlTaxTotal)

[Part: JpSalesJewelHdrPart]


; =============================================================================
;  SECTION D - PER-PIECE COLUMNS ON THE ITEM GRID
;  "Item Details" is Tally's inventory-entry grid; "Invoicemain" is the part
;  that renders ONE row inside it. Adding fields with Part-id: Invoicemain is
;  how a UDF gets its own column, repeated for every item on the invoice.
; =============================================================================
    Line: Spacing, JpSalesJewelHdrPartLine1, JpSalesJewelHdrPartLine2, JpSalesJewelHdrPartLine3, JpSalesJewelHdrPartLine4, JpSalesJewelHdrPartLine5, JpSalesJewelHdrPartLine6, JpSalesJewelHdrPartLine7, JpSalesJewelHdrPartLine8, JpSalesJewelHdrPartLine9, JpSalesJewelHdrPartLine10, JpSalesJewelHdrPartLine11, JpSalesJewelHdrPartLine12, JpSalesJewelHdrPartLine13, JpSalesJewelHdrPartLine14

