        Width: 250
        Style: UseFormCtrl
        Color: #A06000
        Font: Bold
    Field: <Field-Id: JpJobBalAmt, Label: "Value of Metal With Karigar">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobMsg, Label: " ">
        Width: 250
        Style: JpWarn

    Line: Spacing
    Lines: 1
    Button: <Recalculate (F7), Key: F7, Action: JpJobCalc>
    Button: <Save Job Entry (F2), Key: F2, Action: JpJobSave>
    Button: <Karigar Outstanding (F8), Key: F8, Action: JpJobOutstanding>
    Button: <Quit (Esc), Key: Esc, Action: System: Quit>

[Collection: Source: JpJobModePick]
    Data: JpJobModePickRow

[Collection: Data: JpJobModePickRow]
    Fetch: JpJobModePickFetch
    Set: JpJobModePickSet
    Repeat: Over: JpJobModePickRow

[Collection: Data: JpJobModePickFetch]
    Include: JpJobModePickRow

[Collection: Data: JpJobModePickSet]
    Not On: ##<Not>
    Set: $$Name: Value: JpJobTypeList()

[Collection: Source: JpJobStatusPick]
    Data: JpJobStatusPickRow

[Collection: Data: JpJobStatusPickRow]
    Fetch: JpJobStatusPickFetch
    Set: JpJobStatusPickSet
    Repeat: Over: JpJobStatusPickRow

[Collection: Data: JpJobStatusPickFetch]
    Include: JpJobStatusPickRow

[Collection: Data: JpJobStatusPickSet]
    Not On: ##<Not>
    Set: $$Name: Value: JpJobStatusList()

[Function: JpJobTypeList]
    Returns: String : Any
    JpJobTypeList = "Karigar Issue##Karigar Receipt"

; =============================================================================
;  SECTION F - ACTIONS
; =============================================================================

[Function: JpJobCalc]
    Returns: Integer : Any
    Var: r : Number
    $$JpJobRecvNet = JpNetWeight($$JpJobRecvGross, $$JpJobRecvStone)
    $$JpJobWastWt = JpJobWastageWt($$JpJobIssued, $$JpJobRecvNet, $$JpJobWastPc)
    $$JpJobBalanceWt = JpJobBalance($$JpJobIssued, $$JpJobRecvNet, $$JpJobWastPc)
    r = JpRateFor("Gold", $$JpJobPurity, 0)
    If (r <= 0) Then
    {
        r = JpCache22K
    }
    $$JpJobBalAmt = JpMetalValue($$JpJobBalanceWt, r)
    JpJobMsg = JpJobValidationText()
    JpJobCalc = 1

[Function: JpJobValidationText]
    Returns: String : Any
    Var: m : String
    m = ""
    If (JpBlankIfNull($$JpJobMode) = "") Then
    {
        JpJobValidationText = "Job Type is mandatory."
        Exit
    }
    If (JpBlankIfNull($$JpJobRef) = "") Then
    {
        JpJobValidationText = "Job Reference is mandatory."
        Exit
    }
    If (JpBlankIfNull($$JpJobKarigarNm) = "") Then
    {
        JpJobValidationText = "Karigar name is mandatory."
        Exit
    }
    If (JpHasRight(JpRtKarigarMgmt()) = 0) Then
    {
        JpJobValidationText = JpDeniedMsg
        Exit
    }
    If ($$JpJobMode = "Karigar Issue") Then
    {
        If (JpWeightValid($$JpJobIssued) = 0) Then
        {
            JpJobValidationText = "Weight issued is mandatory."
            Exit
        }
        JpJobValidationText = ""
        Exit
    }
    ; --- Karigar Receipt ---
    If (JpWeightValid($$JpJobRecvGross) = 0) Then
    {
        JpJobValidationText = "Gross weight received is mandatory."
        Exit
    }
    If ($$JpJobRecvNet <= 0) Then
    {
        JpJobValidationText = "Stone weight is greater than or equal to gross weight."
        Exit
    }
    If ($$JpJobLabourAmt < 0) Then
    {
        JpJobValidationText = "Labour charges cannot be negative."
        Exit
    }
    If ($$JpJobBalanceWt < 0) Then
    {
        JpJobValidationText = "Received weight is MORE than the weight issued. Check the entry or record wastage."
        Exit
    }
    JpJobValidationText = ""

[Function: JpJobSave]
    Returns: Integer : Any
    JpJobCalc
    If (JpJobValidationText() <> "") Then
    {
        JpJobSave = 0
        Exit
    }
    Create: Journal
    Modify Group: JpJobSaveGroup
        Add: Field-id: JwlVchKind
            Set: Value: "KarigarJob"
        Add: Field-id: JwlJobNo
            Set: Value: $$JpJobRef
        Add: Field-id: JwlJobKarigar
            Set: Value: $$JpJobKarigarNm
        Add: Field-id: JwlJobType
            Set: Value: $$JpJobMode
        Add: Field-id: JwlJobDesc
            Set: Value: JpBlankIfNull($$JpJobDescTxt)
        Add: Field-id: JwlJobDesign
            Set: Value: JpBlankIfNull($$JpJobDesignNm)
        Add: Field-id: JwlJobIssuedWt
            Set: Value: $$JpJobIssued
        Add: Field-id: JwlJobIssuedPure
            Set: Value: JpBlankIfNull($$JpJobPurity)
        Add: Field-id: JwlJobIssuedRate
            Set: Value: JpRateFor("Gold", $$JpJobPurity, 0)
        Add: Field-id: JwlJobIssuedDate
            Set: Value: $$JpJobIssuedDt
        Add: Field-id: JwlJobRecvDate
            Set: Value: JpBlankIfNull(JpCacheDate)
        Add: Field-id: JwlJobRecvGross
            Set: Value: $$JpJobRecvGross
        Add: Field-id: JwlJobRecvNet
            Set: Value: $$JpJobRecvNet
        Add: Field-id: JwlJobWastagePc
            Set: Value: $$JpJobWastPc
        Add: Field-id: JwlJobWastageWt
            Set: Value: $$JpJobWastWt
        Add: Field-id: JwlJobLabour
            Set: Value: $$JpJobLabourAmt
        Add: Field-id: JwlJobBalWt
            Set: Value: $$JpJobBalanceWt
        Add: Field-id: JwlJobStatus
            Set: Value: JpBlankIfNull($$JpJobStatusTxt)
    Accept: JpJobSaved
    JpJobSave = 1

[Function: JpJobSaved]
    Returns: Integer : Any
    JpJobMsg = "Job entry saved. Metal still with " + ##JwlJobKarigar + " : " + JpFmtWt(##JwlJobBalWt) + " gm."
    JpJobSaved = 1

[Function: JpJobOutstanding]
    Returns: Integer : Any
    If (JpHasRight(JpRtReports()) = 0) Then
    {
        JpJobMsg = JpDeniedMsg
        JpJobOutstanding = 0
        Exit
    }
    Alter: JpKarigarOutstanding
    JpJobOutstanding = 1

; =============================================================================
;  SECTION G - KARIGAR OUTSTANDING REPORT
;  SQL over the karigar job vouchers so it stays fast with thousands of jobs.
; =============================================================================
[Collection: Report: JpKarigarOutstanding]
    Source: JpKarigarOutstandingSQL
    Var: JpFromDate, JpToDate
    Title: <1000,###,#a##"  KARIGAR OUTSTANDING  -  METAL HELD BY KARIGAR">
    Print: JpKarigarOutstandingPrint
    Export: JpKarigarOutstandingExport
    Key: JpKarigarOutstandingKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>

[Variable: JpKarigarOutstandingSQL : String]
    Type: String
    Value: "SELECT * FROM $$JOURNAL$$ WHERE $JwlVchKind$$ = 'KarigarJob' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$"

[Variable: JpKarigarOutstandingKey : String]
    Type: String
    Value: "JwlJobKarigar"


