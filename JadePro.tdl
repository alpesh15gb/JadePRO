; =============================================================================
;  REPORT 20 - OLD GOLD EXCHANGE REGISTER
; =============================================================================
[Collection: Report: JpOldGoldRegister]
    Source: JpOldGoldSQL
    Var: JpFromDate, JpToDate, JpOgMetalFilter
    Title: <1000,###,#a##"  OLD GOLD EXCHANGE REGISTER">
    Print: JpOldGoldPrint
    Export: JpOldGoldExport
    Key: JpOldGoldKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>, <JpOgMetalFilter, <String, "Metal">>

[Variable: JpOldGoldSQL : String]
    Type: String
    Value: "SELECT $JwlOgVchNo$$ AS JwlOgRef, $$DATE$$ AS JwlOgDate, $JwlOgCustName$$ AS JwlOgCust, $JwlOgMetal$$ AS JwlOgMetal, $JwlOgPurity$$ AS JwlOgPur, $JwlOgPurityPc$$ AS JwlOgPc, $JwlOgGrossWt$$ AS JwlOgGross, $JwlOgStoneWt$$ AS JwlOgStone, $JwlOgNetWt$$ AS JwlOgNet, $JwlOgFineWt$$ AS JwlOgFine, $JwlOgRate$$ AS JwlOgRate, $JwlOgDedPc$$ AS JwlOgDed, $JwlOgValue$$ AS JwlOgValue, $JwlOgAdjAmt$$ AS JwlOgAdj, $JwlOgBalAmt$$ AS JwlOgBal FROM $$JOURNAL$$ WHERE $JwlVchKind$$ = 'OldGold' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$"

[Variable: JpOldGoldKey : String]
    Type: String
    Value: "JwlOgRef"


