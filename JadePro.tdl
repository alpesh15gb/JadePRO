[Line: JpCategoryStockPrintLine31]
    Field: JpCategoryStockPrintLine31F1

[Field: JpCategoryStockPrintLine31F1]
    Style : JpTotal
[Function: JpPcOfVal]
    Returns: Number : Any
    Var: JpFromDate, JpToDate, t : Number
    t = Sum($$JwlStockVal)
    If (t <= 0) Then
    {
        JpPcOfVal = 0
        Exit
    }
    JpPcOfVal = JpRound($$JwlStockVal * 100 / t)

[Export: JpCategoryStockExport]
    Title: <1000, "Category-wise Stock">
    Repeat: Over: JpCategoryStockReport
    Export Title: Detail
    Export: Value: $$JwlCat
    Export: Value: $$JwlQty
    Export: Value: $$JwlNetWt
    Export: Value: $$JwlStockVal


