    Label : "PURCHASE TOTAL"
    Style : JpFontBold
    Width : 140
    Color : #A06000
[Line: JpPurHdrPartLine13]
    Field: JpPurHdrPartLine13F1

[Field: JpPurHdrPartLine13F1]
    Storage : JpPurMsg
    Label : " "
    Width : 200
    Style : JpWarn
Alter: Purchase Voucher, Item Details
    Add: Field
        Field-id: JpPlBarcode
        Part-id: Invoicemain
        Label: "Barcode"
        Type: Text
        Width: 90
    Add: Field
        Field-id: JpPlHuid
        Part-id: Invoicemain
        Label: "HUID"
        Type: Text
        Width: 80
    Add: Field
        Field-id: JpPlPurity
        Part-id: Invoicemain
        Label: "Purity"
        Type: Text
        Width: 55
    Add: Field
        Field-id: JpPlGross
        Part-id: Invoicemain
        Label: "Gr Wt"
        Type: Quantity
        Width: 60
    Add: Field
        Field-id: JpPlStone
        Part-id: Invoicemain
        Label: "St Wt"
        Type: Quantity
        Width: 55
    Add: Field
        Field-id: JpPlNet
        Part-id: Invoicemain
        Label: "Net Wt"
        Type: Quantity
        Width: 60
        Font: Bold
    Add: Field
        Field-id: JpPlRate
        Part-id: Invoicemain
        Label: "Rate"
        Type: Number
        Width: 70
    Add: Field
        Field-id: JpPlMetalVal
        Part-id: Invoicemain
        Label: "Metal Val"
        Type: Number
        Width: 80
    Add: Field
        Field-id: JpPlMakeAmt
        Part-id: Invoicemain
        Label: "Making"
        Type: Number
        Width: 70
    Add: Field
        Field-id: JpPlStoneVal
        Part-id: Invoicemain
        Label: "Stone/Dia"
        Type: Number
        Width: 80
    Add: Field
        Field-id: JpPlTotal
        Part-id: Invoicemain
        Label: "Line Total"
        Type: Number
        Width: 90
        Font: Bold

    ; --- derived values, identical arithmetic to the sales module ---------
    Modify Group: JpPlCalcGroup
        Add: Field-id: JwlPlNet
            Set: Value: JpNetWeight($JwlPlGross, $JwlPlStone)
        Add: Field-id: JwlPlMetalVal
            Set: Value: JpMetalValue($JwlPlNet, $JwlPlRate)
        Add: Field-id: JwlPlWastageVal
            Set: Value: JpWastageValue($JwlPlMetalVal, $JwlPlWastagePc)
        Add: Field-id: JwlPlStoneVal
            Set: Value: JpStoneValue($JwlPlStone, $JwlPlStoneRate)
        Add: Field-id: JwlPlDiaVal
            Set: Value: JpDiamondValue($JwlPlCarat, $JwlPlDiaRate)
        Add: Field-id: JwlPlMakeAmt
            Set: Value: JpMakingCharge($JwlPlMakeType, $JwlPlNet, $JwlPlMetalVal, $JwlPlMakeAmtIn, $JwlPlRate)
        Add: Field-id: JwlPlTotal
            Set: Value: JpRound($JwlPlMetalVal + $JwlPlWastageVal + $JwlPlMakeAmt + $JwlPlStoneVal + $JwlPlDiaVal - $JwlPurDiscAmt)

    ; --- pull the item's jewellery facts once the item is chosen ---------
    Modify Group: JpPlFromItemGroup
        Add: Field-id: JwlPlBarcode
            Set: Value: JpItemFact($$InventoryItem, "JwlBarcode")
        Add: Field-id: JwlPlHuid
            Set: Value: JpItemFact($$InventoryItem, "JwlHuid")
        Add: Field-id: JwlPlPurity
            Set: Value: JpItemFact($$InventoryItem, "JwlPurity")
        Add: Field-id: JwlPlMetal
            Set: Value: JpItemFact($$InventoryItem, "JwlMetalType")
        Add: Field-id: JwlPlGross
            Set: Value: JpItemFact($$InventoryItem, "JwlGrossWt")
        Add: Field-id: JwlPlStone
            Set: Value: JpItemFact($$InventoryItem, "JwlStoneWt")
        Add: Field-id: JwlPlCarat
            Set: Value: JpItemFact($$InventoryItem, "JwlDiamondCarat")
        Add: Field-id: JwlPlWastagePc
            Set: Value: JpItemFact($$InventoryItem, "JwlWastagePc")
        Add: Field-id: JwlPlMakeType
            Set: Value: JpItemFact($$InventoryItem, "JwlMakingType")
        Add: Field-id: JwlPlStoneRate
            Set: Value: JpItemFact($$InventoryItem, "JwlStoneRate")
        Add: Field-id: JwlPlDiaRate
            Set: Value: JpItemFact($$InventoryItem, "JwlDiamondRate")
        Add: Field-id: JwlPlRate
            Set: Value: JpLineRate($$InventoryItem, $JwlPlMetal, $JwlPlPurity, $JwlPlRate)

    Modify Group: JpPurHdrCalcGroup
        Add: Field-id: JpPurMsg
            Set: Value: JpPurchaseValidationText()

; =============================================================================
;  SECTION E - PICK LIST, VALIDATION, SCREEN
; =============================================================================
[Collection: Source: JpPurKindPick]
    Data: JpPurKindPickRow

[Collection: Data: JpPurKindPickRow]
    Fetch: JpPurKindPickFetch
    Set: JpPurKindPickSet
    Repeat: Over: JpPurKindPickRow

[Collection: Data: JpPurKindPickFetch]
    Include: JpPurKindPickRow

[Collection: Data: JpPurKindPickSet]
    Not On: ##<Not>
    Set: $$Name: Value: JpPurchaseKindList()

[Function: JpPurchaseValidationText]
    Returns: String : Any
    Var: m : String
    m = ""
    If (JpBlankIfNull($JwlPurKind) = "") Then
    {
        JpPurchaseValidationText = "Purchase Kind is mandatory (Finished Jewellery / Gold / Silver / Diamond / Stone / Supplier / Karigar)."
        Exit
    }
    If (JpBlankIfNull($JwlSupInvNo) = "") Then
    {
        JpPurchaseValidationText = "Supplier invoice number is mandatory for GST input credit."
        Exit
    }
    If (JpHasRight(JpRtPurchase()) = 0) Then
    {
        JpPurchaseValidationText = JpDeniedMsg
        Exit
    }
    If ($JwlPurGstRate < 0) Then
    {
        JpPurchaseValidationText = "GST rate cannot be negative."
        Exit
    }
    JpPurchaseValidationText = ""

[Variable: JpPurchaseMsg : String]

[Screen: JpPurchaseScreen]
    Caption: "JadePro  ::  Jewellery Purchase"
    Key: <Ctrl+Q: System: Quit>

    Line: Spacing
    Lines: 1
    Text: "           JEWELLERY PURCHASE"
    Style: JpTitle
    Line Height: 1
    Text: "Purchase finished jewellery, loose metal, diamonds and stones, or jewellery received from a karigar."
    Style: JpSub
    Text: " "
    Style: JpMuted

    Line: Spacing
    Lines: 1
    Text: " BUYING RATES TODAY (per gram)"
    Style: JpSectionBox
    Lines: 1, 1
    Text: "   24K " + JpFmtAmt(JpCache24K) + "      22K " + JpFmtAmt(JpCache22K) + "      18K " + JpFmtAmt(JpCache18K) + "      14K " + JpFmtAmt(JpCache14K)
    Text: "   Silver " + JpFmtAmt(JpCacheSilver) + "      Platinum " + JpFmtAmt(JpCachePlatinum)

    Line: Spacing
    Lines: 1
    Text: " STOCK IN BY PIECES AND WEIGHT"
    Style: JpSectionBox
    Lines: 1, 1
    Text: "   Every line posts weight as the Tally inventory quantity for the item's UOM."
    Style: JpMuted
    Text: "   Set each jewellery item's UOM to 'GMS' so stock reports are in grams automatically."
    Style: JpMuted

    Line: Spacing
    Lines: 1, 1
    Field: <Field-Id: JpPurchaseMsg, Label: " ">
        Width: 100
        Style: JpWarn

    Line: Spacing
    Lines: 1
    Button: <Start Purchase Voucher (F2), Key: F2, Action: JpOpenPurchase>
    Button: <Karigar Receipt (F8), Key: F8, Action: JpOpenKarigar>
    Button: <Quit (Esc), Key: Esc, Action: System: Quit>

[Function: JpOpenPurchase]
    Returns: Integer : Any
    If (JpHasRight(JpRtPurchase()) = 0) Then
    {
        JpPurchaseMsg = JpDeniedMsg
        JpOpenPurchase = 0
        Exit
    }
    JpPurchaseMsg = ""
    Alter: Purchase
    JpOpenPurchase = 1

[Function: JpOpenKarigar]
    Returns: Integer : Any
    Alter: JpKarigarScreen
    JpOpenKarigar = 1

; -----------------------------------------------------------------------------
;; >>>>>>>>>>>>>>>>>>>>>>> BEGIN 06_OldGold.tdl <<<<<<<<<<<<<<<<<<<<<<
; =============================================================================
;  JadePro  ::  06_OldGold.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Old Gold / Gold Exchange module.
;            Captures metal received from a customer, computes the fine weight,
;            applies the shop's deduction, values it at the applicable purity
;            rate and makes that value adjustable against the new jewellery
;            purchase on the same invoice.
;
;  ARITHMETIC (exactly as specified)
;    Net Weight     = Gross Weight - Stone Weight
;    Fine Weight    = Net Weight x Purity Percentage
;    Exchange Value = Fine Weight x Applicable Gold Rate
;    Payout Value   = Exchange Value - Deduction % of Exchange Value
;
;  STORAGE : One JOURNAL per exchange, tagged JwlVchKind = "OldGold", posted
;            Dr Old Gold Metal (asset) / Cr Customer (liability). The liability
;            can then be settled either as cash or as an adjustment on a Sales
;            voucher via the JwlPayOldGold field added in 04_Sales.
;
;  LOAD    : After 00_Core, 03_GoldRate, 04_Sales.
;  REQUIRES : 00_Core.tdl, 03_GoldRate.tdl, 04_Sales.tdl
; =============================================================================

; =============================================================================
;  SECTION A - OLD GOLD UDFs
; =============================================================================
    ; Label: "Exchange Reference"
[System: UDF]
JwlOgVchNo : String : 20136
    ; Label: "Old Gold Customer"
[System: UDF]
JwlOgCustName : String : 20137
    ; Label: "Old Metal Type"
[System: UDF]
JwlOgMetal : String : 20138
    ; Label: "Old Purity"
[System: UDF]
JwlOgPurity : String : 20139
    ; Label: "Purity Percentage"
[System: UDF]
JwlOgPurityPc : Number : 20140
    ; Label: "Old Gross Weight"
[System: UDF]
JwlOgGrossWt : Quantity : 20141
    ; Label: "Old Stone Weight"
[System: UDF]
JwlOgStoneWt : Quantity : 20142
    ; Label: "Old Net Weight"
[System: UDF]
JwlOgNetWt : Quantity : 20143
    ; Label: "Old Fine Weight"
[System: UDF]
JwlOgFineWt : Quantity : 20144
    ; Label: "Applicable Gold Rate"
[System: UDF]
JwlOgRate : Number : 20145
    ; Label: "Old Gold Deduction %"
[System: UDF]
JwlOgDedPc : Number : 20146
    ; Label: "Old Gold Exchange Value"
[System: UDF]
JwlOgValue : Number : 20147
    ; Label: "Adjusted Against Invoice"
[System: UDF]
JwlOgAdjAmt : Number : 20148
    ; Label: "Balance Refundable"
[System: UDF]
JwlOgBalAmt : Number : 20149
    ; Label: "Old Gold Payout Mode"
[System: UDF]
JwlOgPayMode : String : 20150
    ; Label: "Old Gold Hallmark Stamp"
[System: UDF]
JwlOgHallmark : String : 20151
    ; Label: "Old Gold Note"
[System: UDF]
JwlOgNote : String : 20152
; =============================================================================
;  SECTION B - ARITHMETIC
; =============================================================================

; Purity percentage for the label, falling back to the standard table. A user
; who quotes an exact assay (916.5) gets exactly that, not the table value.
[Function: JpOgPurityPc]
    Param: vPurity : String : Optional, vQuoted : Number : Optional
    Returns: Number : Any
    Var: q : Number, f : Number
    q = Param(1)
    If (q is null) Then { q = 0; }
    If (q > 0) Then
    {
        JpOgPurityPc = q
        Exit
    }
    f = JpFineness(Param(0))
    If (f > 0) Then
    {
        JpOgPurityPc = JpRound(f * 100)
        Exit
    }
    JpOgPurityPc = 0

; Net weight of the old piece.
[Function: JpOgNet]
    Param: vGross : Quantity : Optional, vStone : Quantity : Optional
    Returns: Quantity : Any
    JpOgNet = JpNetWeight(Param(0), Param(1))

; Fine weight = Net Weight x Purity Percentage / 100
[Function: JpOgFine]
    Param: vNet : Quantity : Optional, vPurityPc : Number : Optional
    Returns: Quantity : Any
    Var: n : Quantity, p : Number
    n = Param(0)
    p = Param(1)
    If (n is null) Then { n = 0; }
    If (p is null) Then { p = 0; }
    If (p <= 0) Then { JpOgFine = 0; Exit; }
    If (p > 100) Then { p = 100; }
    JpOgFine = JpRoundWt(n * p / 100)

; Exchange value BEFORE deduction.
[Function: JpOgValue]
    Param: vFineWt : Quantity : Optional, vRate : Number : Optional
    Returns: Number : Any
    Var: f : Quantity, r : Number
    f = Param(0)
    r = Param(1)
    If (f is null) Then { f = 0; }
    If (r is null) Then { r = 0; }
    If (r <= 0) Then { JpOgValue = 0; Exit; }
    JpOgValue = JpRound(f * r)

; Payout after the shop's deduction.
[Function: JpOgPayout]
    Param: vValue : Number : Optional, vDedPc : Number : Optional
    Returns: Number : Any
    Var: v : Number, d : Number
    v = Param(0)
    d = Param(1)
    If (v is null) Then { v = 0; }
    If (d is null) Then { d = 0; }
    If (d < 0) Then { d = 0; }
    If (d > 100) Then { d = 100; }
    JpOgPayout = JpRound(v - (v * d / 100))

; Still refundable in cash after the customer applied part of it to the bill.
[Function: JpOgBalance]
    Param: vValue : Number : Optional, vAdjusted : Number : Optional
    Returns: Number : Any
    Var: v : Number, a : Number
    v = Param(0)
    a = Param(1)
    If (v is null) Then { v = 0; }
    If (a is null) Then { a = 0; }
    If (a > v) Then { a = v; }
    If (a < 0) Then { a = 0; }
    JpOgBalance = JpRound(v - a)

; =============================================================================
;  SECTION C - VALIDATION
; =============================================================================
[Function: JpOgValidationText]
    Returns: String : Any
    Var: m : String
    m = ""
    If (JpBlankIfNull($$JpOgCust) = "") Then
    {
        JpOgValidationText = "Customer is mandatory."
        Exit
    }
    If (JpBlankIfNull($$JpOgMetal) = "") Then
    {
        JpOgValidationText = "Metal Type is mandatory."
        Exit
    }
    If (JpPurityValid($$JpOgPurity) = 0) Then
    {
        JpOgValidationText = "Purity '" + JpBlankIfNull($$JpOgPurity) + "' is not valid."
        Exit
    }
    If ($$JpOgPurityPc <= 0) Then
    {
        JpOgValidationText = "Purity percentage is mandatory."
        Exit
    }
    If (JpWeightValid($$JpOgGross) = 0) Then
    {
        JpOgValidationText = "Gross Weight of the old piece is mandatory."
        Exit
    }
    If ($$JpOgRate <= 0) Then
    {
        JpOgValidationText = "No daily rate for " + JpBlankIfNull($$JpOgMetal) + " " + JpBlankIfNull($$JpOgPurity) + " today. Enter the daily rate master first."
        Exit
    }
    If ($$JpOgNet <= 0) Then
    {
        JpOgValidationText = "Stone weight is greater than or equal to gross weight."
        Exit
    }
    If ($$JpOgAdjusted > $$JpOgPayout) Then
    {
        JpOgValidationText = "Amount adjusted against the invoice is MORE than the exchange value."
        Exit
    }
    JpOgValidationText = ""

; =============================================================================
;  SECTION D - SCREEN
; =============================================================================
[Variable: JpOgCust        : String]
[Variable: JpOgMetal       : String]
[Variable: JpOgPurity      : String]
[Variable: JpOgPurityPc    : Number]
[Variable: JpOgGross       : Quantity]
[Variable: JpOgStone       : Quantity]
[Variable: JpOgNet         : Quantity]
[Variable: JpOgFine        : Quantity]
[Variable: JpOgRate        : Number]
[Variable: JpOgDedPc       : Number]
[Variable: JpOgGrossValue  : Number]
[Variable: JpOgValue       : Number]
[Variable: JpOgAdjusted    : Number]
[Variable: JpOgBalance     : Number]
[Variable: JpOgPayMode     : String]
[Variable: JpOgHallmark    : String]
[Variable: JpOgNote        : String]
[Variable: JpOgMsg         : String]

[Screen: JpOldGoldScreen]
    Caption: "JadePro  ::  Old Gold Exchange"
    Key: <Ctrl+Q: System: Quit>

    Line: Spacing
    Lines: 1
    Text: "           OLD GOLD  /  GOLD EXCHANGE"
    Style: JpTitle
    Line Height: 1
    Text: "Fine Weight = Net Weight x Purity %      Exchange Value = Fine Weight x Today's Rate for that purity"
    Style: JpSub
    Text: " "
    Style: JpMuted

    Line: Spacing
    Lines: 1, 1, 1, 1
    Field: <Field-Id: JpOgCust, Label: "Customer *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpOgHallmark, Label: "Hallmark Stamp / Old Tag No">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpOgMetal, Label: "Metal Type *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpMetalPick
    Field: <Field-Id: JpOgPurity, Label: "Purity *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpPurityPick
    Field: <Field-Id: JpOgPurityPc, Label: "Purity Percentage *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpOgDedPc, Label: "Deduction %">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Text: " WEIGHTS  AND  VALUATION"
    Style: JpSectionBox
    Lines: 1, 1, 1, 1, 1, 1
    Field: <Field-Id: JpOgGross, Label: "Gross Weight *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpOgStone, Label: "Stone Weight">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpOgNet, Label: "Net Weight">
        Width: 250
        Style: UseFormCtrl
        Color: #6B4E1E
    Field: <Field-Id: JpOgFine, Label: "Fine Weight">
        Width: 250
        Style: UseFormCtrl
        Color: #6B4E1E
    Field: <Field-Id: JpOgRate, Label: "Applicable Gold Rate *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpOgGrossValue, Label: "Value Before Deduction">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpOgValue, Label: "EXCHANGE VALUE (after deduction)">
        Width: 250
        Style: UseFormCtrl
        Color: #A06000
        Font: Bold

    Line: Spacing
    Lines: 1
    Text: " SETTLEMENT"
    Style: JpSectionBox
    Lines: 1, 1, 1
    Field: <Field-Id: JpOgAdjusted, Label: "Adjusted Against New Purchase">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpOgBalance, Label: "Balance Refundable">
        Width: 250
        Style: UseFormCtrl
        Color: #A06000
        Font: Bold
    Field: <Field-Id: JpOgPayMode, Label: "Payout Mode">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpPayModePick
    Field: <Field-Id: JpOgNote, Label: "Note">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1, 1
    Field: <Field-Id: JpOgMsg, Label: " ">
        Width: 100
        Style: JpWarn
    Text: "The exchange voucher can be printed on the sales invoice by entering its reference in JwlOldGoldRef on the Sales voucher."
    Style: JpMuted

    Line: Spacing
    Lines: 1
    Button: <Recalculate (F7), Key: F7, Action: JpOgCalc>
    Button: <Fetch Today's Rate (F8), Key: F8, Action: JpOgFetchRate>
    Button: <Save Exchange (F2), Key: F2, Action: JpOgSave>
    Button: <Quit (Esc), Key: Esc, Action: System: Quit>

; =============================================================================
;  SECTION E - ACTIONS
; =============================================================================

[Function: JpOgCalc]
    Returns: Integer : Any
    Var: pc : Number, ded : Number
    pc = JpOgPurityPc($$JpOgPurity, $$JpOgPurityPc)
    If (pc > 0) Then
    {
        $$JpOgPurityPc = pc
    }
    $$JpOgNet = JpOgNet($$JpOgGross, $$JpOgStone)
    $$JpOgFine = JpOgFine($$JpOgNet, $$JpOgPurityPc)
    ded = $$JpOgDedPc
    If (ded = 0) Then
    {
        ded = ##JwlOldGoldDedPc
        If (ded > 0) Then
        {
            $$JpOgDedPc = ded
        }
    }
    ; The pre-deduction value is recomputed from scratch every time, so
    ; pressing Recalculate repeatedly can never compound the deduction.
    $$JpOgGrossValue = JpOgValue($$JpOgFine, $$JpOgRate)
    $$JpOgValue = JpOgPayout($$JpOgGrossValue, $$JpOgDedPc)
    $$JpOgBalance = JpOgBalance($$JpOgValue, $$JpOgAdjusted)
    JpOgMsg = JpOgValidationText()
    JpOgCalc = 1

[Function: JpOgFetchRate]
    Returns: Integer : Any
    $$JpOgRate = JpOldGoldRate($$JpOgMetal, $$JpOgPurity)
    If ($$JpOgRate <= 0) Then
    {
        JpOgMsg = "No rate found for " + JpBlankIfNull($$JpOgMetal) + " " + JpBlankIfNull($$JpOgPurity) + " today."
        JpOgFetchRate = 0
        Exit
    }
    JpOgCalc
    JpOgFetchRate = 1

[Function: JpOgSave]
    Returns: Integer : Any
    JpOgCalc
    If (JpOgValidationText() <> "") Then
    {
        JpOgSave = 0
        Exit
    }
    Create: Journal
    Modify Group: JpOgSaveGroup
        Add: Field-id: JwlVchKind
            Set: Value: "OldGold"
        Add: Field-id: JwlOgVchNo
            Set: Value: JpOgRefNo()
        Add: Field-id: JwlOgCustName
            Set: Value: $$JpOgCust
        Add: Field-id: JwlOgMetal
            Set: Value: $$JpOgMetal
        Add: Field-id: JwlOgPurity
            Set: Value: $$JpOgPurity
        Add: Field-id: JwlOgPurityPc
            Set: Value: $$JpOgPurityPc
        Add: Field-id: JwlOgGrossWt
            Set: Value: $$JpOgGross
        Add: Field-id: JwlOgStoneWt
            Set: Value: $$JpOgStone
        Add: Field-id: JwlOgNetWt
            Set: Value: $$JpOgNet
        Add: Field-id: JwlOgFineWt
            Set: Value: $$JpOgFine
        Add: Field-id: JwlOgRate
            Set: Value: $$JpOgRate
        Add: Field-id: JwlOgDedPc
            Set: Value: $$JpOgDedPc
        Add: Field-id: JwlOgValue
            Set: Value: $$JpOgValue
        Add: Field-id: JwlOgAdjAmt
            Set: Value: $$JpOgAdjusted
        Add: Field-id: JwlOgBalAmt
            Set: Value: $$JpOgBalance
        Add: Field-id: JwlOgPayMode
            Set: Value: JpBlankIfNull($$JpOgPayMode)
        Add: Field-id: JwlOgHallmark
            Set: Value: JpBlankIfNull($$JpOgHallmark)
        Add: Field-id: JwlOgNote
            Set: Value: JpBlankIfNull($$JpOgNote)
    Accept: JpOgSaved
    JpOgSave = 1

[Function: JpOgSaved]
    Returns: Integer : Any
    JpOgMsg = "Old gold exchange saved. Reference " + ##JwlOgVchNo + ". Enter this in JwlOldGoldRef on the sales invoice to print it on the same bill."
    JpOgSaved = 1

[Function: JpOgRefNo]
    Returns: String : Any
    JpOgRefNo = "OG-" + JpBlankIfNull(JpCacheDate)
; -----------------------------------------------------------------------------
;; >>>>>>>>>>>>>>>>>>>>>>> BEGIN 07_Karigar.tdl <<<<<<<<<<<<<<<<<<<<<<
; =============================================================================
;  JadePro  ::  07_Karigar.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Karigar / Job-Work management.
;            Gold issued to a karigar, jewellery received back, wastage,
;            labour charges and the metal still lying with each karigar.
;
;  BALANCE MODEL
;    Balance with karigar = Metal Issued - (Net Weight Received + Wastage Given)
;    Labour charges are posted to the karigar ledger as a payable.
;
;  LOAD    : After 00_Core, 03_GoldRate, 04_Sales.
;  REQUIRES : 00_Core.tdl, 03_GoldRate.tdl, 04_Sales.tdl
; =============================================================================

; =============================================================================
;  SECTION A - KARIGAR LEDGER UDFs
; =============================================================================
    ; Label: "Is Karigar"
[System: UDF]
JwlIsKarigar : Logical : 20153
    ; Label: "Karigar Speciality"
[System: UDF]
JwlKarigarSpeciality : String : 20154
    ; Label: "Karigar City"
[System: UDF]
JwlKarigarCity : String : 20155
    ; Label: "Karigar PAN"
[System: UDF]
JwlKarigarPan : String : 20156
    ; Label: "Metal Balance With Karigar"
[System: UDF]
JwlKarigarOpenWt : Quantity : 20157
    ; Label: "Payable To Karigar"
[System: UDF]
JwlKarigarOpenAmt : Number : 20158
; =============================================================================
;  SECTION B - JOB WORK VOUCHER UDFs
; =============================================================================
    ; Label: "Job Work Reference"
[System: UDF]
JwlJobNo : String : 20159
    ; Label: "Karigar"
[System: UDF]
JwlJobKarigar : String : 20160
    ; Label: "Job Type"
[System: UDF]
JwlJobType : String : 20161
    ; Label: "Job Description"
[System: UDF]
JwlJobDesc : String : 20162
    ; Label: "Job Design Number"
[System: UDF]
JwlJobDesign : String : 20163
    ; Label: "Date Issued"
[System: UDF]
JwlJobIssuedDate : Date : 20164
    ; Label: "Weight Issued"
[System: UDF]
JwlJobIssuedWt : Quantity : 20165
    ; Label: "Issued Purity"
[System: UDF]
JwlJobIssuedPure : String : 20166
    ; Label: "Issue Rate"
[System: UDF]
JwlJobIssuedRate : Number : 20167
    ; Label: "Date Received"
[System: UDF]
JwlJobRecvDate : Date : 20168
    ; Label: "Gross Weight Received"
[System: UDF]
JwlJobRecvGross : Quantity : 20169
    ; Label: "Net Weight Received"
[System: UDF]
JwlJobRecvNet : Quantity : 20170
    ; Label: "Wastage Given %"
[System: UDF]
JwlJobWastagePc : Number : 20171
    ; Label: "Wastage Weight"
[System: UDF]
JwlJobWastageWt : Quantity : 20172
    ; Label: "Labour Charges"
[System: UDF]
JwlJobLabour : Number : 20173
    ; Label: "Balance Metal With Karigar"
[System: UDF]
JwlJobBalWt : Quantity : 20174
    ; Label: "Job Status"
[System: UDF]
JwlJobStatus : String : 20175
[Function: JpJobStatusList]
    Returns: String : Any
    JpJobStatusList = "Issued##Part Received##In Progress##Received##Closed"

; =============================================================================
;  SECTION C - KARIGAR BLOCK ON THE LEDGER MASTER
; =============================================================================
Alter: Ledger
    Add: Field
        Field-id: JpKarigarChk
        Label: "Is Karigar"
        Type: Logical
        Value: ##JwlIsKarigar
        Width: 140
        Style: UseFormCtrl

    Add: Field
        Field-id: JpKarigarBlock
        Part-id: JpKarigarPart
        Width: 100
        Invisible: ##JwlIsKarigar <> 1

    ; The Customer CRM block (Part defined in 11_Reports.tdl) is attached to
    ; the SAME Alter: Ledger section - TDL allows only one section per name.
    Add: Field
        Field-id: JpCrmBlock
        Part-id: JpCrmPart
        Width: 100
        Invisible: ##JwlPartyState = ""

[Part: JpKarigarPart]
    Line: Spacing, JpKarigarPartLine1, JpKarigarPartLine2, JpKarigarPartLine3, JpKarigarPartLine4, JpKarigarPartLine5, JpKarigarPartLine6

[Line: JpKarigarPartLine1]
    Height : 1
    Field: JpKarigarPartLine1F1

[Field: JpKarigarPartLine1F1]
    Set As : " KARIGAR DETAILS"
    Style : JpSectionBox
[Line: JpKarigarPartLine2]
    Field: JpKarigarPartLine2F1

[Field: JpKarigarPartLine2F1]
    Storage : JwlKarigarSpeciality
    Label : "Speciality"
    Width : 200
[Line: JpKarigarPartLine3]
    Field: JpKarigarPartLine3F1

[Field: JpKarigarPartLine3F1]
    Storage : JwlKarigarCity
    Label : "City"
    Width : 200
[Line: JpKarigarPartLine4]
    Field: JpKarigarPartLine4F1

[Field: JpKarigarPartLine4F1]
    Storage : JwlKarigarPan
    Label : "PAN"
    Width : 200
[Line: JpKarigarPartLine5]
    Field: JpKarigarPartLine5F1

[Field: JpKarigarPartLine5F1]
    Storage : JwlKarigarOpenWt
    Label : "Metal Balance (gm)"
    Style : JpFontBold
    Width : 200
    Color : #A06000
[Line: JpKarigarPartLine6]
    Field: JpKarigarPartLine6F1

[Field: JpKarigarPartLine6F1]
    Storage : JwlKarigarOpenAmt
    Label : "Payable To Karigar"
    Style : JpFontBold
    Width : 200
    Color : #A06000
[Function: JpJobWastageWt]
    Param: vIssuedWt : Quantity : Optional, vRecvNet : Quantity : Optional, vWastPc : Number : Optional
    Returns: Quantity : Any
    Var: i : Quantity, r : Quantity, p : Number
    i = Param(0)
    r = Param(1)
    p = Param(2)
    If (i is null) Then { i = 0; }
    If (r is null) Then { r = 0; }
    If (p is null) Then { p = 0; }
    If (p <= 0) Then
    {
        ; No stated percentage: whatever is missing is the wastage given.
        If (i > r) Then
        {
            JpJobWastageWt = JpRoundWt(i - r)
            Exit
        }
        JpJobWastageWt = 0
        Exit
    }
    If (r <= 0) Then
    {
        JpJobWastageWt = 0
        Exit
    }
    JpJobWastageWt = JpRoundWt(r * p / 100)

; Metal still with the karigar = issued - received - wastage given.
[Function: JpJobBalance]
    Param: vIssuedWt : Quantity : Optional, vRecvNet : Quantity : Optional, vWastPc : Number : Optional
    Returns: Quantity : Any
    Var: i : Quantity, r : Quantity, p : Quantity
    i = Param(0)
    r = Param(1)
    p = JpJobWastageWt(Param(0), Param(1), Param(2))
    If (i is null) Then { i = 0; }
    If (r is null) Then { r = 0; }
    JpJobBalance = JpRoundWt(i - r - p)

[Function: JpJobLabourPerGm]
    Param: vLabour : Number : Optional, vRecvNet : Quantity : Optional
    Returns: Number : Any
    JpJobLabourPerGm = JpAmtPerGram(Param(0), Param(1))

; =============================================================================
;  SECTION E - SCREEN
; =============================================================================
[Variable: JpJobMode       : String]
[Variable: JpJobRef        : String]
[Variable: JpJobKarigarNm  : String]
[Variable: JpJobDesignNm   : String]
[Variable: JpJobDescTxt    : String]
[Variable: JpJobPurity     : String]
[Variable: JpJobIssued     : Quantity]
[Variable: JpJobIssuedDt   : Date]
[Variable: JpJobRecvGross  : Quantity]
[Variable: JpJobRecvStone  : Quantity]
[Variable: JpJobRecvNet    : Quantity]
[Variable: JpJobWastPc     : Number]
[Variable: JpJobWastWt     : Quantity]
[Variable: JpJobLabourAmt  : Number]
[Variable: JpJobBalanceWt  : Quantity]
[Variable: JpJobBalAmt     : Number]
[Variable: JpJobStatusTxt  : String]
[Variable: JpJobMsg        : String]

[Screen: JpKarigarScreen]
    Caption: "JadePro  ::  Karigar Job Work"
    Key: <Ctrl+Q: System: Quit>

    Line: Spacing
    Lines: 1
    Text: "           KARIGAR  /  JOB WORK"
    Style: JpTitle
    Line Height: 1
    Text: "Balance = Metal Issued - (Net Received + Wastage Given)      Labour is payable to the karigar."
    Style: JpSub
    Text: " "
    Style: JpMuted

    Line: Spacing
    Lines: 1
    Text: " JOB DETAILS"
    Style: JpSectionBox
    Lines: 1, 1, 1, 1, 1, 1
    Field: <Field-Id: JpJobMode, Label: "Job Type *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpJobModePick
    Field: <Field-Id: JpJobRef, Label: "Job Reference *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobKarigarNm, Label: "Karigar *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobDesignNm, Label: "Design Number">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobPurity, Label: "Purity">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpPurityPick
    Field: <Field-Id: JpJobDescTxt, Label: "Job Description">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Text: " METAL ISSUED"
    Style: JpSectionBox
    Lines: 1, 1, 1
    Field: <Field-Id: JpJobIssuedDt, Label: "Date Issued">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobIssued, Label: "Weight Issued (gm)">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobStatusTxt, Label: "Job Status">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpJobStatusPick

    Line: Spacing
    Lines: 1
    Text: " JEWELLERY RECEIVED BACK"
    Style: JpSectionBox
    Lines: 1, 1, 1, 1, 1, 1, 1
    Field: <Field-Id: JpJobRecvGross, Label: "Gross Received">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobRecvStone, Label: "Stone Weight">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobRecvNet, Label: "Net Received">
        Width: 250
        Style: UseFormCtrl
        Color: #6B4E1E
    Field: <Field-Id: JpJobWastPc, Label: "Wastage %">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobWastWt, Label: "Wastage Weight">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpJobLabourAmt, Label: "Labour Charges">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
