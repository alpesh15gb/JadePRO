; =============================================================================
;  REPORT 12 - STOCK AGEING (bucketed by last purchase date)
; =============================================================================
[Collection: Report: JpAgeingReport]
    Source: JpAgeingSQL
    Title: <1000,###,#a##"  STOCK AGEING - FAST, SLOW AND DEAD STOCK">
    Print: JpAgeingPrint
    Export: JpAgeingExport
    Key: JpAgeingKey
    Filters: <JpFromDate, <Date, "As From Date">>, <JpToDate, <Date, "As To Date">>

[Variable: JpAgeingSQL : String]
    Type: String
    Value: "SELECT $$ITEMNAME$$ AS JwlItem, $JwlCategory$$ AS JwlCat, SUM($$QUANTITY$$) AS JwlQty, SUM($JwlNetMetalWt$$ * $$QUANTITY$$) AS JwlNetWt, MAX($$DATE$$) AS JwlLastBuy, SUM($JwlFinalValue$$ * $$QUANTITY$$) AS JwlStockVal FROM $$LINEITEMS$$ WHERE $$VOUCHERTYPE$$ = 'Purchase' AND $$DATE$$ <= $$JpToDate$$ GROUP BY $$ITEMNAME$$,$JwlCategory$$ ORDER BY $$JwlLastBuy$$"

[Variable: JpAgeingKey : String]
    Type: String
    Value: "JwlItem"

; Ageing buckets, in days, as DATA so a shop can retune them on the company
; master rather than by editing this report.
[Function: JpAgeBucket]
    Param: vLastBuy : Date : Optional
    Returns: String : Any
    Var: JpFromDate, JpToDate, d : Date, days : Number
    d = Param(0)
    If (d is null) Then
    {
        JpAgeBucket = "Unknown"
        Exit
    }
    days = Days(Day(d), Month(d), Year(d), Day(JpCacheDate), Month(JpCacheDate), Year(JpCacheDate))
    If (days < 0) Then { JpAgeBucket = "Unknown"; Exit; }
    If (days <= 30) Then { JpAgeBucket = "0-30 days  (Fast)"; Exit; }
    If (days <= 90) Then { JpAgeBucket = "31-90 days  (Moving)"; Exit; }
    If (days <= 180) Then { JpAgeBucket = "91-180 days  (Slow)"; Exit; }
    JpAgeBucket = "180+ days  (DEAD)"


