[Function: JpPurPrint]
    Param: vPurity : String : Optional
    Returns: String : Any
    JpPurPrint = String(JpPurityPercent(Param(0)), "0.00")

[Function: JpFineTotal]
    Returns: Quantity : Any
    JpFineTotal = Sum($$JwlNetWt) * JpFineness($$JwlPur)

[Export: JpPurityStockExport]
