[Report: JpRepairRegisterExport]
    Title : <1000, "Repair Register">
    Repeat: Over: JpRepairRegister
    Plain XML : Yes
    Export Header : Yes
    Form : JpRepairRegisterExportForm

[Form: JpRepairRegisterExportForm]
    Parts : JpRepairRegisterExportPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Export:] is not a Tally definition type. Bulk output is a Report
    ; declared Plain XML, with XMLTag on the Part and XMLAttr on the Fields.
    ; "Export Title: Detail" (30 sites) was dropped - Report has Export Header,
    ; and detail-vs-header is not a Part-level concept.
[Part: JpRepairRegisterExportPart]
    XMLTag : "Row"
    Lines : JpRepairRegisterExportLine

[Line: JpRepairRegisterExportLine]
    Field : JpRepairRegisterExportF1
    Field : JpRepairRegisterExportF2
    Field : JpRepairRegisterExportF3
    Field : JpRepairRegisterExportF4
    Field : JpRepairRegisterExportF5
    Field : JpRepairRegisterExportF6
    Field : JpRepairRegisterExportF7
    Field : JpRepairRegisterExportF8
    Field : JpRepairRegisterExportF9
    Field : JpRepairRegisterExportF10

    ; "Export: Value:" had no TDL equivalent. Each became a Field
    ; setting the same payload verbatim; the tag name is derived from it.

[Field: JpRepairRegisterExportF1]
    Set As : $JwlRepNo
    XMLAttr : "JwlRepNo"

[Field: JpRepairRegisterExportF2]
    Set As : $JwlRepCust
    XMLAttr : "JwlRepCust"

[Field: JpRepairRegisterExportF3]
    Set As : $JwlRepDesc
    XMLAttr : "JwlRepDesc"

[Field: JpRepairRegisterExportF4]
    Set As : $JwlRepGrossWt
    XMLAttr : "JwlRepGrossWt"

[Field: JpRepairRegisterExportF5]
    Set As : $JwlRepNetWt
    XMLAttr : "JwlRepNetWt"

[Field: JpRepairRegisterExportF6]
    Set As : $JwlRepEstAmt
    XMLAttr : "JwlRepEstAmt"

[Field: JpRepairRegisterExportF7]
    Set As : $JwlRepAdvance
    XMLAttr : "JwlRepAdvance"

[Field: JpRepairRegisterExportF8]
    Set As : $JwlRepBalance
    XMLAttr : "JwlRepBalance"

[Field: JpRepairRegisterExportF9]
    Set As : $JwlRepDelivDate
    XMLAttr : "JwlRepDelivDate"

[Field: JpRepairRegisterExportF10]
    Set As : $JwlRepStatus
    XMLAttr : "JwlRepStatus"
