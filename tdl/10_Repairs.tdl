; =============================================================================
;  JadePro  ::  10_Repairs.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Jewellery Repair management.
;            Received -> Sent to Karigar -> Repairing -> Ready -> Delivered
;
;  WEIGHT DISCIPLINE
;    A repair does NOT change stock. The gross weight is captured only so that
;    the karigar's metal accountability is complete, and the repair voucher is
;    a journal tagged JwlVchKind = "Repair" - never a Sales or Purchase, so
;    Tally's inventory is untouched.
;
;  LOAD    : After 00_Core, 04_Sales.
;  REQUIRES : 00_Core.tdl, 04_Sales.tdl
; =============================================================================

; =============================================================================
;  SECTION A - REPAIR UDFs
; =============================================================================
    ; Label: "Repair Number"
[System: UDF]
JwlRepNo : String : 20191
    ; Label: "Repair Customer"
[System: UDF]
JwlRepCust : String : 20192
    ; Label: "Customer Contact"
[System: UDF]
JwlRepContact : String : 20193
    ; Label: "Jewellery Description"
[System: UDF]
JwlRepDesc : String : 20194
    ; Label: "Metal Type"
[System: UDF]
JwlRepMetal : String : 20195
    ; Label: "Purity"
[System: UDF]
JwlRepPurity : String : 20196
    ; Label: "Gross Weight"
[System: UDF]
JwlRepGrossWt : Quantity : 20197
    ; Label: "Stone Weight"
[System: UDF]
JwlRepStoneWt : Quantity : 20198
    ; Label: "Net Weight"
[System: UDF]
JwlRepNetWt : Quantity : 20199
    ; Label: "Stone Details"
[System: UDF]
JwlRepStoneDetail : String : 20200
    ; Label: "Repair Work Required"
[System: UDF]
JwlRepWork : String : 20201
    ; Label: "Sent To Karigar"
[System: UDF]
JwlRepKarigar : String : 20202
    ; Label: "Estimated Amount"
[System: UDF]
JwlRepEstAmt : Number : 20203
    ; Label: "Advance Taken"
[System: UDF]
JwlRepAdvance : Number : 20204
    ; Label: "Balance Payable"
[System: UDF]
JwlRepBalance : Number : 20205
    ; Label: "Expected Delivery"
[System: UDF]
JwlRepDelivDate : Date : 20206
    ; Label: "Repair Status"
[System: UDF]
JwlRepStatus : String : 20207
    ; Label: "Received Date"
[System: UDF]
JwlRepRecvDate : Date : 20208
; =============================================================================
;  SECTION B - ARITHMETIC AND LIFECYCLE
; =============================================================================
[Function: JpRepNet]
    Param: vGross : Quantity : Optional, vStone : Quantity : Optional
    Returns: Quantity : Any
    JpRepNet = JpNetWeight(Param(0), Param(1))

[Function: JpRepBalanceDue]
    Param: vEstimated : Number : Optional, vAdvance : Number : Optional
    Returns: Number : Any
    Var: e : Number, a : Number
    e = JpNz(Param(0))
    a = JpNz(Param(1))
    If (a > e) Then
    {
        JpRepBalanceDue = 0
        Exit
    }
    JpRepBalanceDue = JpRound(e - a)

[Function: JpRepCanAdvance]
    Param: vFrom : String : Optional, vTo : String : Optional
    Returns: Integer : Any
    Var: a : String, b : String
    a = JpBlankIfNull(Param(0))
    b = JpBlankIfNull(Param(1))
    If (a = "Received") Then { If (b = "Sent to Karigar") Then { JpRepCanAdvance = 1; Exit; } }
    If (a = "Sent to Karigar") Then { If (b = "Repairing") Then { JpRepCanAdvance = 1; Exit; } }
    If (a = "Sent to Karigar") Then { If (b = "Ready") Then { JpRepCanAdvance = 1; Exit; } }
    If (a = "Repairing") Then { If (b = "Ready") Then { JpRepCanAdvance = 1; Exit; } }
    If (a = "Ready") Then { If (b = "Delivered") Then { JpRepCanAdvance = 1; Exit; } }
    If (a = "Delivered") Then { If (b = "Delivered") Then { JpRepCanAdvance = 1; Exit; } }
    JpRepCanAdvance = 0

[Function: JpRepNextStatus]
    Param: vFrom : String : Optional
    Returns: String : Any
    Var: a : String
    a = JpBlankIfNull(Param(0))
    If (a = "Received") Then { JpRepNextStatus = "Sent to Karigar"; Exit; }
    If (a = "Sent to Karigar") Then { JpRepNextStatus = "Repairing"; Exit; }
    If (a = "Repairing") Then { JpRepNextStatus = "Ready"; Exit; }
    If (a = "Ready") Then { JpRepNextStatus = "Delivered"; Exit; }
    If (a = "Delivered") Then { JpRepNextStatus = "Delivered"; Exit; }
    JpRepNextStatus = a

[Function: JpRepOverdue]
    Param: vDelivDate : Date : Optional, vStatus : String : Optional
    Returns: Integer : Any
    If (JpRepairOpen(Param(1)) = 0) Then
    {
        JpRepOverdue = 0
        Exit
    }
    If (Param(0) is null) Then
    {
        JpRepOverdue = 0
        Exit
    }
    If (Param(0) < JpCacheDate) Then
    {
        JpRepOverdue = 1
        Exit
    }
    JpRepOverdue = 0

[Function: JpRepValidationText]
    Returns: String : Any
    If (JpBlankIfNull($$JpRepNo) = "") Then
    {
        JpRepValidationText = "Repair Number is mandatory."
        Exit
    }
    If (JpBlankIfNull($$JpRepCust) = "") Then
    {
        JpRepValidationText = "Customer is mandatory."
        Exit
    }
    If (JpBlankIfNull($$JpRepDesc) = "") Then
    {
        JpRepValidationText = "Jewellery Description is mandatory - the counter staff must be able to identify the piece."
        Exit
    }
    If (JpBlankIfNull($$JpRepWork) = "") Then
    {
        JpRepValidationText = "Repair Work is mandatory."
        Exit
    }
    If (JpPurityValid($$JpRepPurity) = 0) Then
    {
        JpRepValidationText = "Purity '" + JpBlankIfNull($$JpRepPurity) + "' is not valid."
        Exit
    }
    If (JpWeightValid($$JpRepGrossWt) = 0) Then
    {
        JpRepValidationText = "Gross Weight of the piece is mandatory."
        Exit
    }
    If ($$JpRepNet <= 0) Then
    {
        JpRepValidationText = "Stone weight is greater than or equal to gross weight."
        Exit
    }
    If ($$JpRepEstAmt < 0) Then
    {
        JpRepValidationText = "Estimated amount cannot be negative."
        Exit
    }
    If ($$JpRepAdvance < 0) Then
    {
        JpRepValidationText = "Advance cannot be negative."
        Exit
    }
    If ($$JpRepAdvance > $$JpRepEstAmt) Then
    {
        JpRepValidationText = "Advance is MORE than the estimated amount."
        Exit
    }
    If ($$JpRepDelivDate is null) Then
    {
        JpRepValidationText = "Expected delivery date is mandatory."
        Exit
    }
    If (JpBlankIfNull($$JpRepStatus) = "") Then
    {
        JpRepValidationText = "Repair Status is mandatory."
        Exit
    }
    If ($$JpRepStatus = "Delivered") Then
    {
        If ($$JpRepBalance > 0.01) Then
        {
            JpRepValidationText = "Cannot deliver with a balance of " + JpFmtAmt($$JpRepBalance) + " still outstanding."
            Exit
        }
    }
    JpRepValidationText = ""

; =============================================================================
;  SECTION C - REPAIR SCREEN
; =============================================================================
[Variable: JpRepNo        : String]
[Variable: JpRepCustNm    : String]
[Variable: JpRepContactNm : String]
[Variable: JpRepDescTx    : String]
[Variable: JpRepMetal     : String]
[Variable: JpRepPurity    : String]
[Variable: JpRepGrossWt   : Quantity]
[Variable: JpRepStoneWt   : Quantity]
[Variable: JpRepNetWt     : Quantity]
[Variable: JpRepStoneDet  : String]
[Variable: JpRepWorkTx    : String]
[Variable: JpRepKarigarNm : String]
[Variable: JpRepEstAmt    : Number]
[Variable: JpRepAdvance   : Number]
[Variable: JpRepBalance   : Number]
[Variable: JpRepDelivDt   : Date]
[Variable: JpRepStatusTx  : String]
[Variable: JpRepMsg       : String]

[Report: JpRepairScreen]
    Title : "JadePro  ::  Jewellery Repair"
    Form : JpRepairScreenForm

[Form: JpRepairScreenForm]
    Parts : JpRepairScreenPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Screen:] is not a Tally definition type. The body below was already
    ; Part grammar, so it became a Part behind a Report + Form.
[Part: JpRepairScreenPart]
    ; Caption moved to the Report's Title by fix-screen-export-types.mjs
    ; Key dropped by fix-screen-export-types.mjs - Part has no Key;
    ; this was a menu-level shortcut, not a layout attribute.

    Line: Spacing
    Lines: 1
    Field : JpRepairScreenT1
    ; Line Height dropped by fix-screen-export-types.mjs - Part: Height
    ; means the height of the whole Part, not of each Line.
    Field : JpRepairScreenT2
    Field : JpRepairScreenT3

    Line: Spacing
    Lines: 1
    Field : JpRepairScreenT4
    Lines: 1, 1, 1, 1, 1, 1
    Field: <Field-Id: JpRepNo, Label: "Repair Number *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepCustNm, Label: "Customer *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepContactNm, Label: "Contact Number">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepDescTx, Label: "Jewellery Description *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepMetal, Label: "Metal Type">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpMetalPick
    Field: <Field-Id: JpRepPurity, Label: "Purity *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpPurityPick

    Line: Spacing
    Lines: 1
    Field : JpRepairScreenT5
    Lines: 1, 1, 1, 1, 1, 1
    Field: <Field-Id: JpRepGrossWt, Label: "Gross Weight *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepStoneWt, Label: "Stone Weight">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepNetWt, Label: "Net Weight">
        Width: 250
        Style: UseFormCtrl
        Color: #6B4E1E
    Field: <Field-Id: JpRepStoneDet, Label: "Stone Details">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Field : JpRepairScreenT6
    Lines: 1, 1, 1, 1, 1, 1
    Field: <Field-Id: JpRepWorkTx, Label: "Repair Work *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepKarigarNm, Label: "Sent To Karigar">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepEstAmt, Label: "Estimated Amount *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepAdvance, Label: "Advance">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpRepBalance, Label: "Balance Payable">
        Width: 250
        Style: UseFormCtrl
        Color: #A06000
        Font: Bold
    Field: <Field-Id: JpRepDelivDt, Label: "Expected Delivery *">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Field : JpRepairScreenT7
    Lines: 1, 1
    Field: <Field-Id: JpRepStatusTx, Label: "Repair Status *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpRepStatusPick
    Field: <Field-Id: JpRepMsg, Label: " ">
        Width: 250
        Style: JpWarn

    Line: Spacing
    Lines: 1
    Button: <Recalculate (F7), Key: F7, Action: JpRepCalc>
    Button: <Advance Status (F8), Key: F8, Action: JpRepNextStatusAction>
    Button: <Save Repair (F2), Key: F2, Action: JpRepSave>
    Button: <Repair Register (F4), Key: F4, Action: JpRepRegister>
    Button: <Quit (Esc), Key: Esc, Action: System: Quit>


    ; Text: lines become Fields - Part has no Text attribute.

[Field: JpRepairScreenT1]
    Set As : "           JEWELLERY REPAIR"
    Style : JpTitle

[Field: JpRepairScreenT2]
    Set As : "Received  ->  Sent to Karigar  ->  Repairing  ->  Ready  ->  Delivered"
    Style : JpMuted

[Field: JpRepairScreenT3]
    Set As : "Repairs never change stock - only the karigar's metal accountability is affected."
    Style : JpMuted

[Field: JpRepairScreenT4]
    Set As : " CUSTOMER  AND  PIECE"
    Style : JpSectionBox

[Field: JpRepairScreenT5]
    Set As : " WEIGHTS  AND  STONES"
    Style : JpSectionBox

[Field: JpRepairScreenT6]
    Set As : " WORK  AND  MONEY"
    Style : JpSectionBox

[Field: JpRepairScreenT7]
    Set As : " STATUS"
    Style : JpSectionBox

[Collection: Source: JpRepStatusPick]
    Data: JpRepStatusPickRow

[Collection: Data: JpRepStatusPickRow]
    Fetch: JpRepStatusPickFetch
    Set: JpRepStatusPickSet
    Repeat: Over: JpRepStatusPickRow

[Collection: Data: JpRepStatusPickFetch]
    Include: JpRepStatusPickRow

[Collection: Data: JpRepStatusPickSet]
    Not On: ##<Not>
    Set: $$Name: Value: JpRepairStatusList()

; =============================================================================
;  SECTION D - ACTIONS
; =============================================================================
[Function: JpRepCalc]
    Returns: Integer : Any
    $$JpRepNetWt = JpRepNet($$JpRepGrossWt, $$JpRepStoneWt)
    $$JpRepBalance = JpRepBalanceDue($$JpRepEstAmt, $$JpRepAdvance)
    JpRepMsg = JpRepValidationText()
    JpRepCalc = 1

[Function: JpRepNextStatusAction]
    Returns: Integer : Any
    Var: nxt : String
    nxt = JpRepNextStatus($$JpRepStatusTx)
    If (JpRepCanAdvance($$JpRepStatusTx, nxt) = 0) Then
    {
        JpRepMsg = "Cannot move from '" + JpBlankIfNull($$JpRepStatusTx) + "' to '" + nxt + "'."
        JpRepNextStatusAction = 0
        Exit
    }
    $$JpRepStatusTx = nxt
    JpRepCalc
    JpRepNextStatusAction = 1

[Function: JpRepSave]
    Returns: Integer : Any
    JpRepCalc
    If (JpRepValidationText() <> "") Then
    {
        JpRepSave = 0
        Exit
    }
    Create: Journal
    Modify Group: JpRepSaveGroup
        Add: Field-id: JwlVchKind
            Set: Value: "Repair"
        Add: Field-id: JwlRepNo
            Set: Value: $$JpRepNo
        Add: Field-id: JwlRepCust
            Set: Value: $$JpRepCustNm
        Add: Field-id: JwlRepContact
            Set: Value: JpBlankIfNull($$JpRepContactNm)
        Add: Field-id: JwlRepDesc
            Set: Value: $$JpRepDescTx
        Add: Field-id: JwlRepMetal
            Set: Value: JpBlankIfNull($$JpRepMetal)
        Add: Field-id: JwlRepPurity
            Set: Value: $$JpRepPurity
        Add: Field-id: JwlRepGrossWt
            Set: Value: $$JpRepGrossWt
        Add: Field-id: JwlRepStoneWt
            Set: Value: $$JpRepStoneWt
        Add: Field-id: JwlRepNetWt
            Set: Value: $$JpRepNetWt
        Add: Field-id: JwlRepStoneDetail
            Set: Value: JpBlankIfNull($$JpRepStoneDet)
        Add: Field-id: JwlRepWork
            Set: Value: $$JpRepWorkTx
        Add: Field-id: JwlRepKarigar
            Set: Value: JpBlankIfNull($$JpRepKarigarNm)
        Add: Field-id: JwlRepEstAmt
            Set: Value: $$JpRepEstAmt
        Add: Field-id: JwlRepAdvance
            Set: Value: $$JpRepAdvance
        Add: Field-id: JwlRepBalance
            Set: Value: $$JpRepBalance
        Add: Field-id: JwlRepDelivDate
            Set: Value: $$JpRepDelivDt
        Add: Field-id: JwlRepStatus
            Set: Value: $$JpRepStatusTx
        Add: Field-id: JwlRepRecvDate
            Set: Value: JpBlankIfNull(JpCacheDate)
    Accept: JpRepSaved
    JpRepSave = 1

[Function: JpRepSaved]
    Returns: Integer : Any
    JpRepMsg = "Repair " + ##JwlRepNo + " saved. Status: " + ##JwlRepStatus + ".  Balance " + JpFmtAmt(##JwlRepBalance) + "."
    JpRepSaved = 1

[Function: JpRepRegister]
    Returns: Integer : Any
    If (JpHasRight(JpRtReports()) = 0) Then
    {
        JpRepMsg = JpDeniedMsg
        JpRepRegister = 0
        Exit
    }
    Alter: JpRepairRegister
    JpRepRegister = 1

; =============================================================================
;  SECTION E - REPAIR REGISTER
; =============================================================================
[Collection: Report: JpRepairRegister]
    Source: JpRepairRegisterSQL
    Var: JpFromDate, JpToDate, JpRepStatusFilter
    Title: <1000,###,#a##"  JEWELLERY REPAIR REGISTER">
    Print: JpRepairRegisterPrint
    Export: JpRepairRegisterExport
    Key: JpRepairRegisterKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>, <JpRepStatusFilter, <String, "Status">>

[Variable: JpRepairRegisterSQL : String]
    Type: String
    Value: "SELECT * FROM $$JOURNAL$$ WHERE $JwlVchKind$$ = 'Repair' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$"

[Variable: JpRepairRegisterKey : String]
    Type: String
    Value: "JwlRepNo"


