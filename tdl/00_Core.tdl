    JpRtKarigarMgmt = "JADE_KARIGAR_MGMT"
[Function: JpRtReports]
    Returns: String : Any
    JpRtReports = "JADE_REPORTS"
[Function: JpRtCounterClose]
    Returns: String : Any
    JpRtCounterClose = "JADE_COUNTER_CLOSE"

; Minting a barcode WRITES to the item master, so it gets its own right rather
; than borrowing a rate or discount permission that means something else.
[Function: JpRtBarcode]
    Returns: String : Any
    JpRtBarcode = "JADE_BARCODE"

; Report keys - registering a report with one of these keys in
; 01_Main.tdl makes it appear in the relevant Tally report menu.
