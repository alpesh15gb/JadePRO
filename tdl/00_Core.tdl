; Reference key of the most recent daily rate voucher - set by 03_GoldRate.tdl
; while a rate context is open. JpGetUDFNum/JpGetUDFStr read $$Field from the
; object that is currently in focus, so the callers must have loaded the rate
; voucher first. This variable records which voucher that was.
[Variable: vRateContext : String]
[Variable: JpCurrentItem : String]

[Function: JpSetRateContext]
    Param: vRef : String : Optional, vDate : Date : Optional
    Returns: Integer : Any
    vRateContext = Param(0)
    JpLoadRateCache(Param(1))
    JpSetRateContext = 1

[Function: JpBlankIfNull]
    Param: vText : String : Optional
    Returns: String : Any
    If (Param(0) is null) Then
    {
        JpBlankIfNull = ""
        Exit
    }
    JpBlankIfNull = Param(0)

[Function: JpNoIfNull]
    Param: vNum : Number : Optional
