; =============================================================================
;  JadePro  ::  00_Core.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Shared kernel for the JadePro Jewellery ERP for Tally Prime.
;            Constants, global state and the pure calculation / rate /
;            validation / security function library that every other module
;            calls. This file has NO side effects - loading it alone is safe.
;
;  LOAD    : Always load FIRST. Every other module calls functions declared here.
;
;  REQUIRES : Tally Prime (Release 2400 / v3.0 or later). Uses Collection-based
;            reports which are a Prime-only feature.
;
;  DESIGN NOTES
;  ------------
;  * No tax percentage is hard-coded anywhere in this file. Tax is either
;    (a) supplied by the caller, or (b) derived from Tally's own GST ledgers
;    on the voucher. See JpTaxFromLedgers().
;  * Every financial function takes its inputs as parameters and returns a
;    value - nothing reads the screen from inside a calculation function. That
;    keeps the arithmetic unit-testable and reusable from reports.
;  * Money rounding is centralised in JpRound() so that rounding differences
;    between the on-screen value, the ledger posting and the printed invoice
;    can never occur.
; =============================================================================

; -----------------------------------------------------------------------------
;  CONSTANTS
; -----------------------------------------------------------------------------

[Function: JpAppName]
    Returns: String : Any
    JpAppName = "JadePro Jewellery"
[Function: JpVersion]
    Returns: String : Any
    JpVersion = "1.0.0"
[Function: JpSchemaVer]
    Returns: String : Any
    JpSchemaVer = "1"

; Voucher types created by this application.
[Function: JpVchRate]
