    JpVchRate = "Jwl Daily Rate"
[Function: JpVchOldGold]
    Returns: String : Any
    JpVchOldGold = "Jwl Old Gold Exchange"
[Function: JpVchKarOut]
    Returns: String : Any
    JpVchKarOut = "Jwl Karigar Issue"
[Function: JpVchKarIn]
    Returns: String : Any
    JpVchKarIn = "Jwl Karigar Receipt"
[Function: JpVchOrder]
    Returns: String : Any
    JpVchOrder = "Jwl Customer Order"
[Function: JpVchRepair]
    Returns: String : Any
    JpVchRepair = "Jwl Repair"

; Security right identifiers (see 13_Security.tdl).
[Function: JpRtChangeRate]
    Returns: String : Any
    JpRtChangeRate = "JADE_CHANGE_RATE"
[Function: JpRtOverride]
    Returns: String : Any
    JpRtOverride = "JADE_OVERRIDE_RATE"
[Function: JpRtHighDiscount]
