; Order status helpers - used by the dashboard and by open-order reports.
[Function: JpOrderOpen]
    Param: vStatus : String : Optional
    Returns: Integer : Any
    Var: s : String
    s = Param(0)
    If (s = "Delivered") Then { JpOrderOpen = 0; Exit; }
    If (s = "Cancelled") Then { JpOrderOpen = 0; Exit; }
    If (s is null) Then { JpOrderOpen = 1; Exit; }
    If (s = "") Then { JpOrderOpen = 1; Exit; }
    JpOrderOpen = 1

[Function: JpRepairOpen]
    Param: vStatus : String : Optional
    Returns: Integer : Any
    If (Param(0) = "Delivered") Then { JpRepairOpen = 0; Exit; }
    JpRepairOpen = 1

