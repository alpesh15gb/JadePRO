[Line: JpItemJewelPartLine37]
    Field: JpItemJewelPartLine37F1

[Field: JpItemJewelPartLine37F1]
    Storage : JpRecalcBtn
    Label : " "
    Width : 100
    Skip : Yes
[Line: JpItemJewelPartLine38]
    ; Part Name routed to Explode by fix-line-part-name.mjs
    Explode : JpItemValidateMsg : Yes

; --- validation message line ----------------------------------------------
[Part: JpItemValidateMsg]
    Line: JpItemValidateMsgLine1, JpItemValidateMsgLine2

[Line: JpItemValidateMsgLine1]
    Field: JpItemValidateMsgLine1F1

[Field: JpItemValidateMsgLine1F1]
    Storage : JpItemMsg
    Label : " "
    Width : 100
    Style : JpWarn
[Line: JpItemValidateMsgLine2]
    Field: JpItemValidateMsgLine2F1

[Field: JpItemValidateMsgLine2F1]
    Storage : JpItemFormula
    Label : " "
    Width : 100
    Style : JpMuted
Alter: Item, JpItemJewelPart
    Modify Group: JpItemCalcGroup
        ; --- derived, in dependency order -----------------------------------
        Add: Field-id: JwlNetMetalWt
            Set: Value: JpNetWeight($JwlGrossWt, $JwlStoneWt)
        Add: Field-id: JwlMetalValue
            Set: Value: JpMetalValue($JwlNetMetalWt, $JwlGoldRate)
        Add: Field-id: JwlWastageValue
            Set: Value: JpWastageValue($JwlMetalValue, $JwlWastagePc)
        Add: Field-id: JwlStoneValue
            Set: Value: JpStoneValue($JwlStoneWt, $JwlStoneRate)
        Add: Field-id: JwlDiamondValue
            Set: Value: JpDiamondValue($JwlDiamondCarat, $JwlDiamondRate)
        ; Making charge is a DERIVED amount, so it is a reaction on its own
        ; inputs rather than on the other computed fields.
        Add: Field-id: JwlMakingChargeComputed
            Set: Value: JpMakingCharge($JwlMakingType, $JwlNetMetalWt, $JwlMetalValue, $JwlMakingCharge, $JwlGoldRate)
        Add: Field-id: JwlFinalValue
            Set: Value: JpRound($JwlMetalValue + $JwlWastageValue + $JwlMakingChargeComputed + $JwlStoneValue + $JwlDiamondValue)
        Add: Field-id: JpItemFormula
            Set: Value: "Net = Gross - Stone   |   Value = Metal + Wastage + Making + Stone + Diamond"

    ; --- validation line + actions on the same target ----------------------
    Add: Field-id: JpItemMsg
        Set: Value: JpItemValidationText()
        Accept: JpItemCalc
        Reject: JpItemCalc

    Add: Field-id: JpRecalcBtn
        Set: Accept: JpItemCalc
        Set: Reject: JpItemCalc
        Set: Buttons: <Recalculate, OnAction: JpRecalcItem>
        Set: Buttons: <Barcode / Tag, OnAction: JpRecalcItemGenBarcode>

[Function: JpItemCalc]
    Returns: Integer : Any
    JpItemCalc = 1

[Function: JpRecalcItem]
    Returns: Integer : Any
    If (JpIsOwner = 0) Then
    {
        If (JpHasRight(JpRtProfit()) = 0) Then
        {
            JpRecalcItem = 0
            Exit
        }
    }
    JpRecalcItem = 1

[Function: JpRecalcItemGenBarcode]
    Returns: Integer : Any
    JpRecalcItemGenBarcode = 1

; Human readable reason a jewellery item is not acceptable yet.
[Function: JpItemValidationText]
    Returns: String : Any
    Var: m : String
    m = ""
    If ($JwlBarcode = "") Then
    {
        m = "Barcode is mandatory for jewellery items."
        JpItemValidationText = m
        Exit
    }
    If ($JwlCategory = "") Then
    {
        m = "Jewellery Category is mandatory."
        JpItemValidationText = m
        Exit
    }
    If ($JwlMetalType = "") Then
    {
        m = "Metal Type is mandatory."
        JpItemValidationText = m
        Exit
    }
    If (JpPurityValid($JwlPurity) = 0) Then
    {
        m = "Purity " + $JwlPurity + " is not a valid purity."
        JpItemValidationText = m
        Exit
    }
    If (JpWeightValid($JwlGrossWt) = 0) Then
    {
        m = "Gross Weight is missing or out of range."
        JpItemValidationText = m
        Exit
    }
    If ($JwlGoldRate <= 0) Then
    {
        m = "Enter the item gold rate or pick it up from the daily rate master."
        JpItemValidationText = m
        Exit
    }
    If ($JwlFinalValue <= 0) Then
    {
        m = "Final Jewellery Value is zero - check rate, weights and making charge."
        JpItemValidationText = m
        Exit
    }
    If ($JwlMSP > 0) Then
    {
        If ($JwlFinalValue < $JwlMSP) Then
        {
            m = "Warning: computed value is BELOW the Minimum Selling Price."
            JpItemValidationText = m
            Exit
        }
    }
    If ($JwlMRP > 0) Then
    {
        If ($JwlFinalValue > $JwlMRP) Then
        {
            m = "Warning: computed value is ABOVE MRP."
            JpItemValidationText = m
            Exit
        }
    }
    JpItemValidationText = "Item is valid."; =============================================================================
;  SECTION E - GUIDED CREATE / ALTER SCREENS
;  Tally's own Create Item screen is untouched; this is an ADDITIONAL screen
;  for the cashier who packs a new design, because it asks jewellery questions
;  in jewellery order and auto-computes as they type.
; =============================================================================

[Variable: JpScrItemName   : String]
[Variable: JpScrBarcode    : String]
[Variable: JpScrCategory   : String]
[Variable: JpScrDesign     : String]
[Variable: JpScrHuid       : String]
[Variable: JpScrCert       : String]
[Variable: JpScrMetal      : String]
[Variable: JpScrPurity     : String]
[Variable: JpScrRate       : Number]
[Variable: JpScrGross      : Quantity]
[Variable: JpScrStone      : Quantity]
[Variable: JpScrCarat      : Quantity]
[Variable: JpScrNet        : Quantity]
[Variable: JpScrMakeType   : String]
[Variable: JpScrMakeAmt    : Number]
[Variable: JpScrWastage    : Number]
[Variable: JpScrStoneRate  : Number]
[Variable: JpScrDiaRate    : Number]
[Variable: JpScrMetalVal   : Number]
[Variable: JpScrFinalVal   : Number]
[Variable: JpScrMsp        : Number]
[Variable: JpScrMrp        : Number]
[Variable: JpScrCounter    : String]
[Variable: JpScrSupplier   : String]
[Variable: JpScrMsg        : String]
[Variable: JpScrSeq        : Number]

[Screen: JpItemCreateScreen]
    Caption: "JadePro  ::  Create Jewellery Item"
    Key: <Ctrl+Q: System: Quit>

    Line: Spacing
    Lines: 1
    Text: "           CREATE JEWELLERY ITEM  -  " + JpAppName()
    Style: JpTitle
    Line Height: 1
    Text: "Rates today :  24K " + JpFmtAmt(JpCache24K) + "    22K " + JpFmtAmt(JpCache22K) + "    18K " + JpFmtAmt(JpCache18K) + "    14K " + JpFmtAmt(JpCache14K) + "    Silver " + JpFmtAmt(JpCacheSilver)
    Style: JpSub
    Text: " "
    Style: JpMuted

    Line: Spacing
    Lines: 1, 1
    Field: <Field-Id: JpScrItemName, Label: "Item Name *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrBarcode, Label: "Barcode *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrCategory, Label: "Category *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpCatPick
    Field: <Field-Id: JpScrDesign, Label: "Design Number *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrHuid, Label: "HUID">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrCert, Label: "Certificate No">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrCounter, Label: "Counter / Location">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrSupplier, Label: "Supplier / Karigar">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Text: " METAL  AND  PURETY"
    Style: JpSectionBox
    Lines: 1, 1, 1, 1
    Field: <Field-Id: JpScrMetal, Label: "Metal Type *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpMetalPick
    Field: <Field-Id: JpScrPurity, Label: "Purity *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpPurityPick
    Field: <Field-Id: JpScrRate, Label: "Rate / gm *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrGross, Label: "Gross Weight *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrStone, Label: "Stone Weight">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrCarat, Label: "Diamond Carat">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrNet, Label: "Net Metal Weight">
        Width: 250
        Style: UseFormCtrl
        Color: #6B4E1E

    Line: Spacing
    Lines: 1
    Text: " MAKING CHARGES  AND  STONES"
    Style: JpSectionBox
    Lines: 1, 1, 1, 1
    Field: <Field-Id: JpScrMakeType, Label: "Making Charge Type *">
        Width: 250
        Style: UseFormCtrl
        Dynamic: Pick From: JpMakeTypePick
    Field: <Field-Id: JpScrMakeAmt, Label: "Making Charge *">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrWastage, Label: "Wastage %">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrStoneRate, Label: "Stone Rate / gm">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrDiaRate, Label: "Diamond Rate / carat">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrMsp, Label: "Minimum Selling Price">
        Width: 250
        Style: UseFormCtrl
    Field: <Field-Id: JpScrMrp, Label: "MRP">
        Width: 250
        Style: UseFormCtrl

    Line: Spacing
    Lines: 1
    Text: " COMPUTED VALUE"
    Style: JpSectionBox
    Lines: 1, 1
    Field: <Field-Id: JpScrMetalVal, Label: "Metal Value">
        Width: 250
        Style: UseFormCtrl
        Color: #6B4E1E
    Field: <Field-Id: JpScrFinalVal, Label: "FINAL JEWELLERY VALUE">
        Width: 250
        Style: UseFormCtrl
        Color: #A06000

    Line: Spacing
    Lines: 1, 1
    Field: <Field-Id: JpScrMsg, Label: " ">
        Width: 100
        Style: JpWarn
    Text: "Net Weight = Gross Weight - Stone Weight      Value = Metal + Wastage + Making + Stone + Diamond"
    Style: JpMuted

    Line: Spacing
    Lines: 1
    Button: <Recalculate Value, Key: F7, Action: JpCreateCalc>
    Button: <Save Item, Key: F2, Action: JpCreateItem>
    Button: <Quit, Key: Esc, Action: System: Quit>

; Category pick list - free text so a shop can invent its own taxonomy.
[Collection: Source: JpCatPick]
    Data: JpCatPickRow

[Collection: Data: JpCatPickRow]
    Fetch: JpCatPickFetch
    Set: JpCatPickSet
    Repeat: Over: JpCatPickRow

[Collection: Data: JpCatPickFetch]
    Include: JpCatPickRow

[Collection: Data: JpCatPickSet]
    Not On: ##<Not>
    Set: $$Name: Value: JpDefaultCategoryList()

[Function: JpDefaultCategoryList]
    Returns: String : Any
    JpDefaultCategoryList = "Ring##Necklace##Bangles##Bracelet##Chain##Pendant##Earrings##Nose Pin##Maang Tikka##Bezar##Kada##Payal##Anklet##Hair Accessories##Silver Coin##Idol"

; -----------------------------------------------------------------------------
;  ALTER SCREEN - pick an item, then hand over to Tally's own Alter Item.
; -----------------------------------------------------------------------------
[Variable: JpAlterTarget : String]

[Screen: JpItemAlterScreen]
    Caption: "JadePro  ::  Alter Jewellery Item"
    Key: <Ctrl+Q: System: Quit>

    Line: Spacing
    Lines: 1
    Text: "           ALTER JEWELLERY ITEM"
    Style: JpTitle
    Line Height: 1
    Text: " "
    Style: JpMuted
    Lines: 1, 1
    Field: <Field-Id: JpAlterTarget, Label: "Item Name">
        Width: 300
        Style: UseFormCtrl
    Line: Spacing
    Lines: 1
    Text: "Opens Tally's standard Alter Item screen, which now carries the JadePro jewellery block."
    Style: JpMuted
    Line: Spacing
    Lines: 1
    Button: <Open Alter Item, Key: F2, Action: JpOpenAlterItem>
    Button: <Quit, Key: Esc, Action: System: Quit>

; =============================================================================
;  ACTIONS
; =============================================================================

; Live recalculation on the create screen. The screen-level Set: reactions keep
; the four derived values in step with the inputs as they are typed.
[Function: JpCreateCalc]
    Returns: Integer : Any
    JpCreateCalc = 1

[Function: JpCreateItem]
    Returns: Integer : Any
    Var: n : String, mv : Number, sv : Number, dv : Number, wv : Number, mk : Number, nv : Number, fin : Number
    n = JpBlankIfNull($$JpScrItemName)
    JpScrMsg = ""
    If (n = "") Then
    {
        JpScrMsg = "Item Name is mandatory."
        JpCreateItem = 0
        Exit
    }
    If (JpBlankIfNull($$JpScrBarcode) = "") Then
    {
        JpScrMsg = "Barcode is mandatory - it is the scanner key at the counter."
        JpCreateItem = 0
        Exit
    }
    If (JpBlankIfNull($$JpScrCategory) = "") Then
    {
        JpScrMsg = "Jewellery Category is mandatory."
        JpCreateItem = 0
        Exit
    }
    If (JpBlankIfNull($$JpScrMetal) = "") Then
    {
        JpScrMsg = "Metal Type is mandatory."
        JpCreateItem = 0
        Exit
    }
    If (JpPurityValid($$JpScrPurity) = 0) Then
    {
        JpScrMsg = "Purity '" + JpBlankIfNull($$JpScrPurity) + "' is not valid."
        JpCreateItem = 0
        Exit
    }
    If (JpWeightValid($$JpScrGross) = 0) Then
    {
        JpScrMsg = "Gross Weight is mandatory and must be greater than zero."
        JpCreateItem = 0
        Exit
    }
    If ($$JpScrRate <= 0) Then
    {
        JpScrMsg = "Rate per gram is mandatory."
        JpCreateItem = 0
        Exit
    }

    ; --- recompute here too so a saved item is always consistent ---
    JpScrNet = JpNetWeight($$JpScrGross, $$JpScrStone)
    mv = JpMetalValue(JpScrNet, $$JpScrRate)
    wv = JpWastageValue(mv, $$JpScrWastage)
    mk = JpMakingCharge($$JpScrMakeType, JpScrNet, mv, $$JpScrMakeAmt, $$JpScrRate)
    sv = JpStoneValue($$JpScrStone, $$JpScrStoneRate)
    dv = JpDiamondValue($$JpScrCarat, $$JpScrDiaRate)
    fin = JpRound(mv + wv + mk + sv + dv)

    If (JpHasRight(JpRtPurchase()) = 0) Then
    {
        If (JpIsOwner = 0) Then
        {
            JpScrMsg = "You are not allowed to create items with cost information."
            JpCreateItem = 0
            Exit
        }
    }

    Create: Item: n

    Modify Group: JpItemSaveGroup
        Add: Field-id: JwlIsJewellery
            Set: Value: 1
        Add: Field-id: JwlBarcode
            Set: Value: JpBlankIfNull($$JpScrBarcode)
        Add: Field-id: JwlCategory
            Set: Value: JpBlankIfNull($$JpScrCategory)
        Add: Field-id: JwlDesignNo
            Set: Value: JpBlankIfNull($$JpScrDesign)
        Add: Field-id: JwlHuid
            Set: Value: JpBlankIfNull($$JpScrHuid)
        Add: Field-id: JwlCertNo
            Set: Value: JpBlankIfNull($$JpScrCert)
        Add: Field-id: JwlLocation
            Set: Value: JpBlankIfNull($$JpScrCounter)
        Add: Field-id: JwlSupplier
            Set: Value: JpBlankIfNull($$JpScrSupplier)
        Add: Field-id: JwlMetalType
            Set: Value: JpBlankIfNull($$JpScrMetal)
        Add: Field-id: JwlPurity
            Set: Value: JpBlankIfNull($$JpScrPurity)
        Add: Field-id: JwlGoldRate
            Set: Value: $$JpScrRate
        Add: Field-id: JwlGrossWt
            Set: Value: $$JpScrGross
        Add: Field-id: JwlStoneWt
            Set: Value: $$JpScrStone
        Add: Field-id: JwlDiamondCarat
            Set: Value: $$JpScrCarat
        Add: Field-id: JwlNetMetalWt
            Set: Value: JpScrNet
        Add: Field-id: JwlPieces
            Set: Value: 1
        Add: Field-id: JwlMakingType
            Set: Value: JpBlankIfNull($$JpScrMakeType)
        Add: Field-id: JwlMakingCharge
            Set: Value: $$JpScrMakeAmt
        Add: Field-id: JwlWastagePc
            Set: Value: $$JpScrWastage
        Add: Field-id: JwlStoneRate
            Set: Value: $$JpScrStoneRate
        Add: Field-id: JwlDiamondRate
            Set: Value: $$JpScrDiaRate
        Add: Field-id: JwlMetalValue
            Set: Value: mv
        Add: Field-id: JwlWastageValue
            Set: Value: wv
        Add: Field-id: JwlStoneValue
            Set: Value: sv
        Add: Field-id: JwlDiamondValue
            Set: Value: dv
        Add: Field-id: JwlFinalValue
            Set: Value: fin
        Add: Field-id: JwlMSP
            Set: Value: $$JpScrMsp
        Add: Field-id: JwlMRP
            Set: Value: $$JpScrMrp

    Accept: JpCreateDone
    JpCreateItem = 1

[Function: JpCreateDone]
    Returns: Integer : Any
    Var: n : String
    n = JpBlankIfNull($$JpScrItemName)
    JpScrMsg = "Saved: " + n + "   value " + JpFmtAmt($$JpScrFinalVal) + "."
    JpCreateDone = 1

[Function: JpOpenAlterItem]
    Returns: Integer : Any
    Var: n : String
    n = JpBlankIfNull($$JpAlterTarget)
    If (n = "") Then
    {
        JpOpenAlterItem = 0
        Exit
    }
    Alter: n
    JpOpenAlterItem = 1
