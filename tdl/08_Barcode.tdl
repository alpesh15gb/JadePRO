[Report: JpBarcodeRegExport]
    Title : <1000, "Barcode Register">
    Repeat: Over: JpBarcodeReg
    Plain XML : Yes
    Export Header : Yes
    Form : JpBarcodeRegExportForm

[Form: JpBarcodeRegExportForm]
    Parts : JpBarcodeRegExportPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Export:] is not a Tally definition type. Bulk output is a Report
    ; declared Plain XML, with XMLTag on the Part and XMLAttr on the Fields.
    ; "Export Title: Detail" (30 sites) was dropped - Report has Export Header,
    ; and detail-vs-header is not a Part-level concept.
[Part: JpBarcodeRegExportPart]
    XMLTag : "Row"
    Lines : JpBarcodeRegExportLine

[Line: JpBarcodeRegExportLine]
    Field : JpBarcodeRegExportF1
    Field : JpBarcodeRegExportF2
    Field : JpBarcodeRegExportF3
    Field : JpBarcodeRegExportF4
    Field : JpBarcodeRegExportF5
    Field : JpBarcodeRegExportF6
    Field : JpBarcodeRegExportF7
    Field : JpBarcodeRegExportF8
    Field : JpBarcodeRegExportF9

    ; "Export: Value:" had no TDL equivalent. Each became a Field
    ; setting the same payload verbatim; the tag name is derived from it.

[Field: JpBarcodeRegExportF1]
    Set As : $JwlBarcode
    XMLAttr : "JwlBarcode"

[Field: JpBarcodeRegExportF2]
    Set As : $$NAME
    XMLAttr : "NAME"

[Field: JpBarcodeRegExportF3]
    Set As : $JwlDesignNo
    XMLAttr : "JwlDesignNo"

[Field: JpBarcodeRegExportF4]
    Set As : $JwlPurity
    XMLAttr : "JwlPurity"

[Field: JpBarcodeRegExportF5]
    Set As : $JwlGrossWt
    XMLAttr : "JwlGrossWt"

[Field: JpBarcodeRegExportF6]
    Set As : $JwlNetMetalWt
    XMLAttr : "JwlNetMetalWt"

[Field: JpBarcodeRegExportF7]
    Set As : $JwlStoneWt
    XMLAttr : "JwlStoneWt"

[Field: JpBarcodeRegExportF8]
    Set As : $JwlHuid
    XMLAttr : "JwlHuid"

[Field: JpBarcodeRegExportF9]
    Set As : $JwlMRP
    XMLAttr : "JwlMRP"
