; =============================================================================
;  JadePro  ::  14_PrintInvoice.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Premium jewellery invoice - the format a luxury showroom prints.
;            Replaces the print style for Tally's Sales voucher; the standard
;            Sales print is NOT disabled, so it can be restored from Tally's
;            own "Printer Settings" at any time.
;
;  WHAT IS ON THE BILL
;    Shop block with GSTIN, customer block with mobile and GSTIN, the
;    jewellery line grid (HUID, purity, gross / stone / net weight, metal
;    rate, making charges, wastage, discount), taxable value, CGST / SGST /
;    IGST, grand total, amount in words, payment-mode breakup, old-gold
;    exchange annexure, terms and authorised signature.
;
;  PRINT SHORTCUTS INSIDE A SALES VOUCHER
;    F5          preview / print using this format
;    Alt+E       export the invoice to Excel
;
;  LOAD    : After 00_Core, 04_Sales, 06_OldGold.
;  REQUIRES : 00_Core.tdl, 04_Sales.tdl, 06_OldGold.tdl
; =============================================================================

; =============================================================================
;  PART ONE - SHOP LETTERHEAD
; =============================================================================
[Part: JpInvoiceHeader]
    Height: 24
    Height: 18
    Line: JpInvoiceHeaderLine1, JpInvoiceHeaderLine2, JpInvoiceHeaderLine3, JpInvoiceHeaderLine4, JpInvoiceHeaderLine5, JpInvoiceHeaderLine6, JpInvoiceHeaderLine7, JpInvoiceHeaderLine8, JpInvoiceHeaderLine9, JpInvoiceHeaderLine10, JpInvoiceHeaderLine11, JpInvoiceHeaderLine12, JpInvoiceHeaderLine13

[Line: JpInvoiceHeaderLine1]
    Field: JpInvoiceHeaderLine1F1

[Field: JpInvoiceHeaderLine1F1]
    Set As : Upr(##JwlShopName)
    Style : JpFontBold
[Line: JpInvoiceHeaderLine2]
    Field: JpInvoiceHeaderLine2F1

[Field: JpInvoiceHeaderLine2F1]
    Align : CENTRE
[Line: JpInvoiceHeaderLine3]
    Field: JpInvoiceHeaderLine3F1

[Field: JpInvoiceHeaderLine3F1]
    Set As : ##JwlShopAddress
    Style : JpFontBold
    Align : CENTRE
[Line: JpInvoiceHeaderLine4]
    Field: JpInvoiceHeaderLine4F1

[Field: JpInvoiceHeaderLine4F1]
    Set As : "Phone: " + ##JwlCompanyPhone + "          GSTIN: " + ##JwlCompanyGSTIN + "          State: " + ##JwlCompanyState
    Style : JpFontBold
    Align : CENTRE
[Line: JpInvoiceHeaderLine5]
    Field: JpInvoiceHeaderLine5F1

[Field: JpInvoiceHeaderLine5F1]
    Set As : "--------------------------------------------------------------------------------------"
    Style : JpFontBold
[Line: JpInvoiceHeaderLine6]
    Field: JpInvoiceHeaderLine6F1

[Field: JpInvoiceHeaderLine6F1]
    Set As : "TAX INVOICE"
    Style : JpFontBold
[Line: JpInvoiceHeaderLine7]
    Field: JpInvoiceHeaderLine7F1

[Field: JpInvoiceHeaderLine7F1]
    Align : CENTRE
[Line: JpInvoiceHeaderLine8]
    Field: JpInvoiceHeaderLine8F1

[Field: JpInvoiceHeaderLine8F1]
    Set As : "--------------------------------------------------------------------------------------"
    Style : JpFontBold
[Line: JpInvoiceHeaderLine9]
    Field: JpInvoiceHeaderLine9F1

[Field: JpInvoiceHeaderLine9F1]
    Set As : "Invoice No : " + $JwlInvNo + "        Date : " + $$DATE + "        Salesperson : " + $JwlSalesperson
    Style : JpFontBold
[Line: JpInvoiceHeaderLine10]
    Field: JpInvoiceHeaderLine10F1

[Field: JpInvoiceHeaderLine10F1]
    Set As : "Customer   : " + $$PARTYNAME
    Style : JpFontBold
[Line: JpInvoiceHeaderLine11]
    Field: JpInvoiceHeaderLine11F1

[Field: JpInvoiceHeaderLine11F1]
    Set As : "Mobile     : " + $JwlCustMobile + "        Party GSTIN : " + $$PARTYGSTIN
    Style : JpFontBold
[Line: JpInvoiceHeaderLine12]
    Field: JpInvoiceHeaderLine12F1

[Field: JpInvoiceHeaderLine12F1]
    Set As : "Address    : " + $$PARTYADDRESS
    Style : JpFontBold
[Line: JpInvoiceHeaderLine13]
    Field: JpInvoiceHeaderLine13F1

[Field: JpInvoiceHeaderLine13F1]
    Set As : "--------------------------------------------------------------------------------------"
    Style : JpFontBold
