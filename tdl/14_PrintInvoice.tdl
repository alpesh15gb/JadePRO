[Line: JpInvoiceItemsLine26]
    Field: JpInvoiceItemsLine26F1

[Field: JpInvoiceItemsLine26F1]
    Set As : $JwlLnTotal
[Line: JpInvoiceItemsLine27]
    Field: JpInvoiceItemsLine27F1

[Field: JpInvoiceItemsLine27F1]
