[Line: JpInvoiceItemsLine23]
    Field: JpInvoiceItemsLine23F1

[Field: JpInvoiceItemsLine23F1]
    Style : JpMoney
[Line: JpInvoiceItemsLine24]
    Field: JpInvoiceItemsLine24F1

[Field: JpInvoiceItemsLine24F1]
