[Part: JpInvoiceTotals]
    Height: 18
    Line: JpInvoiceTotalsLine1, JpInvoiceTotalsLine2, JpInvoiceTotalsLine3, JpInvoiceTotalsLine4, JpInvoiceTotalsLine5, JpInvoiceTotalsLine6, JpInvoiceTotalsLine7, JpInvoiceTotalsLine8, JpInvoiceTotalsLine9

[Line: JpInvoiceTotalsLine1]
    Field: JpInvoiceTotalsLine1F1

[Field: JpInvoiceTotalsLine1F1]
    Set As : "--------------------------------------------------------------------------------------"
    Style : JpFontBold
[Line: JpInvoiceTotalsLine2]
    Field: JpInvoiceTotalsLine2F1

[Field: JpInvoiceTotalsLine2F1]
    Set As : "Taxable Jewellery Value : " + JpFmtAmt($JwlTaxableVal) + "        Making Charges Value : " + JpFmtAmt($JwlMakeVal)
    Style : JpFontBold
[Line: JpInvoiceTotalsLine3]
    Field: JpInvoiceTotalsLine3F1

[Field: JpInvoiceTotalsLine3F1]
    Set As : "CGST : " + JpFmtAmt($JwlCgst) + "        SGST : " + JpFmtAmt($JwlSgst) + "        IGST : " + JpFmtAmt($JwlIgst)
    Style : JpFontBold
[Line: JpInvoiceTotalsLine4]
    Field: JpInvoiceTotalsLine4F1

[Field: JpInvoiceTotalsLine4F1]
    Set As : "Total GST : " + JpFmtAmt($JwlTaxTotal)
    Style : JpFontBold
[Line: JpInvoiceTotalsLine5]
    Field: JpInvoiceTotalsLine5F1

[Field: JpInvoiceTotalsLine5F1]
    Set As : "--------------------------------------------------------------------------------------"
    Style : JpFontBold
[Line: JpInvoiceTotalsLine6]
    Field: JpInvoiceTotalsLine6F1

[Field: JpInvoiceTotalsLine6F1]
    Set As : "GRAND TOTAL : Rs. " + JpFmtAmt($JwlGrandTotal)
    Style : JpFontBold
[Line: JpInvoiceTotalsLine7]
    Field: JpInvoiceTotalsLine7F1

[Field: JpInvoiceTotalsLine7F1]
    Set As : "--------------------------------------------------------------------------------------"
    Style : JpFontBold
[Line: JpInvoiceTotalsLine8]
    Field: JpInvoiceTotalsLine8F1

[Field: JpInvoiceTotalsLine8F1]
    Set As : "Amount in words : " + JpInWords($JwlGrandTotal)
    Style : JpFontBold
[Line: JpInvoiceTotalsLine9]
    Field: JpInvoiceTotalsLine9F1

[Field: JpInvoiceTotalsLine9F1]
    Set As : " "
    Style : JpFontBold
[Part: JpInvoicePayments]
    Line: JpInvoicePaymentsLine1, JpInvoicePaymentsLine2, JpInvoicePaymentsLine3, JpInvoicePaymentsLine4, JpInvoicePaymentsLine5, JpInvoicePaymentsLine6

[Line: JpInvoicePaymentsLine1]
    Field: JpInvoicePaymentsLine1F1

[Field: JpInvoicePaymentsLine1F1]
    Set As : "PAYMENT BREAKUP"
    Style : JpFontBold
[Line: JpInvoicePaymentsLine2]
    Field: JpInvoicePaymentsLine2F1

[Field: JpInvoicePaymentsLine2F1]
    Set As : "   Cash ................. " + JpFmtAmt($JwlPayCash) + "        Card ................. " + JpFmtAmt($JwlPayCard)
    Style : JpFontBold
[Line: JpInvoicePaymentsLine3]
    Field: JpInvoicePaymentsLine3F1

[Field: JpInvoicePaymentsLine3F1]
    Set As : "   UPI .................. " + JpFmtAmt($JwlPayUpi) + "        Bank Transfer ........ " + JpFmtAmt($JwlPayBank)
    Style : JpFontBold
[Line: JpInvoicePaymentsLine4]
    Field: JpInvoicePaymentsLine4F1

[Field: JpInvoicePaymentsLine4F1]
    Set As : "   Customer Advance ..... " + JpFmtAmt($JwlPayAdvance) + "        Old Gold Exchange .... " + JpFmtAmt($JwlPayOldGold)
    Style : JpFontBold
[Line: JpInvoicePaymentsLine5]
    Field: JpInvoicePaymentsLine5F1

[Field: JpInvoicePaymentsLine5F1]
    Set As : "   Total Received ....... " + JpFmtAmt($JwlPayTotal) + "        Balance Due .......... " + JpFmtAmt($JwlPayBalance)
    Style : JpFontBold
[Line: JpInvoicePaymentsLine6]
    Field: JpInvoicePaymentsLine6F1

[Field: JpInvoicePaymentsLine6F1]
    Set As : " "
[Part: JpInvoiceOldGold]
    Line: JpInvoiceOldGoldLine1, JpInvoiceOldGoldLine2, JpInvoiceOldGoldLine3, JpInvoiceOldGoldLine4, JpInvoiceOldGoldLine5, JpInvoiceOldGoldLine6, JpInvoiceOldGoldLine7, JpInvoiceOldGoldLine8

[Line: JpInvoiceOldGoldLine1]
    Field: JpInvoiceOldGoldLine1F1

    ; layout guard was: If: ##JwlOldGoldRef <> ""
    Empty : ##JwlOldGoldRef = ""
[Field: JpInvoiceOldGoldLine1F1]
    Set As : "--------------------------------------------------------------------------------------"
    Style : JpFontBold
[Line: JpInvoiceOldGoldLine2]
    Field: JpInvoiceOldGoldLine2F1

    ; layout guard was: If: ##JwlOldGoldRef <> ""
    Empty : ##JwlOldGoldRef = ""
[Field: JpInvoiceOldGoldLine2F1]
    Set As : "OLD GOLD / GOLD EXCHANGE DETAILS   (Ref " + $JwlOldGoldRef + ")"
    Style : JpFontBold
[Line: JpInvoiceOldGoldLine3]
    Field: JpInvoiceOldGoldLine3F1

    ; layout guard was: If: ##JwlOldGoldRef <> ""
    Empty : ##JwlOldGoldRef = ""
[Field: JpInvoiceOldGoldLine3F1]
    Set As : "   Metal ............ " + $JwlOgMetal + "        Purity ............ " + $JwlOgPurity + "  (" + JpFmtPc($JwlOgPurityPc) + ")"
    Style : JpFontBold
[Line: JpInvoiceOldGoldLine4]
    Field: JpInvoiceOldGoldLine4F1

    ; layout guard was: If: ##JwlOldGoldRef <> ""
    Empty : ##JwlOldGoldRef = ""
[Field: JpInvoiceOldGoldLine4F1]
    Set As : "   Gross Weight ..... " + JpFmtWt($JwlOgGrossWt) + " gms     Stone Weight ....... " + JpFmtWt($JwlOgStoneWt) + " gms"
    Style : JpFontBold
[Line: JpInvoiceOldGoldLine5]
    Field: JpInvoiceOldGoldLine5F1

    ; layout guard was: If: ##JwlOldGoldRef <> ""
    Empty : ##JwlOldGoldRef = ""
[Field: JpInvoiceOldGoldLine5F1]
    Set As : "   Net Weight ....... " + JpFmtWt($JwlOgNetWt) + " gms     Fine Weight ....... " + JpFmtWt($JwlOgFineWt) + " gms"
    Style : JpFontBold
[Line: JpInvoiceOldGoldLine6]
    Field: JpInvoiceOldGoldLine6F1

    ; layout guard was: If: ##JwlOldGoldRef <> ""
    Empty : ##JwlOldGoldRef = ""
[Field: JpInvoiceOldGoldLine6F1]
    Set As : "   Rate Applied ..... " + JpFmtAmt($JwlOgRate) + " /gm      Deduction .......... " + JpFmtPc($JwlOgDedPc)
    Style : JpFontBold
[Line: JpInvoiceOldGoldLine7]
    Field: JpInvoiceOldGoldLine7F1

    ; layout guard was: If: ##JwlOldGoldRef <> ""
    Empty : ##JwlOldGoldRef = ""
[Field: JpInvoiceOldGoldLine7F1]
    Set As : "   Exchange Value ... " + JpFmtAmt($JwlOgValue) + "     Adjusted to this bill  " + JpFmtAmt($JwlOgAdjAmt) + "     Refundable  " + JpFmtAmt($JwlOgBalAmt)
    Style : JpFontBold
[Line: JpInvoiceOldGoldLine8]
    Field: JpInvoiceOldGoldLine8F1

    ; layout guard was: If: ##JwlOldGoldRef <> ""
    Empty : ##JwlOldGoldRef = ""
[Field: JpInvoiceOldGoldLine8F1]
    Set As : "--------------------------------------------------------------------------------------"
    Style : JpFontBold
[Part: JpInvoiceFooter]
    Line: JpInvoiceFooterLine1, JpInvoiceFooterLine2, JpInvoiceFooterLine3, JpInvoiceFooterLine4, JpInvoiceFooterLine5, JpInvoiceFooterLine6, JpInvoiceFooterLine7, JpInvoiceFooterLine8, JpInvoiceFooterLine9, JpInvoiceFooterLine10

[Line: JpInvoiceFooterLine1]
    Field: JpInvoiceFooterLine1F1

[Field: JpInvoiceFooterLine1F1]
    Set As : "TERMS AND CONDITIONS"
    Style : JpFontBold
[Line: JpInvoiceFooterLine2]
    Field: JpInvoiceFooterLine2F1

[Field: JpInvoiceFooterLine2F1]
    Set As : "   " + JpBlankIfNull($JwlInvoiceTerms)
    Style : JpFontBold
[Line: JpInvoiceFooterLine3]
    Field: JpInvoiceFooterLine3F1

[Field: JpInvoiceFooterLine3F1]
    Set As : "   Gold and silver rates are as on the invoice date. Hallmarked metal carries the HUID shown above."
    Style : JpFontBold
[Line: JpInvoiceFooterLine4]
    Field: JpInvoiceFooterLine4F1

[Field: JpInvoiceFooterLine4F1]
    Set As : "   Exchange is allowed within the shop's published return window against this original invoice."
    Style : JpFontBold
[Line: JpInvoiceFooterLine5]
    Field: JpInvoiceFooterLine5F1

[Field: JpInvoiceFooterLine5F1]
    Set As : "   This is a computer generated invoice."
    Style : JpFontBold
[Line: JpInvoiceFooterLine6]
    Field: JpInvoiceFooterLine6F1

[Field: JpInvoiceFooterLine6F1]
    Set As : " "
    Style : JpFontBold
[Line: JpInvoiceFooterLine7]
    Field: JpInvoiceFooterLine7F1

[Field: JpInvoiceFooterLine7F1]
    Set As : "Customer Signature                                     Authorised Signatory"
    Style : JpFontBold
[Line: JpInvoiceFooterLine8]
    Field: JpInvoiceFooterLine8F1

[Field: JpInvoiceFooterLine8F1]
    Set As : "--------------------------------------------------------------------------------------"
    Style : JpFontBold
[Line: JpInvoiceFooterLine9]
    Field: JpInvoiceFooterLine9F1

[Field: JpInvoiceFooterLine9F1]
    Set As : "Thank you for choosing " + ##JwlShopName + "."
    Style : JpFontBold
    Align : CENTRE
[Line: JpInvoiceFooterLine10]
    Field: JpInvoiceFooterLine10F1

[Field: JpInvoiceFooterLine10F1]
    Set As : "This is a computer generated invoice and does not require a signature."
    Style : JpFontBold
    Align : CENTRE

; [Print: JpInvoicePrint] -> [Form: JpInvoicePrint] by fix-print-to-form.mjs.
; "Print" is a Report attribute, not a definition type; a print layout is a Form.
; dropped (no home in TallyPrime, per user decision): Paper, Margin-left, Margin-right, Margin-top, Margin-bottom, If (control flow), End (control flow)

[Report: JpInvoicePrintPrintReport]
    Form : JpInvoicePrint
    Print : JpInvoicePrint
    Title : "Jewellery Invoice"

[Form: JpInvoicePrint]
    Parts : JpInvoiceHeader, JpInvoiceItems, JpInvoiceTotals, JpInvoicePayments, JpInvoiceOldGold, JpInvoiceFooter
