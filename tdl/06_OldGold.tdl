    Label : " "
        Width: 100
        Style: JpWarn

[Field: JpOldGoldScreenL24F]
    Set As : "The exchange voucher can be printed on the sales invoice by entering its reference in JwlOldGoldRef on the Sales voucher."
    Style : JpMuted

[Function: JpOgCalc]
    Returns: Integer : Any
    Var: pc : Number, ded : Number
    pc = JpOgPurityPc($$JpOgPurity, $$JpOgPurityPc)
    If (pc > 0) Then
    {
        $$JpOgPurityPc = pc
    }
    $$JpOgNet = JpOgNet($$JpOgGross, $$JpOgStone)
    $$JpOgFine = JpOgFine($$JpOgNet, $$JpOgPurityPc)
    ded = $$JpOgDedPc
    If (ded = 0) Then
    {
        ded = ##JwlOldGoldDedPc
        If (ded > 0) Then
        {
            $$JpOgDedPc = ded
        }
    }
    ; The pre-deduction value is recomputed from scratch every time, so
    ; pressing Recalculate repeatedly can never compound the deduction.
    $$JpOgGrossValue = JpOgValue($$JpOgFine, $$JpOgRate)
    $$JpOgValue = JpOgPayout($$JpOgGrossValue, $$JpOgDedPc)
    $$JpOgBalance = JpOgBalance($$JpOgValue, $$JpOgAdjusted)
    JpOgMsg = JpOgValidationText()
    JpOgCalc = 1

[Function: JpOgFetchRate]
    Returns: Integer : Any
    $$JpOgRate = JpOldGoldRate($$JpOgMetal, $$JpOgPurity)
    If ($$JpOgRate <= 0) Then
    {
        JpOgMsg = "No rate found for " + JpBlankIfNull($$JpOgMetal) + " " + JpBlankIfNull($$JpOgPurity) + " today."
        JpOgFetchRate = 0
        Exit
    }
    JpOgCalc
    JpOgFetchRate = 1

[Function: JpOgSave]
    Returns: Integer : Any
    JpOgCalc
    If (JpOgValidationText() <> "") Then
    {
        JpOgSave = 0
        Exit
    }
    Create: Journal
    Modify Group: JpOgSaveGroup
        Add: Field-id: JwlVchKind
            Set: Value: "OldGold"
        Add: Field-id: JwlOgVchNo
            Set: Value: JpOgRefNo()
        Add: Field-id: JwlOgCustName
            Set: Value: $$JpOgCust
        Add: Field-id: JwlOgMetal
            Set: Value: $$JpOgMetal
        Add: Field-id: JwlOgPurity
            Set: Value: $$JpOgPurity
        Add: Field-id: JwlOgPurityPc
            Set: Value: $$JpOgPurityPc
        Add: Field-id: JwlOgGrossWt
            Set: Value: $$JpOgGross
        Add: Field-id: JwlOgStoneWt
            Set: Value: $$JpOgStone
        Add: Field-id: JwlOgNetWt
            Set: Value: $$JpOgNet
        Add: Field-id: JwlOgFineWt
            Set: Value: $$JpOgFine
        Add: Field-id: JwlOgRate
            Set: Value: $$JpOgRate
        Add: Field-id: JwlOgDedPc
            Set: Value: $$JpOgDedPc
        Add: Field-id: JwlOgValue
            Set: Value: $$JpOgValue
        Add: Field-id: JwlOgAdjAmt
            Set: Value: $$JpOgAdjusted
        Add: Field-id: JwlOgBalAmt
            Set: Value: $$JpOgBalance
        Add: Field-id: JwlOgPayMode
            Set: Value: JpBlankIfNull($$JpOgPayMode)
        Add: Field-id: JwlOgHallmark
            Set: Value: JpBlankIfNull($$JpOgHallmark)
        Add: Field-id: JwlOgNote
            Set: Value: JpBlankIfNull($$JpOgNote)
    Accept: JpOgSaved
    JpOgSave = 1

[Function: JpOgSaved]
    Returns: Integer : Any
    JpOgMsg = "Old gold exchange saved. Reference " + ##JwlOgVchNo + ". Enter this in JwlOldGoldRef on the sales invoice to print it on the same bill."
    JpOgSaved = 1

[Function: JpOgRefNo]
    Returns: String : Any
    JpOgRefNo = "OG-" + JpBlankIfNull(JpCacheDate)