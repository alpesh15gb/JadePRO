[Report: JpKarigarOutstandingExport]
    Title : <1000, "Karigar Outstanding">
    Repeat: Over: JpKarigarOutstanding
    Plain XML : Yes
    Export Header : Yes
    Form : JpKarigarOutstandingExportForm

[Form: JpKarigarOutstandingExportForm]
    Parts : JpKarigarOutstandingExportPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Export:] is not a Tally definition type. Bulk output is a Report
    ; declared Plain XML, with XMLTag on the Part and XMLAttr on the Fields.
    ; "Export Title: Detail" (30 sites) was dropped - Report has Export Header,
    ; and detail-vs-header is not a Part-level concept.
[Part: JpKarigarOutstandingExportPart]
    XMLTag : "Row"
    Lines : JpKarigarOutstandingExportLine

[Line: JpKarigarOutstandingExportLine]
    Field : JpKarigarOutstandingExportF1
    Field : JpKarigarOutstandingExportF2
    Field : JpKarigarOutstandingExportF3
    Field : JpKarigarOutstandingExportF4
    Field : JpKarigarOutstandingExportF5
    Field : JpKarigarOutstandingExportF6
    Field : JpKarigarOutstandingExportF7

    ; "Export: Value:" had no TDL equivalent. Each became a Field
    ; setting the same payload verbatim; the tag name is derived from it.

[Field: JpKarigarOutstandingExportF1]
    Set As : $JwlJobKarigar
    XMLAttr : "JwlJobKarigar"

[Field: JpKarigarOutstandingExportF2]
    Set As : $JwlJobNo
    XMLAttr : "JwlJobNo"

[Field: JpKarigarOutstandingExportF3]
    Set As : $JwlJobIssuedWt
    XMLAttr : "JwlJobIssuedWt"

[Field: JpKarigarOutstandingExportF4]
    Set As : $JwlJobRecvNet
    XMLAttr : "JwlJobRecvNet"

[Field: JpKarigarOutstandingExportF5]
    Set As : $JwlJobWastageWt
    XMLAttr : "JwlJobWastageWt"

[Field: JpKarigarOutstandingExportF6]
    Set As : $JwlJobBalWt
    XMLAttr : "JwlJobBalWt"

[Field: JpKarigarOutstandingExportF7]
    Set As : $JwlJobLabour
    XMLAttr : "JwlJobLabour"
