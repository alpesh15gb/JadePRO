; =============================================================================
;  JadePro  ::  07_Karigar.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Karigar / Job-Work management.
;            Gold issued to a karigar, jewellery received back, wastage,
;            labour charges and the metal still lying with each karigar.
;
;  BALANCE MODEL
;    Balance with karigar = Metal Issued - (Net Weight Received + Wastage Given)
;    Labour charges are posted to the karigar ledger as a payable.
;
;  LOAD    : After 00_Core, 03_GoldRate, 04_Sales.
;  REQUIRES : 00_Core.tdl, 03_GoldRate.tdl, 04_Sales.tdl
; =============================================================================

; =============================================================================
;  SECTION A - KARIGAR LEDGER UDFs
; =============================================================================
    ; Label: "Is Karigar"
[System: UDF]
JwlIsKarigar : Logical : 20153
    ; Label: "Karigar Speciality"
[System: UDF]
JwlKarigarSpeciality : String : 20154
    ; Label: "Karigar City"
[System: UDF]
JwlKarigarCity : String : 20155
    ; Label: "Karigar PAN"
[System: UDF]
JwlKarigarPan : String : 20156
    ; Label: "Metal Balance With Karigar"
[System: UDF]
JwlKarigarOpenWt : Quantity : 20157
    ; Label: "Payable To Karigar"
[System: UDF]
JwlKarigarOpenAmt : Number : 20158
; =============================================================================
;  SECTION B - JOB WORK VOUCHER UDFs
; =============================================================================
    ; Label: "Job Work Reference"
[System: UDF]
JwlJobNo : String : 20159
    ; Label: "Karigar"
[System: UDF]
JwlJobKarigar : String : 20160
    ; Label: "Job Type"
[System: UDF]
JwlJobType : String : 20161
    ; Label: "Job Description"
[System: UDF]
JwlJobDesc : String : 20162
    ; Label: "Job Design Number"
[System: UDF]
JwlJobDesign : String : 20163
    ; Label: "Date Issued"
[System: UDF]
JwlJobIssuedDate : Date : 20164
    ; Label: "Weight Issued"
[System: UDF]
JwlJobIssuedWt : Quantity : 20165
    ; Label: "Issued Purity"
[System: UDF]
JwlJobIssuedPure : String : 20166
    ; Label: "Issue Rate"
[System: UDF]
JwlJobIssuedRate : Number : 20167
    ; Label: "Date Received"
[System: UDF]
JwlJobRecvDate : Date : 20168
    ; Label: "Gross Weight Received"
[System: UDF]
JwlJobRecvGross : Quantity : 20169
    ; Label: "Net Weight Received"
[System: UDF]
JwlJobRecvNet : Quantity : 20170
    ; Label: "Wastage Given %"
[System: UDF]
JwlJobWastagePc : Number : 20171
    ; Label: "Wastage Weight"
[System: UDF]
JwlJobWastageWt : Quantity : 20172
    ; Label: "Labour Charges"
[System: UDF]
JwlJobLabour : Number : 20173
    ; Label: "Balance Metal With Karigar"
[System: UDF]
JwlJobBalWt : Quantity : 20174
    ; Label: "Job Status"
[System: UDF]
JwlJobStatus : String : 20175
[Function: JpJobStatusList]
    Returns: String : Any
    JpJobStatusList = "Issued##Part Received##In Progress##Received##Closed"

; =============================================================================
;  SECTION C - KARIGAR BLOCK ON THE LEDGER MASTER
; =============================================================================
Alter: Ledger
    Add: Field
        Field-id: JpKarigarChk
        Label: "Is Karigar"
        Type: Logical
        Value: ##JwlIsKarigar
        Width: 140
        Style: UseFormCtrl

    Add: Field
        Field-id: JpKarigarBlock
        Part-id: JpKarigarPart
        Width: 100
        Invisible: ##JwlIsKarigar <> 1

    ; The Customer CRM block (Part defined in 11_Reports.tdl) is attached to
    ; the SAME Alter: Ledger section - TDL allows only one section per name.
    Add: Field
        Field-id: JpCrmBlock
        Part-id: JpCrmPart
        Width: 100
        Invisible: ##JwlPartyState = ""

[Part: JpKarigarPart]
    Line: Spacing, JpKarigarPartLine1, JpKarigarPartLine2, JpKarigarPartLine3, JpKarigarPartLine4, JpKarigarPartLine5, JpKarigarPartLine6

