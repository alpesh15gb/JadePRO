    Label : "City"
    Width : 200
[Line: JpKarigarPartLine4]
    Field: JpKarigarPartLine4F1

[Field: JpKarigarPartLine4F1]
    Storage : JwlKarigarPan
    Label : "PAN"
    Width : 200
[Line: JpKarigarPartLine5]
    Field: JpKarigarPartLine5F1

[Field: JpKarigarPartLine5F1]
    Storage : JwlKarigarOpenWt
    Label : "Metal Balance (gm)"
    Style : JpFontBold
    Width : 200
    Color : #A06000
[Line: JpKarigarPartLine6]
    Field: JpKarigarPartLine6F1

[Field: JpKarigarPartLine6F1]
    Storage : JwlKarigarOpenAmt
    Label : "Payable To Karigar"
    Style : JpFontBold
    Width : 200
    Color : #A06000
[Function: JpJobWastageWt]
    Param: vIssuedWt : Quantity : Optional, vRecvNet : Quantity : Optional, vWastPc : Number : Optional
    Returns: Quantity : Any
    Var: i : Quantity, r : Quantity, p : Number
    i = Param(0)
    r = Param(1)
    p = Param(2)
    If (i is null) Then { i = 0; }
    If (r is null) Then { r = 0; }
    If (p is null) Then { p = 0; }
    If (p <= 0) Then
    {
        ; No stated percentage: whatever is missing is the wastage given.
        If (i > r) Then
        {
            JpJobWastageWt = JpRoundWt(i - r)
            Exit
        }
        JpJobWastageWt = 0
        Exit
    }
    If (r <= 0) Then
    {
        JpJobWastageWt = 0
        Exit
    }
    JpJobWastageWt = JpRoundWt(r * p / 100)

; Metal still with the karigar = issued - received - wastage given.
[Function: JpJobBalance]
    Param: vIssuedWt : Quantity : Optional, vRecvNet : Quantity : Optional, vWastPc : Number : Optional
    Returns: Quantity : Any
    Var: i : Quantity, r : Quantity, p : Quantity
    i = Param(0)
    r = Param(1)
    p = JpJobWastageWt(Param(0), Param(1), Param(2))
    If (i is null) Then { i = 0; }
    If (r is null) Then { r = 0; }
    JpJobBalance = JpRoundWt(i - r - p)

[Function: JpJobLabourPerGm]
    Param: vLabour : Number : Optional, vRecvNet : Quantity : Optional
    Returns: Number : Any
    JpJobLabourPerGm = JpAmtPerGram(Param(0), Param(1))

