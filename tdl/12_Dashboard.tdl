[Function: JpAlertRef]
    Returns: String : Any
    If ($$JwlKind = "Order") Then
    {
        JpAlertRef = JpBlankIfNull($$JwlRef)
        Exit
    }
    If ($$JwlKind = "Repair") Then
    {
        JpAlertRef = JpBlankIfNull($$JwlRepRef)
        Exit
    }
    If ($$JwlKind = "KarigarJob") Then
    {
        JpAlertRef = JpBlankIfNull($$JwlJobRef)
        Exit
    }
    JpAlertRef = ""

[Function: JpAlertParty]
    Returns: String : Any
    If ($$JwlKind = "Order") Then
    {
        JpAlertParty = JpBlankIfNull($$JwlCust)
        Exit
    }
    If ($$JwlKind = "Repair") Then
    {
        JpAlertParty = JpBlankIfNull($JwlRepCust)
        Exit
    }
    If ($$JwlKind = "KarigarJob") Then
    {
        JpAlertParty = JpBlankIfNull($$JwlKarigar)
        Exit
    }
    JpAlertParty = ""

[Function: JpAlertStatus]
    Returns: String : Any
    If ($$JwlKind = "Order") Then
    {
        JpAlertStatus = JpBlankIfNull($JwlOrdStatus)
        Exit
    }
    If ($$JwlKind = "Repair") Then
    {
        JpAlertStatus = JpBlankIfNull($JwlRepStatus)
        Exit
    }
    If ($$JwlKind = "KarigarJob") Then
    {
        JpAlertStatus = JpBlankIfNull($JwlJobStatus)
        Exit
    }
    JpAlertStatus = ""

[Function: JpAlertDue]
    Returns: String : Any
    Var: d : Date
    If ($$JwlKind = "Order") Then
    {
        d = $$JwlOrdDate
    }
    If ($$JwlKind = "Repair") Then
    {
        d = $$JwlRepDate
    }
    If (d is null) Then
    {
        JpAlertDue = "-"
        Exit
    }
    If (d < JpCacheDate) Then
    {
        JpAlertDue = "OVERDUE"
        Exit
    }
    JpAlertDue = JpFmtDate(d)

[Function: JpAlertValue]
    Returns: String : Any
    If ($$JwlKind = "Order") Then
    {
        JpAlertValue = JpFmtAmt($$JwlAdvBal)
        Exit
    }
    If ($$JwlKind = "Repair") Then
    {
        JpAlertValue = JpFmtAmt($$JwlRepBal)
        Exit
    }
    If ($$JwlKind = "KarigarJob") Then
    {
        JpAlertValue = JpFmtWt($JwlJobBalWt) + " g"
        Exit
    }
    JpAlertValue = ""

[Function: JpCountKind]
    Param: vKind : String : Optional
    Returns: Number : Any
    JpCountKind = Count($$JwlRef)

[Report: JpAlertDashboardExport]
    Title : <1000, "Dashboard - Pending Work">
    Repeat: Over: JpAlertDashboard
    Plain XML : Yes
    Export Header : Yes
    Form : JpAlertDashboardExportForm

[Form: JpAlertDashboardExportForm]
    Parts : JpAlertDashboardExportPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Export:] is not a Tally definition type. Bulk output is a Report
    ; declared Plain XML, with XMLTag on the Part and XMLAttr on the Fields.
    ; "Export Title: Detail" (30 sites) was dropped - Report has Export Header,
    ; and detail-vs-header is not a Part-level concept.
[Part: JpAlertDashboardExportPart]
    XMLTag : "Row"
    Lines : JpAlertDashboardExportLine

[Line: JpAlertDashboardExportLine]
    Field : JpAlertDashboardExportF1
    Field : JpAlertDashboardExportF2
    Field : JpAlertDashboardExportF3
    Field : JpAlertDashboardExportF4
    Field : JpAlertDashboardExportF5
    Field : JpAlertDashboardExportF6
    Field : JpAlertDashboardExportF7

    ; "Export: Value:" had no TDL equivalent. Each became a Field
    ; setting the same payload verbatim; the tag name is derived from it.

[Field: JpAlertDashboardExportF1]
    Set As : $$JwlKind
    XMLAttr : "JwlKind"

[Field: JpAlertDashboardExportF2]
    Set As : $$JwlRef
    XMLAttr : "JwlRef"

[Field: JpAlertDashboardExportF3]
    Set As : $$JwlRepRef
    XMLAttr : "JwlRepRef"

[Field: JpAlertDashboardExportF4]
    Set As : $$JwlJobRef
    XMLAttr : "JwlJobRef"

[Field: JpAlertDashboardExportF5]
    Set As : $JwlOrdStatus
    XMLAttr : "JwlOrdStatus"

[Field: JpAlertDashboardExportF6]
    Set As : $JwlRepStatus
    XMLAttr : "JwlRepStatus"

[Field: JpAlertDashboardExportF7]
    Set As : $JwlJobBalWt
    XMLAttr : "JwlJobBalWt"

[Collection: Report: JpInvDashboard]
    Source: JpInvDashboardSQL
    Title: <1000,###,#a##"  DASHBOARD 4 of 4  -  INVENTORY AND STOCK VALUE">
    Print: JpInvDashboardPrint
    Export: JpInvDashboardExport
    Key: JpInvDashboardKey

[Variable: JpInvDashboardSQL : String]
    Type: String
    Value: "SELECT $JwlMetalType$$ AS JwlMetal, $JwlPurity$$ AS JwlPur, SUM($$QUANTITY$$) AS JwlPcs, SUM($JwlNetMetalWt$$ * $$QUANTITY$$) AS JwlWt, SUM($JwlDiamondCarat$$ * $$QUANTITY$$) AS JwlCarat, SUM($JwlMetalValue$$ * $$QUANTITY$$) AS JwlMetalVal, SUM($JwlStoneValue$$ * $$QUANTITY$$) AS JwlStoneVal, SUM($JwlDiamondValue$$ * $$QUANTITY$$) AS JwlDiaVal, SUM($JwlFinalValue$$ * $$QUANTITY$$) AS JwlStockVal FROM $$ITEMSSTOCK$$ WHERE $JwlIsJewellery$$ = 1 GROUP BY $JwlMetalType$$,$JwlPurity$$ ORDER BY $JwlMetalType$$,$JwlPurity$$"

[Variable: JpInvDashboardKey : String]
    Type: String
    Value: "JwlMetal"


