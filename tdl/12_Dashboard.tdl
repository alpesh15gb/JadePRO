    Plain XML : Yes
    Export Header : Yes
    Form : JpWeightDashboardExportForm

[Form: JpWeightDashboardExportForm]
    Parts : JpWeightDashboardExportPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Export:] is not a Tally definition type. Bulk output is a Report
    ; declared Plain XML, with XMLTag on the Part and XMLAttr on the Fields.
    ; "Export Title: Detail" (30 sites) was dropped - Report has Export Header,
    ; and detail-vs-header is not a Part-level concept.
[Part: JpWeightDashboardExportPart]
    XMLTag : "Row"
    Lines : JpWeightDashboardExportLine

[Line: JpWeightDashboardExportLine]
    Field : JpWeightDashboardExportF1
    Field : JpWeightDashboardExportF2
    Field : JpWeightDashboardExportF3
    Field : JpWeightDashboardExportF4
    Field : JpWeightDashboardExportF5

    ; "Export: Value:" had no TDL equivalent. Each became a Field
    ; setting the same payload verbatim; the tag name is derived from it.

[Field: JpWeightDashboardExportF1]
    Set As : $$JwlCat
    XMLAttr : "JwlCat"

[Field: JpWeightDashboardExportF2]
    Set As : $$JwlSp
    XMLAttr : "JwlSp"

[Field: JpWeightDashboardExportF3]
    Set As : $$JwlPcs
    XMLAttr : "JwlPcs"

[Field: JpWeightDashboardExportF4]
    Set As : $$JwlWtSold
    XMLAttr : "JwlWtSold"

[Field: JpWeightDashboardExportF5]
    Set As : $$JwlRev
    XMLAttr : "JwlRev"

[Collection: Report: JpAlertDashboard]
    Source: JpAlertDashboardSQL
    Title: <1000,###,#a##"  DASHBOARD 3 of 4  -  PENDING WORK AND ATTENTION">
    Print: JpAlertDashboardPrint
    Export: JpAlertDashboardExport
    Key: JpAlertDashboardKey
    Filters: <JpAlertKind, <String, "Kind (blank = all)">>

[Variable: JpAlertDashboardSQL : String]
    Type: String
    Value: "SELECT $JwlVchKind$$ AS JwlKind, $JwlOrdNo$$ AS JwlRef, $JwlOrdCust$$ AS JwlCust, $JwlRepNo$$ AS JwlRepRef, $JwlRepCust$$ AS JwlRepCust, $JwlJobNo$$ AS JwlJobRef, $JwlJobKarigar$$ AS JwlKarigar, $JwlOrdStatus$$ AS JwlOrdStatus, $JwlRepStatus$$ AS JwlRepStatus, $JwlJobStatus$$ AS JwlJobStatus, $JwlOrdAdvBalance$$ AS JwlAdvBal, $JwlRepBalance$$ AS JwlRepBal, $JwlJobBalWt$$ AS JwlJobBalWt, $JwlOrdDelivDate$$ AS JwlOrdDate, $JwlRepDelivDate$$ AS JwlRepDate FROM $$JOURNAL$$ WHERE $JwlVchKind$$ IN ('Order','Repair','KarigarJob')"

[Variable: JpAlertDashboardKey : String]
    Type: String
    Value: "JwlKind"


; [Print: JpAlertDashboardPrint] -> [Form: JpAlertDashboardPrint] by fix-print-to-form.mjs.
; "Print" is a Report attribute, not a definition type; a print layout is a Form.
; dropped (no home in TallyPrime, per user decision): Width (column widths)

