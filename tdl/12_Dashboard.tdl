    Style : JpCardHdr
[Line: JpWeightDashboardPrintLine9]
    Field: JpWeightDashboardPrintLine9F1

[Field: JpWeightDashboardPrintLine9F1]
    Set As : "   " + JpFmtAmt(Sum($$JwlRev))
    Style : JpBigNum
[Line: JpWeightDashboardPrintLine10]
