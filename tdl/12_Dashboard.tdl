    Style : JpFontBold
[Line: JpWeightDashboardPrintLine3]
    Field: JpWeightDashboardPrintLine3F1

[Field: JpWeightDashboardPrintLine3F1]
    Set As : "DASHBOARD 2 of 4   -   " + JpFmtDate($$JpDashFrom) + "  to  " + JpFmtDate($$JpDashTo)
    Style : JpFontBold
[Line: JpWeightDashboardPrintLine4]
    Field: JpWeightDashboardPrintLine4F1

[Field: JpWeightDashboardPrintLine4F1]
    Set As : "  GOLD SOLD (GRAMS)        "
    Style : JpCardHdr
[Line: JpWeightDashboardPrintLine5]
    Field: JpWeightDashboardPrintLine5F1

[Field: JpWeightDashboardPrintLine5F1]
    Set As : "   " + JpFmtWt(Sum($$JwlWtSold))
    Style : JpBigNum
[Line: JpWeightDashboardPrintLine6]
    Field: JpWeightDashboardPrintLine6F1

[Field: JpWeightDashboardPrintLine6F1]
    Set As : "  PIECES SOLD              "
    Style : JpCardHdr
[Line: JpWeightDashboardPrintLine7]
    Field: JpWeightDashboardPrintLine7F1

[Field: JpWeightDashboardPrintLine7F1]
