    Set As : "Gold, Silver and Platinum weights individually: see the Metal / Purity rows above, or Gateway > Jewellery > Inventory Reports > Metal-wise Stock."
    Style : JpFontBold
[Report: JpInvDashboardExport]
    Title : <1000, "Dashboard - Inventory">
    Repeat: Over: JpInvDashboard
    Plain XML : Yes
    Export Header : Yes
    Form : JpInvDashboardExportForm

[Form: JpInvDashboardExportForm]
    Parts : JpInvDashboardExportPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Export:] is not a Tally definition type. Bulk output is a Report
    ; declared Plain XML, with XMLTag on the Part and XMLAttr on the Fields.
    ; "Export Title: Detail" (30 sites) was dropped - Report has Export Header,
    ; and detail-vs-header is not a Part-level concept.
[Part: JpInvDashboardExportPart]
    XMLTag : "Row"
    Lines : JpInvDashboardExportLine

[Line: JpInvDashboardExportLine]
    Field : JpInvDashboardExportF1
    Field : JpInvDashboardExportF2
    Field : JpInvDashboardExportF3
    Field : JpInvDashboardExportF4
    Field : JpInvDashboardExportF5
    Field : JpInvDashboardExportF6

    ; "Export: Value:" had no TDL equivalent. Each became a Field
    ; setting the same payload verbatim; the tag name is derived from it.

[Field: JpInvDashboardExportF1]
    Set As : $$JwlMetal
    XMLAttr : "JwlMetal"

[Field: JpInvDashboardExportF2]
    Set As : $$JwlPur
    XMLAttr : "JwlPur"

[Field: JpInvDashboardExportF3]
    Set As : $$JwlPcs
    XMLAttr : "JwlPcs"

[Field: JpInvDashboardExportF4]
    Set As : $$JwlWt
    XMLAttr : "JwlWt"

[Field: JpInvDashboardExportF5]
    Set As : $$JwlCarat
    XMLAttr : "JwlCarat"

[Field: JpInvDashboardExportF6]
    Set As : $$JwlStockVal
    XMLAttr : "JwlStockVal"
