; =============================================================================
;  JadePro  ::  12_Dashboard.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Jewellery Business Dashboard.
;
;  WHY THE DASHBOARD IS FOUR REPORTS, NOT ONE SCREEN
;  --------------------------------------------------
;  A TDL Report is bound to EXACTLY ONE data source, and Tally Prime's TDL has
;  no way to merge independent SQL result sets onto a single screen. The shop's
;  dashboard needs four different tables, so it is delivered as four card
;  reports that print with one shared visual template and sit together in the
;  menu under "Dashboard":
;
;    1. JpDashboard        voucher level  - Today: sales, purchases, cash,
;                                           card, UPI, bank, advance, old
;                                           gold, bills, average invoice.
;    2. JpWeightDashboard  line level     - Gold sold in grams, top category,
;                                           top product, top salesperson.
;    3. JpAlertDashboard   journal level  - Pending orders, pending repairs,
;                                           gold lying with karigars,
;                                           outstanding customers.
;    4. JpInvDashboard     item level     - Gold / Silver / Diamond /
;                                           Platinum stock and stock value.
;
;  This is a TDL platform constraint, stated plainly rather than papered over
;  with a screen that shows half the numbers.
;
;  THE AGGREGATION TRICK
;  Each metric is its own UDF column on the voucher, so SUM(column) isolates
;  that metric exactly. A Sales voucher leaves JwlPurTotal at zero and a
;  Purchase voucher leaves JwlGrandTotal at zero, so ONE query yields sales and
;  purchases side by side with no CASE expressions anywhere.
;
;  LOAD    : After 00_Core, 04_Sales, 11_Reports.
;  REQUIRES : 00_Core.tdl, 04_Sales.tdl, 11_Reports.tdl
; =============================================================================

; =============================================================================
;  CARD 1 - MONEY  (voucher level)
; =============================================================================
[Collection: Report: JpDashboard]
    Source: JpDashboardSQL
    Var: JpDashFrom, JpDashTo
    Title: <1000,###,#a##"  DASHBOARD 1 of 4  -  SALES, PURCHASES AND COLLECTIONS">
    Print: JpDashboardPrint
    Export: JpDashboardExport

[Variable: JpDashboardSQL : String]
    Type: String
    Value: "SELECT $$VOUCHERTYPE$$ AS JwlVchType, SUM($JwlGrandTotal$$) AS JwlSales, SUM($JwlPurTotal$$) AS JwlPurch, SUM($JwlPayCash$$) AS JwlCash, SUM($JwlPayCard$$) AS JwlCard, SUM($JwlPayUpi$$) AS JwlUpi, SUM($JwlPayBank$$) AS JwlBank, SUM($JwlPayAdvance$$) AS JwlAdv, SUM($JwlPayOldGold$$) AS JwlOldG, SUM($JwlDiscAmt$$) AS JwlDisc, COUNT($$VOUCHERID$$) AS JwlBills FROM $$VOUCHERS$$ WHERE $$DATE$$ BETWEEN $$JpDashFrom$$ AND $$JpDashTo$$ GROUP BY $$VOUCHERTYPE$$"

; Fixed-width card slots so the printed grid never shifts.
[Function: JpCardMoney]
    Param: vVal : Number : Optional
    Returns: String : Any
    Var: s : String
    s = JpFmtAmt(Param(0))
    While (Len(s) < 20) Then
    {
        s = " " + s
    }
    JpCardMoney = s


; [Print: JpDashboardPrint] -> [Form: JpDashboardPrint] by fix-print-to-form.mjs.
; "Print" is a Report attribute, not a definition type; a print layout is a Form.

[Form: JpDashboardPrint]
    Height : 18
    Parts : JpDashboardPrintLines

[Part: JpDashboardPrintLines]
    Lines : Spacing, JpDashboardPrintLine1, JpDashboardPrintLine2, JpDashboardPrintLine3, JpDashboardPrintLine4, JpDashboardPrintLine5, JpDashboardPrintLine6, JpDashboardPrintLine7, JpDashboardPrintLine8, JpDashboardPrintLine9, JpDashboardPrintLine10, JpDashboardPrintLine11, JpDashboardPrintLine12, JpDashboardPrintLine13, JpDashboardPrintLine14, JpDashboardPrintLine15, JpDashboardPrintLine16, JpDashboardPrintLine17, JpDashboardPrintLine18, JpDashboardPrintLine19, JpDashboardPrintLine20, JpDashboardPrintLine21

[Line: JpDashboardPrintLine1]
    ; removed by fix-line-container-attrs.mjs - Title is a print-layout attribute, not a Line attribute
    ; removed by fix-line-container-attrs.mjs - Paper is a print-layout attribute, not a Line attribute
    ; removed by fix-line-container-attrs.mjs - Margin-right is a print-layout attribute, not a Line attribute
    ; removed by fix-line-container-attrs.mjs - Margin-bottom is a print-layout attribute, not a Line attribute
[Line: JpDashboardPrintLine2]
    Field: JpDashboardPrintLine2F1

[Field: JpDashboardPrintLine2F1]
    Set As : Upr(##JwlShopName)
    Style : JpFontBold
[Line: JpDashboardPrintLine3]
    Field: JpDashboardPrintLine3F1

[Field: JpDashboardPrintLine3F1]
    Set As : "DASHBOARD 1 of 4   -   " + JpFmtDate($$JpDashFrom) + "  to  " + JpFmtDate($$JpDashTo)
    Style : JpFontBold
[Line: JpDashboardPrintLine4]
    Field: JpDashboardPrintLine4F1

[Field: JpDashboardPrintLine4F1]
    Set As : "User: " + JpBlankIfNull(JpUserName) + " (" + JpBlankIfNull(JpUserRole) + ")"
    Style : JpFontBold
[Line: JpDashboardPrintLine5]
    Field: JpDashboardPrintLine5F1

[Field: JpDashboardPrintLine5F1]
    Set As : "   SALES AND PURCHASES"
    Style : JpCardHdr
[Line: JpDashboardPrintLine6]
    Field: JpDashboardPrintLine6F1

[Field: JpDashboardPrintLine6F1]
    Set As : "  TOTAL SALES          TOTAL PURCHASES     NUMBER OF BILLS     AVERAGE INVOICE VALUE"
    Style : JpCardHdr
[Line: JpDashboardPrintLine7]
    Field: JpDashboardPrintLine7F1

[Field: JpDashboardPrintLine7F1]
    Set As : JpCardMoney(Sum($$JwlSales)) + JpCardMoney(Sum($$JwlPurch))
    Style : JpBigNum
[Line: JpDashboardPrintLine8]
    Field: JpDashboardPrintLine8F1

[Field: JpDashboardPrintLine8F1]
    Set As : String(Sum($$JwlBills), "0")
    Style : JpBigNum
[Line: JpDashboardPrintLine9]
    Field: JpDashboardPrintLine9F1

[Field: JpDashboardPrintLine9F1]
    Set As : "  DISCOUNT GIVEN       "
    Style : JpCardHdr
[Line: JpDashboardPrintLine10]
    Field: JpDashboardPrintLine10F1

[Field: JpDashboardPrintLine10F1]
    Set As : JpCardMoney(Sum($$JwlDisc)) + JpCardMoney(Sum($$JwlSales) - Sum($$JwlPurch))
    Style : JpBigNum
[Line: JpDashboardPrintLine11]
    Field: JpDashboardPrintLine11F1

[Field: JpDashboardPrintLine11F1]
    Set As : "  (net cash margin)"
    Style : JpFontBold
[Line: JpDashboardPrintLine12]
    Field: JpDashboardPrintLine12F1

[Field: JpDashboardPrintLine12F1]
    Set As : "   COLLECTIONS BY PAYMENT MODE"
    Style : JpCardHdr
[Line: JpDashboardPrintLine13]
    Field: JpDashboardPrintLine13F1

[Field: JpDashboardPrintLine13F1]
    Set As : "  CASH                 CARD                 UPI                  BANK TRANSFER"
    Style : JpCardHdr
[Line: JpDashboardPrintLine14]
    Field: JpDashboardPrintLine14F1

[Field: JpDashboardPrintLine14F1]
    Set As : JpCardMoney(Sum($$JwlCash)) + JpCardMoney(Sum($$JwlCard))
    Style : JpBigNum
[Line: JpDashboardPrintLine15]
    Field: JpDashboardPrintLine15F1

[Field: JpDashboardPrintLine15F1]
    Set As : JpCardMoney(Sum($$JwlUpi)) + JpCardMoney(Sum($$JwlBank))
    Style : JpBigNum
[Line: JpDashboardPrintLine16]
    Field: JpDashboardPrintLine16F1

[Field: JpDashboardPrintLine16F1]
    Set As : "  CUSTOMER ADVANCE     OLD GOLD EXCHANGE    TOTAL COLLECTED      BALANCE DUE"
    Style : JpCardHdr
[Line: JpDashboardPrintLine17]
    Field: JpDashboardPrintLine17F1

[Field: JpDashboardPrintLine17F1]
    Set As : JpCardMoney(Sum($$JwlAdv)) + JpCardMoney(Sum($$JwlOldG))
    Style : JpBigNum
[Line: JpDashboardPrintLine18]
    Field: JpDashboardPrintLine18F1

[Field: JpDashboardPrintLine18F1]
    Set As : JpCardMoney(Sum($$JwlCash) + Sum($$JwlCard) + Sum($$JwlUpi) + Sum($$JwlBank) + Sum($$JwlAdv) + Sum($$JwlOldG))
    Style : JpBigNum
[Line: JpDashboardPrintLine19]
    Field: JpDashboardPrintLine19F1

[Field: JpDashboardPrintLine19F1]
    Set As : "   METAL RATES IN FORCE"
    Style : JpCardHdr
[Line: JpDashboardPrintLine20]
    Field: JpDashboardPrintLine20F1

[Field: JpDashboardPrintLine20F1]
    Set As : "  24K " + JpFmtAmt(JpCache24K) + "      22K " + JpFmtAmt(JpCache22K) + "      18K " + JpFmtAmt(JpCache18K) + "      14K " + JpFmtAmt(JpCache14K)
    Style : JpFontBold
[Line: JpDashboardPrintLine21]
    Field: JpDashboardPrintLine21F1

[Field: JpDashboardPrintLine21F1]
    Set As : "  Silver " + JpFmtAmt(JpCacheSilver) + "      Platinum " + JpFmtAmt(JpCachePlatinum)
    Style : JpFontBold
[Report: JpDashboardExport]
    Title : <1000, "Dashboard - Sales and Collections">
    Repeat: Over: JpDashboard
    Plain XML : Yes
    Export Header : Yes
    Form : JpDashboardExportForm

[Form: JpDashboardExportForm]
    Parts : JpDashboardExportPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Export:] is not a Tally definition type. Bulk output is a Report
    ; declared Plain XML, with XMLTag on the Part and XMLAttr on the Fields.
    ; "Export Title: Detail" (30 sites) was dropped - Report has Export Header,
    ; and detail-vs-header is not a Part-level concept.
[Part: JpDashboardExportPart]
    XMLTag : "Row"
    Lines : JpDashboardExportLine

[Line: JpDashboardExportLine]
    Field : JpDashboardExportF1
    Field : JpDashboardExportF2
    Field : JpDashboardExportF3
    Field : JpDashboardExportF4
    Field : JpDashboardExportF5
    Field : JpDashboardExportF6
    Field : JpDashboardExportF7
    Field : JpDashboardExportF8

    ; "Export: Value:" had no TDL equivalent. Each became a Field
    ; setting the same payload verbatim; the tag name is derived from it.

[Field: JpDashboardExportF1]
    Set As : $$JwlVchType
    XMLAttr : "JwlVchType"

[Field: JpDashboardExportF2]
    Set As : $$JwlSales
    XMLAttr : "JwlSales"

[Field: JpDashboardExportF3]
    Set As : $$JwlPurch
    XMLAttr : "JwlPurch"

[Field: JpDashboardExportF4]
    Set As : $$JwlCash
    XMLAttr : "JwlCash"

[Field: JpDashboardExportF5]
    Set As : $$JwlCard
    XMLAttr : "JwlCard"

[Field: JpDashboardExportF6]
    Set As : $$JwlUpi
    XMLAttr : "JwlUpi"

[Field: JpDashboardExportF7]
    Set As : $$JwlBank
    XMLAttr : "JwlBank"

[Field: JpDashboardExportF8]
    Set As : $$JwlBills
    XMLAttr : "JwlBills"

[Collection: Report: JpWeightDashboard]
    Source: JpWeightDashboardSQL
    Var: JpDashFrom, JpDashTo
    Title: <1000,###,#a##"  DASHBOARD 2 of 4  -  GOLD SOLD AND TOP PERFORMERS">
    Print: JpWeightDashboardPrint
    Export: JpWeightDashboardExport
    Key: JpWeightDashboardKey

[Variable: JpWeightDashboardSQL : String]
    Type: String
    Value: "SELECT $JwlCategory$$ AS JwlCat, $JwlSalesperson$$ AS JwlSp, SUM($JwlLnNet$$) AS JwlWtSold, SUM($JwlLnTotal$$) AS JwlRev, SUM($$QUANTITY$$) AS JwlPcs FROM $$LINEITEMS$$ WHERE $$VOUCHERTYPE$$ = 'Sales' AND $$DATE$$ BETWEEN $$JpDashFrom$$ AND $$JpDashTo$$ GROUP BY $JwlCategory$$,$JwlSalesperson$$ ORDER BY $$JwlRev$$ DESC"

[Variable: JpWeightDashboardKey : String]
    Type: String
    Value: "JwlCat"


; [Print: JpWeightDashboardPrint] -> [Form: JpWeightDashboardPrint] by fix-print-to-form.mjs.
; "Print" is a Report attribute, not a definition type; a print layout is a Form.
; dropped (no home in TallyPrime, per user decision): Width (column widths)

[Form: JpWeightDashboardPrint]
    Height : 18
    Parts : JpWeightDashboardPrintLines

[Part: JpWeightDashboardPrintLines]
