[Report: JpZplQueueExport]
    Title : <1000, "Zebra Label Queue">
    Repeat: Over: JpZplLabelQueue
    Plain XML : Yes
    Export Header : Yes
    Form : JpZplQueueExportForm

[Form: JpZplQueueExportForm]
    Parts : JpZplQueueExportPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Export:] is not a Tally definition type. Bulk output is a Report
    ; declared Plain XML, with XMLTag on the Part and XMLAttr on the Fields.
    ; "Export Title: Detail" (30 sites) was dropped - Report has Export Header,
    ; and detail-vs-header is not a Part-level concept.
[Part: JpZplQueueExportPart]
    XMLTag : "Row"
    Lines : JpZplQueueExportLine

[Line: JpZplQueueExportLine]
    Field : JpZplQueueExportF1
    Field : JpZplQueueExportF2
    Field : JpZplQueueExportF3
    Field : JpZplQueueExportF4
    Field : JpZplQueueExportF5
    Field : JpZplQueueExportF6
    Field : JpZplQueueExportF7
    Field : JpZplQueueExportF8
    Field : JpZplQueueExportF9
    Field : JpZplQueueExportF10
    Field : JpZplQueueExportF11
    Field : JpZplQueueExportF12
    Field : JpZplQueueExportF13
    Field : JpZplQueueExportF14
    Field : JpZplQueueExportF15
    Field : JpZplQueueExportF16
    Field : JpZplQueueExportF17
    Field : JpZplQueueExportF18
    Field : JpZplQueueExportF19
    Field : JpZplQueueExportF20
    Field : JpZplQueueExportF21
    Field : JpZplQueueExportF22
    Field : JpZplQueueExportF23
    Field : JpZplQueueExportF24
    Field : JpZplQueueExportF25
    Field : JpZplQueueExportF26
    Field : JpZplQueueExportF27
    Field : JpZplQueueExportF28
    Field : JpZplQueueExportF29
    Field : JpZplQueueExportF30
    Field : JpZplQueueExportF31
    Field : JpZplQueueExportF32
    Field : JpZplQueueExportF33

    ; "Export: Value:" had no TDL equivalent. Each became a Field
    ; setting the same payload verbatim; the tag name is derived from it.

[Field: JpZplQueueExportF1]
    Set As : $$ZplBarcode
    XMLAttr : "ZplBarcode"

[Field: JpZplQueueExportF2]
