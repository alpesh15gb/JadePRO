    Line Height: 1

    Field: <Field-Id: JwlTaxableVal, Label: "Taxable Jewellery Value">
        Width: 150
    Field: <Field-Id: JwlMakeVal, Label: "Making Charges Value">
        Width: 150
    Field: <Field-Id: JwlCgst, Label: "CGST">
        Width: 110
    Field: <Field-Id: JwlSgst, Label: "SGST">
        Width: 110
    Field: <Field-Id: JwlIgst, Label: "IGST">
        Width: 110
    Field: <Field-Id: JwlTaxTotal, Label: "Total GST">
        Width: 120
        Color: #6B4E1E
        Font: Bold
    Field: <Field-Id: JwlGrandTotal, Label: "GRAND TOTAL">
        Width: 140
        Color: #A06000
        Font: Bold
    Field: <Field-Id: JwlPayTotal, Label: "Total Received">
        Width: 130
    Field: <Field-Id: JwlPayBalance, Label: "Balance Due">
        Width: 120
[Collection: Source: JpYesNoPick]
