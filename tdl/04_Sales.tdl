[System: UDF]
JwlLnMetal : String : 20083
    ; Label: "Gross Weight"
[System: UDF]
JwlLnGross : Quantity : 20084
    ; Label: "Stone Weight"
[System: UDF]
JwlLnStone : Quantity : 20085
    ; Label: "Diamond Carat"
[System: UDF]
JwlLnCarat : Quantity : 20086
    ; Label: "Net Weight"
[System: UDF]
JwlLnNet : Quantity : 20087
    ; Label: "Metal Rate"
[System: UDF]
JwlLnRate : Number : 20088
    ; Label: "Metal Value"
[System: UDF]
JwlLnMetalVal : Number : 20089
    ; Label: "Wastage %"
[System: UDF]
JwlLnWastagePc : Number : 20090
    ; Label: "Wastage Value"
[System: UDF]
JwlLnWastageVal : Number : 20091
