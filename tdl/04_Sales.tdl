; =============================================================================
;  JadePro  ::  04_Sales.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : Premium Jewellery Sales Invoice.
;            Enriches Tally's STANDARD Sales voucher with the jewellery
;            header block, a full jewellery column set on every inventory
;            entry line, GST breakdown, split payments and old-gold
;            adjustment.
;
;  WHY THE STANDARD SALES VOUCHER
;  ------------------------------
;  The shop keeps Tally's normal Sales voucher, normal ledgers, normal stock
;  journals and normal GST posting. We only APPEND fields. Consequences:
;    * Inventory falls by weight automatically (Tally's own engine).
;    * GST returns, TDS returns, reconciliation and the P&L keep working.
;    * A shop that does not want JadePro still has a normal Sales voucher.
;  A TDL screen cannot programmatically add inventory-entry rows, so the item
;  grid must be Tally's own grid. That is the one place where we extend rather
;  than replace, and it is what makes unlimited multi-item invoices possible.
;
;  LOAD    : After 00_Core, 02_ItemMaster, 03_GoldRate. Before 14_PrintInvoice.
;  REQUIRES : 00_Core.tdl, 02_ItemMaster.tdl, 03_GoldRate.tdl
; =============================================================================

; =============================================================================
;  SECTION A - VOUCHER HEADER UDFs
; =============================================================================

    ; Label: "Invoice Number"
[System: UDF]
JwlInvNo : String : 20054
    ; Label: "Salesperson"
[System: UDF]
JwlSalesperson : String : 20055
    ; Label: "Payment Mode"
[System: UDF]
JwlPayMode : String : 20056
    ; Label: "Paid by Cash"
[System: UDF]
