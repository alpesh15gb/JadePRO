[Line: JpPurityStockPrintLine35]
    Field: JpPurityStockPrintLine35F1

[Field: JpPurityStockPrintLine35F1]
    Style : JpTotal
[Line: JpPurityStockPrintLine36]
    Field: JpPurityStockPrintLine36F1

[Field: JpPurityStockPrintLine36F1]
    Set As : Sum($$JwlNetWt)
[Line: JpPurityStockPrintLine37]
    Field: JpPurityStockPrintLine37F1

[Field: JpPurityStockPrintLine37F1]
    Style : JpTotal
[Line: JpPurityStockPrintLine38]
    Field: JpPurityStockPrintLine38F1

[Field: JpPurityStockPrintLine38F1]
    Set As : JpFineTotal()
[Line: JpPurityStockPrintLine39]
    Field: JpPurityStockPrintLine39F1

[Field: JpPurityStockPrintLine39F1]
    Style : JpTotal
[Line: JpPurityStockPrintLine40]
    Field: JpPurityStockPrintLine40F1

[Field: JpPurityStockPrintLine40F1]
    Set As : Sum($$JwlStockVal)
[Line: JpPurityStockPrintLine41]
    Field: JpPurityStockPrintLine41F1

[Field: JpPurityStockPrintLine41F1]
    Style : JpTotal
[Function: JpPurPrint]
    Param: vPurity : String : Optional
    Returns: String : Any
    JpPurPrint = String(JpPurityPercent(Param(0)), "0.00")

[Function: JpFineTotal]
    Returns: Quantity : Any
    JpFineTotal = Sum($$JwlNetWt) * JpFineness($$JwlPur)

[Export: JpPurityStockExport]
    Title: <1000, "Purity-wise Stock">
    Repeat: Over: JpPurityStockReport
    Export Title: Detail
    Export: Value: $$JwlPur
    Export: Value: $$JwlQty
    Export: Value: $JwlGrossWt
    Export: Value: $$JwlNetWt
    Export: Value: $$JwlStockVal


