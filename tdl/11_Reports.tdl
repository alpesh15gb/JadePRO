; =============================================================================
;  REPORT 7 - METAL-WISE STOCK
;  Valued live: every gram of a metal at today's rate for its purity.
; =============================================================================
[Collection: Report: JpMetalStockReport]
    Source: JpMetalStockSQL
    Title: <1000,###,#a##"  METAL-WISE STOCK VALUATION">
    Print: JpMetalStockPrint
    Export: JpMetalStockExport
    Key: JpMetalStockKey

[Variable: JpMetalStockSQL : String]
    Type: String
    Value: "SELECT $JwlMetalType$$ AS JwlMetal, $JwlPurity$$ AS JwlPur, SUM($$QUANTITY$$) AS JwlQty, SUM($JwlNetMetalWt$$ * $$QUANTITY$$) AS JwlNetWt, SUM($JwlMetalValue$$ * $$QUANTITY$$) AS JwlMetalVal, SUM($JwlStoneValue$$ * $$QUANTITY$$) AS JwlStoneVal, SUM($JwlDiamondValue$$ * $$QUANTITY$$) AS JwlDiaVal FROM $$ITEMSSTOCK$$ WHERE $JwlIsJewellery$$ = 1 GROUP BY $JwlMetalType$$,$JwlPurity$$ ORDER BY $JwlMetalType$$,$JwlPurity$$"

[Variable: JpMetalStockKey : String]
    Type: String
    Value: "JwlMetal"


