[Variable: JpItemProfitSQL : String]
    Type: String
    Value: "SELECT $$ITEMNAME$$ AS JwlItem, $JwlCategory$$ AS JwlCat, SUM($$QUANTITY$$) AS JwlQty, SUM($JwlLnNet$$) AS JwlWt, SUM($JwlLnTotal$$) AS JwlRevenue, SUM($JwlLnCost$$) AS JwlCost FROM $$LINEITEMS$$ WHERE $$VOUCHERTYPE$$ = 'Sales' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$ GROUP BY $$ITEMNAME$$,$JwlCategory$$ ORDER BY $$JwlRevenue$$ DESC"

