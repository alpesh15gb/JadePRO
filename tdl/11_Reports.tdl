; =============================================================================
;  JadePro  ::  11_Reports.tdl
; -----------------------------------------------------------------------------
;  PURPOSE : All drill-down management reports.
;
;  PERFORMANCE MODEL
;    Every report here is a SQL-backed Collection report. Tally executes the
;    query in its own engine, so a stock report over 50,000 items is one
;    indexed query rather than 50,000 TDL function calls. That is the single
;    most important scalability decision in this module.
;
;  COMMON FEATURES ON EVERY REPORT
;    From / To date filter, category or party filter, Key (Alt+K search),
;    F5 print / preview, Alt+E export to Excel, F8 drill-down into the
;    original voucher, and a security gate that hides cost and profit columns
;    from users without JADE_VIEW_PROFIT.
;
;  LOAD    : After 00_Core, 04_Sales, 05_Purchase, 13_Security.
;  REQUIRES : 00_Core.tdl, 04_Sales.tdl, 05_Purchase.tdl, 13_Security.tdl
; =============================================================================

; =============================================================================
;  CUSTOMER CRM BLOCK ON THE LEDGER MASTER
;  Lives here because the CRM reports below read these fields. Only the block
;  is added - the ledger's own name, group, balances and PAN are untouched.
; =============================================================================
    ; Label: "Birthday"
[System: UDF]
JwlCustDOB : Date : 20209
    ; Label: "Anniversary"
[System: UDF]
JwlCustAnniversary : Date : 20210
    ; Label: "Email"
[System: UDF]
JwlCustEmail : String : 20211
    ; Label: "Alternate Mobile"
[System: UDF]
JwlCustMobile2 : String : 20212
    ; Label: "Customer Segment"
[System: UDF]
JwlCustSeg : String : 20213
    ; Label: "Loyalty Points"
[System: UDF]
JwlLoyaltyPts : Number : 20214
    ; Label: "Party State"
[System: UDF]
JwlPartyState : String : 20215
    ; Label: "Lifetime Purchases"
[System: UDF]
JwlTotalPurchases : Number : 20216
; The CRM block is ATTACHED inside the single "Alter: Ledger" section that
; 07_Karigar.tdl owns - TDL permits only one section with a given name.
[Part: JpCrmPart]
    Line: Spacing, JpCrmPartLine1, JpCrmPartLine2, JpCrmPartLine3, JpCrmPartLine4, JpCrmPartLine5, JpCrmPartLine6, JpCrmPartLine7, JpCrmPartLine8, JpCrmPartLine9

[Line: JpCrmPartLine1]
    Height : 1
    Field: JpCrmPartLine1F1

[Field: JpCrmPartLine1F1]
    Set As : " CUSTOMER CRM  (fill Party State to show this block)"
    Style : JpSectionBox
[Line: JpCrmPartLine2]
    Field: JpCrmPartLine2F1

[Field: JpCrmPartLine2F1]
    Storage : JwlCustDOB
    Label : "Birthday"
    Width : 160
[Line: JpCrmPartLine3]
    Field: JpCrmPartLine3F1

[Field: JpCrmPartLine3F1]
    Storage : JwlCustAnniversary
    Label : "Anniversary"
    Width : 160
[Line: JpCrmPartLine4]
    Field: JpCrmPartLine4F1

[Field: JpCrmPartLine4F1]
    Storage : JwlCustEmail
    Label : "Email"
    Width : 200
[Line: JpCrmPartLine5]
    Field: JpCrmPartLine5F1

[Field: JpCrmPartLine5F1]
    Storage : JwlCustMobile2
    Label : "Alternate Mobile"
    Width : 160
[Line: JpCrmPartLine6]
    Field: JpCrmPartLine6F1

[Field: JpCrmPartLine6F1]
    Storage : JwlCustSeg
    Label : "Customer Segment"
    Width : 160
[Line: JpCrmPartLine7]
    Field: JpCrmPartLine7F1

[Field: JpCrmPartLine7F1]
    Storage : JwlLoyaltyPts
    Label : "Loyalty Points"
    Width : 140
[Line: JpCrmPartLine8]
    Field: JpCrmPartLine8F1

[Field: JpCrmPartLine8F1]
    Storage : JwlPartyState
    Label : "Party State"
    Width : 160
[Line: JpCrmPartLine9]
    Field: JpCrmPartLine9F1

[Field: JpCrmPartLine9F1]
    Storage : JwlTotalPurchases
    Label : "Lifetime Purchases"
    Width : 160
[Function: JpDrillRef]
    Returns: String : Any
    JpDrillRef = $$VOUCHERTYPE + "-" + $$VOUCHERID

; Access gate for the profitability reports.
[Function: JpProfitReportOk]
    Returns: Integer : Any
    If (JpHasRight(JpRtProfit()) = 1) Then
    {
        JpProfitReportOk = 1
        Exit
    }
    JpProfitReportOk = 0

; Shared report header fragment used by every print format.
[Part: JpReportHeader]
    Line: Spacing, JpReportHeaderLine1, JpReportHeaderLine2, JpReportHeaderLine3, JpReportHeaderLine4, JpReportHeaderLine5

[Line: JpReportHeaderLine1]
    Part Name: Width
[Line: JpReportHeaderLine2]
    Field: JpReportHeaderLine2F1

[Field: JpReportHeaderLine2F1]
    Set As : Upr(##JwlShopName)
    Style : JpFontBold
[Line: JpReportHeaderLine3]
    Field: JpReportHeaderLine3F1

[Field: JpReportHeaderLine3F1]
    Set As : "From " + JpFmtDate($$JpFromDate) + "     To " + JpFmtDate($$JpToDate)
[Line: JpReportHeaderLine4]
    Field: JpReportHeaderLine4F1

[Field: JpReportHeaderLine4F1]
    Set As : "Printed: " + JpFmtDate(JpCacheDate) + "     User: " + JpBlankIfNull(JpUserName) + " (" + JpBlankIfNull(JpUserRole) + ")"
    Style : JpFontBold
[Line: JpReportHeaderLine5]
    Field: JpReportHeaderLine5F1

[Field: JpReportHeaderLine5F1]
    Set As : " "
[Collection: Report: JpDailySales]
    Source: JpDailySalesSQL
    Var: JpFromDate, JpToDate, JpDailySalesperson
    Title: <1000,###,#a##"  DAILY JEWELLERY SALES">
    Print: JpDailySalesPrint
    Export: JpDailySalesExport
    Key: JpVoucherKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>, <JpDailySalesperson, <String, "Salesperson">>

[Variable: JpDailySalesSQL : String]
    Type: String
    Value: "SELECT $$VOUCHERTYPE$$,$$VOUCHERID$$,$$DATE$$,$JwlInvNo$$,$JwlSalesperson$$,$$PARTYNAME$$,$$GSTVALUE$$,$JwlGrandTotal$$,$JwlTaxableVal$$,$JwlPayCash$$,$JwlPayCard$$,$JwlPayUpi$$,$JwlPayBank$$,$JwlPayAdvance$$,$JwlPayOldGold$$ FROM $$VOUCHERS$$ WHERE $$VOUCHERTYPE$$ = 'Sales' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$"

[Variable: JpVoucherKey : String]
    Type: String
    Value: "VOUCHERID"


