[Line: JpCategoryStockPrintLine30]
    Field: JpCategoryStockPrintLine30F1

[Field: JpCategoryStockPrintLine30F1]
    Set As : 100
[Line: JpCategoryStockPrintLine31]
    Field: JpCategoryStockPrintLine31F1

[Field: JpCategoryStockPrintLine31F1]
    Style : JpTotal
[Function: JpPcOfVal]
    Returns: Number : Any
    Var: JpFromDate, JpToDate, t : Number
    t = Sum($$JwlStockVal)
    If (t <= 0) Then
    {
        JpPcOfVal = 0
        Exit
    }
    JpPcOfVal = JpRound($$JwlStockVal * 100 / t)

