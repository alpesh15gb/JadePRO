; =============================================================================
;  REPORT 19 - BIRTHDAY AND ANNIVERSARY CUSTOMERS
;  CRM fields live on the Ledger master; a SQL month/day comparison means the
;  report stays instant even with tens of thousands of customers.
; =============================================================================
[Collection: Report: JpBirthdayReport]
    Source: JpBirthdaySQL
    Var: JpFromDate, JpToDate, JpCrmEvent
    Title: <1000,###,#a##"  BIRTHDAY AND ANNIVERSARY CUSTOMERS">
    Print: JpBirthdayPrint
    Export: JpBirthdayExport
    Key: JpBirthdayKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>, <JpCrmEvent, <String, "Event: All / Birthday / Anniversary">>

[Variable: JpBirthdaySQL : String]
    Type: String
    Value: "SELECT $$NAME$$ AS JwlCust, $JwlCustDOB$$ AS JwlDob, $JwlCustAnniversary$$ AS JwlAnniv, $JwlLoyaltyPts$$ AS JwlPts, $JwlTotalPurchases$$ AS JwlSpend FROM $$CREATENMASTER$$ WHERE $JwlTotalPurchases$$ > 0"

[Variable: JpBirthdayKey : String]
    Type: String
    Value: "JwlCust"

[Function: JpEventText]
    Returns: String : Any
    Var: s : String
    s = ""
    If ($$JwlDob is not null) Then
    {
        s = "Birthday: " + JpFmtDate($$JwlDob)
    }
    If ($$JwlAnniv is not null) Then
    {
        If (s <> "") Then
        {
            s = s + "   |   "
        }
        s = s + "Anniversary: " + JpFmtDate($$JwlAnniv)
    }
    JpEventText = s


