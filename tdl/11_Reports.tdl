    Filters: <JpFromDate, <Date, "As From Date">>, <JpToDate, <Date, "As To Date">>

[Variable: JpPurityStockSQL : String]
    Type: String
    Value: "SELECT $JwlPurity$$ AS JwlPur, SUM($$QUANTITY$$) AS JwlQty, SUM($JwlNetMetalWt$$ * $$QUANTITY$$) AS JwlNetWt, SUM($JwlGrossWt$$ * $$QUANTITY$$) AS JwlGrossWt, SUM($JwlFinalValue$$ * $$QUANTITY$$) AS JwlStockVal FROM $$ITEMSSTOCK$$ WHERE $JwlIsJewellery$$ = 1 GROUP BY $JwlPurity$$ ORDER BY $JwlPurity$$"

[Variable: JpPurityStockKey : String]
