[Line: JpItemProfitPrintLine45]
    Field: JpItemProfitPrintLine45F1

[Field: JpItemProfitPrintLine45F1]
    Style : JpTotal
[Function: JpItemProfit]
    Returns: Number : Any
    If (JpProfitReportOk() <> 1) Then
    {
        JpItemProfit = 0
        Exit
    }
    JpItemProfit = JpRound(JpNz($$JwlRevenue) - JpNz($$JwlCost))

[Function: JpItemMargin]
    Returns: Number : Any
    Var: r : Number, p : Number
    r = JpNz($$JwlRevenue)
    If (r <= 0) Then
    {
        JpItemMargin = 0
        Exit
    }
    p = JpItemProfit()
    JpItemMargin = JpRound(p * 100 / r)

[Export: JpItemProfitExport]
    Title: <1000, "Item Profitability">
    Repeat: Over: JpItemProfitReport
    Export Title: Detail
    Export: Value: $$JwlItem
    Export: Value: $$JwlCat
    Export: Value: $$JwlQty
    Export: Value: $$JwlWt
    Export: Value: $$JwlRevenue
    Export: Value: $$JwlCost


