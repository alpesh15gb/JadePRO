; =============================================================================
;  REPORT 18 - TOP AND REPEAT CUSTOMERS
; =============================================================================
[Collection: Report: JpTopCustomerReport]
    Source: JpTopCustomerSQL
    Var: JpFromDate, JpToDate
    Title: <1000,###,#a##"  TOP AND REPEAT CUSTOMERS">
    Print: JpTopCustomerPrint
    Export: JpTopCustomerExport
    Key: JpTopCustomerKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>

[Variable: JpTopCustomerSQL : String]
    Type: String
    Value: "SELECT $$PARTYNAME$$ AS JwlCust, COUNT($$VOUCHERID$$) AS JwlVisits, SUM($JwlGrandTotal$$) AS JwlSpend, SUM($JwlLnNet$$) AS JwlWt, MAX($$DATE$$) AS JwlLastBuy FROM $$LINEITEMS$$ WHERE $$VOUCHERTYPE$$ = 'Sales' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$ GROUP BY $$PARTYNAME$$ ORDER BY $$JwlSpend$$ DESC"

[Variable: JpTopCustomerKey : String]
    Type: String
    Value: "JwlCust"

[Function: JpCustomerClass]
    Param: vVisits : Number : Optional
    Returns: String : Any
    Var: v : Number
    v = JpNz(Param(0))
    If (v >= 5) Then
    {
        JpCustomerClass = "LOYAL (5+)"
        Exit
    }
    If (v >= 2) Then
    {
        JpCustomerClass = "REPEAT"
        Exit
    }
    JpCustomerClass = "FIRST TIME"


