[Report: JpOrderRegisterExport]
    Title : <1000, "Custom Order Register">
    Repeat: Over: JpOrderRegister
    Plain XML : Yes
    Export Header : Yes
    Form : JpOrderRegisterExportForm

[Form: JpOrderRegisterExportForm]
    Parts : JpOrderRegisterExportPart

; ---------- fixed-screen-export-types.mjs ----------
    ; [Export:] is not a Tally definition type. Bulk output is a Report
    ; declared Plain XML, with XMLTag on the Part and XMLAttr on the Fields.
    ; "Export Title: Detail" (30 sites) was dropped - Report has Export Header,
    ; and detail-vs-header is not a Part-level concept.
[Part: JpOrderRegisterExportPart]
    XMLTag : "Row"
    Lines : JpOrderRegisterExportLine

[Line: JpOrderRegisterExportLine]
    Field : JpOrderRegisterExportF1
    Field : JpOrderRegisterExportF2
    Field : JpOrderRegisterExportF3
    Field : JpOrderRegisterExportF4
    Field : JpOrderRegisterExportF5
    Field : JpOrderRegisterExportF6
    Field : JpOrderRegisterExportF7
    Field : JpOrderRegisterExportF8
    Field : JpOrderRegisterExportF9

    ; "Export: Value:" had no TDL equivalent. Each became a Field
    ; setting the same payload verbatim; the tag name is derived from it.

[Field: JpOrderRegisterExportF1]
    Set As : $JwlOrdNo
    XMLAttr : "JwlOrdNo"

[Field: JpOrderRegisterExportF2]
    Set As : $JwlOrdCust
    XMLAttr : "JwlOrdCust"

[Field: JpOrderRegisterExportF3]
    Set As : $JwlOrdType
    XMLAttr : "JwlOrdType"

[Field: JpOrderRegisterExportF4]
    Set As : $JwlOrdExpWt
    XMLAttr : "JwlOrdExpWt"

[Field: JpOrderRegisterExportF5]
    Set As : $JwlOrdExpPrice
    XMLAttr : "JwlOrdExpPrice"

[Field: JpOrderRegisterExportF6]
    Set As : $JwlOrdAdvance
    XMLAttr : "JwlOrdAdvance"

[Field: JpOrderRegisterExportF7]
    Set As : $JwlOrdAdvBalance
    XMLAttr : "JwlOrdAdvBalance"

[Field: JpOrderRegisterExportF8]
    Set As : $JwlOrdDelivDate
    XMLAttr : "JwlOrdDelivDate"

[Field: JpOrderRegisterExportF9]
    Set As : $JwlOrdStatus
    XMLAttr : "JwlOrdStatus"
