        Width: 250
        Style: UseFormCtrl

[Field: JpOrdMsg]
    Label : " "
        Width: 250
        Style: JpWarn

[Collection: Source: JpOrdStatusPick]
    Data: JpOrdStatusPickRow

[Collection: Data: JpOrdStatusPickRow]
    Fetch: JpOrdStatusPickFetch
    Set: JpOrdStatusPickSet
    Repeat: Over: JpOrdStatusPickRow

[Collection: Data: JpOrdStatusPickFetch]
    Include: JpOrdStatusPickRow

[Collection: Data: JpOrdStatusPickSet]
    Not On: ##<Not>
    Set: $$Name: Value: JpOrdStatusListAll()

; =============================================================================
;  SECTION D - ACTIONS
; =============================================================================

[Function: JpOrdCalc]
    Returns: Integer : Any
    $$JpOrdExpPrice = JpOrdEstimate($$JpOrdExpWt, $$JpOrdPurity, $$JpOrdExpPrice)
    $$JpOrdAdvBal = JpOrdAdvBalance($$JpOrdAdvance, $$JpOrdAdvUsed)
    JpOrdMsg = JpOrdValidationText()
    JpOrdCalc = 1

[Function: JpOrdNextStatusAction]
    Returns: Integer : Any
    Var: nxt : String
    nxt = JpOrdNextStatus($$JpOrdStatusTx)
    If (JpOrdCanAdvance($$JpOrdStatusTx, nxt) = 0) Then
    {
        JpOrdMsg = "Cannot move from '" + JpBlankIfNull($$JpOrdStatusTx) + "' to '" + nxt + "'."
        JpOrdNextStatusAction = 0
        Exit
    }
    $$JpOrdStatusTx = nxt
    JpOrdCalc
    JpOrdNextStatusAction = 1

[Function: JpOrdSave]
    Returns: Integer : Any
    JpOrdCalc
    If (JpOrdValidationText() <> "") Then
    {
        JpOrdSave = 0
        Exit
    }
    Create: Journal
    Modify Group: JpOrdSaveGroup
        Add: Field-id: JwlVchKind
            Set: Value: "Order"
        Add: Field-id: JwlOrdNo
            Set: Value: $$JpOrdNo
        Add: Field-id: JwlOrdCust
            Set: Value: $$JpOrdCust
        Add: Field-id: JwlOrdType
            Set: Value: $$JpOrdType
        Add: Field-id: JwlOrdDesignRef
            Set: Value: JpBlankIfNull($$JpOrdDesign)
        Add: Field-id: JwlOrdExpWt
            Set: Value: $$JpOrdExpWt
        Add: Field-id: JwlOrdPurity
            Set: Value: $$JpOrdPurity
        Add: Field-id: JwlOrdExpPrice
            Set: Value: $$JpOrdExpPrice
        Add: Field-id: JwlOrdAdvance
            Set: Value: $$JpOrdAdvance
        Add: Field-id: JwlOrdAdvBalance
            Set: Value: $$JpOrdAdvBal
        Add: Field-id: JwlOrdDelivDate
            Set: Value: $$JpOrdDelivDt
        Add: Field-id: JwlOrdKarigar
            Set: Value: JpBlankIfNull($$JpOrdKarigarNm)
        Add: Field-id: JwlOrdStatus
            Set: Value: $$JpOrdStatusTx
        Add: Field-id: JwlOrdInvRef
            Set: Value: JpBlankIfNull($$JpOrdInvRefTx)
        Add: Field-id: JwlOrdNote
            Set: Value: JpBlankIfNull($$JpOrdNoteTx)
    Accept: JpOrdSaved
    JpOrdSave = 1

[Function: JpOrdSaved]
    Returns: Integer : Any
    JpOrdMsg = "Order " + ##JwlOrdNo + " saved. Status: " + ##JwlOrdStatus + ".  Advance balance " + JpFmtAmt(##JwlOrdAdvBalance) + "."
    JpOrdSaved = 1

[Function: JpOrdRegister]
    Returns: Integer : Any
    If (JpHasRight(JpRtReports()) = 0) Then
    {
        JpOrdMsg = JpDeniedMsg
        JpOrdRegister = 0
        Exit
    }
    Alter: JpOrderRegister
    JpOrdRegister = 1

; =============================================================================
;  SECTION E - CUSTOM ORDER REGISTER
; =============================================================================
[Collection: Report: JpOrderRegister]
    Source: JpOrderRegisterSQL
    Var: JpFromDate, JpToDate, JpOrdStatusFilter
    Title: <1000,###,#a##"  CUSTOM ORDER REGISTER">
    Print: JpOrderRegisterPrint
    Export: JpOrderRegisterExport
    Key: JpOrderRegisterKey
    Filters: <JpFromDate, <Date, "From Date">>, <JpToDate, <Date, "To Date">>, <JpOrdStatusFilter, <String, "Status">>

[Variable: JpOrderRegisterSQL : String]
    Type: String
    Value: "SELECT * FROM $$JOURNAL$$ WHERE $JwlVchKind$$ = 'Order' AND $$DATE$$ BETWEEN $$JpFromDate$$ AND $$JpToDate$$"

[Variable: JpOrderRegisterKey : String]
    Type: String
    Value: "JwlOrdNo"


; [Print: JpOrderRegisterPrint] -> [Form: JpOrderRegisterPrint] by fix-print-to-form.mjs.
; "Print" is a Report attribute, not a definition type; a print layout is a Form.
; dropped (no home in TallyPrime, per user decision): Width (column widths)

