    ; this was a menu-level shortcut, not a layout attribute.

    ; Line: Spacing dropped - a spacer Line this file never
    ; defines; the items below are on their own Lines now.
    ; Lines: 1 dropped - column counts, not Line names;
    ; its packing cannot be recovered (see the script header).
    ; Line Height dropped by fix-screen-export-types.mjs - Part: Height
    ; means the height of the whole Part, not of each Line.

    ; Line: Spacing dropped - a spacer Line this file never
    ; defines; the items below are on their own Lines now.
    ; Lines: 1 dropped - column counts, not Line names;
    ; its packing cannot be recovered (see the script header).
    ; Lines: 1, 1, 1, 1, 1, 1 dropped - column counts, not Line names;
    ; its packing cannot be recovered (see the script header).

    ; Line: Spacing dropped - a spacer Line this file never
    ; defines; the items below are on their own Lines now.
    ; Lines: 1 dropped - column counts, not Line names;
    ; its packing cannot be recovered (see the script header).
    ; Lines: 1, 1, 1, 1, 1, 1 dropped - column counts, not Line names;
    ; its packing cannot be recovered (see the script header).

    ; Line: Spacing dropped - a spacer Line this file never
    ; defines; the items below are on their own Lines now.
    ; Lines: 1 dropped - column counts, not Line names;
    ; its packing cannot be recovered (see the script header).
    ; Lines: 1, 1, 1, 1 dropped - column counts, not Line names;
    ; its packing cannot be recovered (see the script header).

    ; Line: Spacing dropped - a spacer Line this file never
    ; defines; the items below are on their own Lines now.
    ; Lines: 1 dropped - column counts, not Line names;
    ; its packing cannot be recovered (see the script header).
    Button: <Estimate Price (F7), Key: F7, Action: JpOrdCalc>
    Button: <Advance Status (F8), Key: F8, Action: JpOrdNextStatusAction>
    Button: <Save Order (F2), Key: F2, Action: JpOrdSave>
    Button: <Custom Order Register (F4), Key: F4, Action: JpOrdRegister>
