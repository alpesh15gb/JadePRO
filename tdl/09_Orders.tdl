[Line: JpOrderRegisterPrintLine42]
    Field: JpOrderRegisterPrintLine42F1

[Field: JpOrderRegisterPrintLine42F1]
    Set As : $JwlOrdAdvBalance
[Line: JpOrderRegisterPrintLine43]
    Field: JpOrderRegisterPrintLine43F1

[Field: JpOrderRegisterPrintLine43F1]
    Style : JpMoneyBold
[Line: JpOrderRegisterPrintLine44]
    Field: JpOrderRegisterPrintLine44F1

[Field: JpOrderRegisterPrintLine44F1]
    Set As : $JwlOrdDelivDate
[Line: JpOrderRegisterPrintLine45]
    Field: JpOrderRegisterPrintLine45F1

[Field: JpOrderRegisterPrintLine45F1]
    Style : JpGrid
[Line: JpOrderRegisterPrintLine46]
    Field: JpOrderRegisterPrintLine46F1

[Field: JpOrderRegisterPrintLine46F1]
    Set As : $JwlOrdStatus
[Line: JpOrderRegisterPrintLine47]
    Field: JpOrderRegisterPrintLine47F1

[Field: JpOrderRegisterPrintLine47F1]
    Style : JpGrid
[Line: JpOrderRegisterPrintLine48]
    Field: JpOrderRegisterPrintLine48F1

[Field: JpOrderRegisterPrintLine48F1]
    Set As : "TOTAL"
[Line: JpOrderRegisterPrintLine49]
    Field: JpOrderRegisterPrintLine49F1

[Field: JpOrderRegisterPrintLine49F1]
    Style : JpTotal
[Line: JpOrderRegisterPrintLine50]
    Field: JpOrderRegisterPrintLine50F1

[Field: JpOrderRegisterPrintLine50F1]
    Set As : Sum($JwlOrdExpPrice)
[Line: JpOrderRegisterPrintLine51]
    Field: JpOrderRegisterPrintLine51F1

[Field: JpOrderRegisterPrintLine51F1]
    Style : JpTotal
[Line: JpOrderRegisterPrintLine52]
    Field: JpOrderRegisterPrintLine52F1

[Field: JpOrderRegisterPrintLine52F1]
    Set As : Sum($JwlOrdAdvance)
[Line: JpOrderRegisterPrintLine53]
    Field: JpOrderRegisterPrintLine53F1

[Field: JpOrderRegisterPrintLine53F1]
    Style : JpTotal
[Line: JpOrderRegisterPrintLine54]
    Field: JpOrderRegisterPrintLine54F1

[Field: JpOrderRegisterPrintLine54F1]
    Set As : Sum($JwlOrdAdvBalance)
[Line: JpOrderRegisterPrintLine55]
    Field: JpOrderRegisterPrintLine55F1

[Field: JpOrderRegisterPrintLine55F1]
    Style : JpTotal
[Export: JpOrderRegisterExport]
    Title: <1000, "Custom Order Register">
    Repeat: Over: JpOrderRegister
    Export Title: Detail
    Export: Value: $JwlOrdNo
    Export: Value: $JwlOrdCust
    Export: Value: $JwlOrdType
    Export: Value: $JwlOrdExpWt
    Export: Value: $JwlOrdExpPrice
    Export: Value: $JwlOrdAdvance
    Export: Value: $JwlOrdAdvBalance
    Export: Value: $JwlOrdDelivDate
    Export: Value: $JwlOrdStatus
